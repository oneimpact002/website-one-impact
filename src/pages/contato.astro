---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import FormContato from '../components/FormContato.astro'

// Página própria do formulário de contato. O link curto
// link.oneimpact.com.br/contato-agencia-one-impact aponta pra cá, então todo
// botão de contato do site chega aqui sem precisar de publicação nova.
//
// Não leva a WhatsappBar: ela é um botão de contato, e um botão de contato
// dentro da própria página de contato só anda em círculo.
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contato | One Impact</title>
    <meta
      name="description"
      content="Fale com a One Impact. Conte sobre o seu projeto em algumas perguntas rápidas e a gente volta com um caminho."
    />
    <link rel="canonical" href="https://agenciaoneimpact.com.br/contato" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Contato | One Impact" />
    <meta
      property="og:description"
      content="Fale com a One Impact. Conte sobre o seu projeto em algumas perguntas rápidas e a gente volta com um caminho."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenciaoneimpact.com.br/contato" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #0D0A1A;
        font-family: 'Sora', sans-serif;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 20px;
        text-align: center;
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 45% at 50% 30%, rgba(115, 69, 253, 0.2), transparent 70%);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        max-width: 640px;
        margin: 0 auto;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        color: #FFFFFF;
      }

      @media (min-width: 900px) {
        h1 {
          font-size: 40px;
          letter-spacing: -1px;
        }
      }

      .hero-desc {
        max-width: 520px;
        font-size: 13px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.78);
      }

      .form-section {
        position: relative;
        z-index: 1;
        padding: 8px 20px 88px;
      }

    </style>
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="hero-inner">
        <span class="badge">Contato</span>
        <h1>Vamos conversar sobre o seu projeto</h1>
        <p class="hero-desc">
          Conte o que você precisa e a gente volta com um caminho. Sem compromisso e sem enrolação.
        </p>
      </div>
    </section>

    <section class="form-section">
      <FormContato />
    </section>

    <Footer />
  </body>
</html>
