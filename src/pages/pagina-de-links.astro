---
import Layout from '../layouts/Layout.astro';

const links = [
  {
    tag: "Gratuito",
    title: "Descubra onde seu negócio está perdendo clientes",
    desc: "Faça o diagnóstico gratuito e receba um plano de ação personalizado.",
    href: "https://agenciaoneimpact.com.br/diagnostico-primeira-parte/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>`,
  },
  {
    tag: "Contato",
    title: "Fale com um especialista agora",
    desc: "Tire suas dúvidas sobre presença digital e automação.",
    href: "https://wa.me/554188733518",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 2.124.555 4.115 1.528 5.845L.073 24l6.254-1.633A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm5.568 16.83c-.243.687-1.42 1.315-1.97 1.4-.503.076-1.137.108-1.835-.115-.423-.134-.966-.313-1.66-.614-2.914-1.26-4.823-4.19-4.97-4.385-.147-.196-1.197-1.59-1.197-3.034 0-1.443.754-2.152 1.022-2.447.267-.294.584-.367.778-.367.195 0 .39.002.56.01.18.01.422-.068.66.504.243.584.824 2.013.897 2.16.073.146.122.317-.025.513-.146.196-.22.318-.44.49-.22.17-.463.38-.66.512-.22.146-.448.303-.194.595.255.293.956 1.183 2.053 1.916 1.41.93 2.6 1.218 2.97 1.356.367.138.583.115.8-.07.22-.184.94-.99 1.19-1.33.25-.34.5-.283.84-.17.34.116 2.16 1.02 2.53 1.207.37.187.616.28.706.436.09.156.09.9-.153 1.588z"/></svg>`,
  },
  {
    tag: "Site",
    title: "Veja os resultados que já entregamos",
    desc: "Cases, portfólio e tudo que fazemos por nossos clientes.",
    href: "https://oneimpact.com.br/",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  },
  {
    tag: "Conteúdo",
    title: "Aprenda a atrair mais clientes pelo digital",
    desc: "Vídeos semanais sobre presença digital e captação de clientes.",
    href: "https://www.youtube.com/@agenciaoneimpact",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>`,
  },
];
---

<Layout
  title="One Impact | Links"
  description="Todos os links da One Impact em um so lugar."
  bodyClass="diagnostico-page"
>
  <div class="page-wrapper">

    <div class="glow glow-left"></div>
    <div class="glow glow-right"></div>

    <div class="container">

      <div class="profile">
        <div class="profile-top">
          <div class="avatar"><img src="/logo-oneimpact.webp" alt="One Impact" /></div>
          <div class="profile-info">
            <span class="profile-badge">✦ Agência Digital</span>
            <h1 class="profile-name">One Impact</h1>
            <p class="profile-handle">@agenciaoneimpact</p>
          </div>
        </div>

        <div class="profile-bottom">
          <p class="profile-bio">Especialistas em sites e landing pages corporativas e automações inteligentes para negócios que querem crescer de verdade.</p>

          <div class="profile-stat">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            Clientes atendidos no Brasil e no mundo
          </div>

          <div class="profile-socials">
            <a href="https://instagram.com/oneimpact" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.youtube.com/@agenciaoneimpact" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
            </a>
            <a href="https://wa.me/554188733518" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 2.124.555 4.115 1.528 5.845L.073 24l6.254-1.633A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm5.568 16.83c-.243.687-1.42 1.315-1.97 1.4-.503.076-1.137.108-1.835-.115-.423-.134-.966-.313-1.66-.614-2.914-1.26-4.823-4.19-4.97-4.385-.147-.196-1.197-1.59-1.197-3.034 0-1.443.754-2.152 1.022-2.447.267-.294.584-.367.778-.367.195 0 .39.002.56.01.18.01.422-.068.66.504.243.584.824 2.013.897 2.16.073.146.122.317-.025.513-.146.196-.22.318-.44.49-.22.17-.463.38-.66.512-.22.146-.448.303-.194.595.255.293.956 1.183 2.053 1.916 1.41.93 2.6 1.218 2.97 1.356.367.138.583.115.8-.07.22-.184.94-.99 1.19-1.33.25-.34.5-.283.84-.17.34.116 2.16 1.02 2.53 1.207.37.187.616.28.706.436.09.156.09.9-.153 1.588z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="links-list">
        {links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="btn">
            <span class="btn-icon" set:html={link.icon} />
            <span class="btn-content">
              <span class="btn-tag">{link.tag}</span>
              <span class="btn-title">{link.title}</span>
              <span class="btn-desc">{link.desc}</span>
            </span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        ))}
      </div>

    </div>
  </div>

  <style is:global>
    @font-face {
      font-family: 'Zalando';
      src: url('/fonts/ZalandoSansExpanded-VariableFont_wght.ttf') format('truetype');
      font-weight: 100 900;
      font-display: swap;
    }

    .page-wrapper {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      background-image:
        radial-gradient(rgba(247,250,255,0.12) 1.2px, transparent 1.2px),
        linear-gradient(180deg, #0a0a0f 0%, #12111a 100%);
      background-size: 24px 24px, 100% 100%;
      padding: 48px 20px;
    }

    .glow {
      position: absolute;
      width: 22rem;
      height: 22rem;
      border-radius: 9999px;
      pointer-events: none;
    }
    .glow-left  { top: 15%; left: -6rem; background: #5907DB; filter: blur(120px); opacity: 0.22; }
    .glow-right { bottom: 15%; right: -6rem; background: #677BFF; filter: blur(120px); opacity: 0.18; }

    .container {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
    }

    .profile {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 40px;
    }

    .profile-top {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .avatar {
      width: 80px;
      height: 80px;
      border-radius: 9999px;
      overflow: hidden;
      flex-shrink: 0;
      box-shadow: 0 0 32px rgba(133, 57, 255, 0.4);
      border: 2px solid rgba(133, 57, 255, 0.35);
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .profile-badge {
      font-family: 'Sora', sans-serif;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #8539FF;
      background: rgba(133, 57, 255, 0.12);
      border: 1px solid rgba(133, 57, 255, 0.3);
      padding: 3px 10px;
      border-radius: 9999px;
      width: fit-content;
    }

    .profile-name {
      font-family: 'Zalando', sans-serif;
      font-size: 22px;
      font-weight: 800;
      color: #F7FAFF;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .profile-handle {
      font-family: 'Sora', sans-serif;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.35);
    }

    .profile-bottom {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .profile-bio {
      font-family: 'Sora', sans-serif;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1.65;
    }

    .profile-stat {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Sora', sans-serif;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.35);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 5px 12px;
      border-radius: 9999px;
      width: fit-content;
    }

    .profile-socials {
      display: flex;
      gap: 8px;
    }

    .social-icon {
      width: 34px;
      height: 34px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, 0.5);
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .social-icon:hover {
      background: rgba(133, 57, 255, 0.2);
      border-color: rgba(133, 57, 255, 0.4);
      color: #fff;
    }

    .social-icon svg {
      width: 15px;
      height: 15px;
    }

    .links-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .btn {
      display: flex;
      align-items: center;
      gap: 16px;
      width: 100%;
      padding: 14px 18px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.09);
      text-decoration: none;
      transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      position: relative;
    }

    .btn:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.09);
      border-color: rgba(255, 255, 255, 0.18);
    }

    .btn-icon {
      flex-shrink: 0;
      width: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, 0.75);
    }

    .btn-icon svg {
      width: 20px;
      height: 20px;
    }

    .btn-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .btn-tag {
      font-family: 'Sora', sans-serif;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.4);
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 2px 7px;
      border-radius: 9999px;
      width: fit-content;
      margin-bottom: 3px;
    }

    .btn-title {
      font-family: 'Zalando', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #F7FAFF;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .btn-desc {
      font-family: 'Sora', sans-serif;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.4);
      line-height: 1.5;
      margin-top: 10px;
    }

    .btn-arrow {
      flex-shrink: 0;
      width: 32px;
      color: rgba(255, 255, 255, 0.35);
      transition: color 0.15s ease;
    }

    .btn:hover .btn-arrow {
      color: rgba(255, 255, 255, 0.7);
    }
  </style>
</Layout>
