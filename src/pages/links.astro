---
const WHATSAPP = 'https://link.oneimpact.com.br/contato-agencia-one-impact';
const INSTAGRAM = 'https://www.instagram.com/agenciaoneimpact';
const EMAIL = 'contato@oneimpact.com.br';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Links da One Impact — agência de posicionamento profissional." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>One Impact | Links</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background: #0D0A1A;
        font-family: 'Sora', sans-serif;
      }

      .lk-page {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
      }

      /* Malha de pontos fina */
      .lk-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.3) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, black, transparent 85%);
      }

      /* Orbs de glow roxo animados */
      .lk-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .lk-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(85px);
        will-change: transform;
      }

      .lk-orb-1 {
        width: 560px;
        height: 560px;
        bottom: -26%;
        left: 26%;
        background: radial-gradient(circle at center, #7345FD 0%, rgba(115, 69, 253, 0) 68%);
        opacity: 0.55;
        animation: lk-float-1 15s ease-in-out infinite;
      }

      .lk-orb-2 {
        width: 400px;
        height: 400px;
        top: 32%;
        left: 4%;
        background: radial-gradient(circle at center, #9774FE 0%, rgba(151, 116, 254, 0) 68%);
        opacity: 0.4;
        animation: lk-float-2 12s ease-in-out infinite;
      }

      .lk-orb-3 {
        width: 480px;
        height: 480px;
        bottom: -18%;
        right: 12%;
        background: radial-gradient(circle at center, #4B2FBE 0%, rgba(75, 47, 190, 0) 68%);
        opacity: 0.5;
        animation: lk-float-3 14s ease-in-out infinite;
      }

      @keyframes lk-float-1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(-40vw, -160px) scale(0.85); }
        66% { transform: translate(35vw, -110px) scale(1.3); }
      }

      @keyframes lk-float-2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(50vw, -180px) scale(1.15); }
      }

      @keyframes lk-float-3 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-55vw, -140px) scale(1.25); }
      }

      @media (prefers-reduced-motion: reduce) {
        .lk-orb { animation: none !important; }
      }

      .lk-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      /* ===== Hero ===== */
      .lk-badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 15px;
      }

      .lk-headline {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        color: #FFFFFF;
        line-height: 1.2;
        margin-bottom: 14px;
      }

      .lk-body {
        font-size: 13px;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.7;
        margin-bottom: 34px;
        max-width: 420px;
      }

      .wr-gradient {
        display: inline-block;
        background: linear-gradient(90deg, #9774FE, #7446FD, #C9BBFF, #9774FE, #9774FE);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradient-flow 7s linear infinite;
      }

      @keyframes gradient-flow {
        to { background-position: 200% center; }
      }

      /* ===== Card de apresentação (vidro) ===== */
      .lk-card {
        width: 100%;
        background: rgba(35, 32, 53, 0.55);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        backdrop-filter: blur(16px) saturate(1.3);
        border: 1px solid rgba(151, 116, 254, 0.3);
        border-radius: 5px;
        padding: 26px 28px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
        text-align: left;
        margin-bottom: 18px;
      }

      .lk-card-top {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .lk-avatar {
        width: 82px;
        height: 82px;
        min-width: 82px;
        border-radius: 50%;
        background: rgba(115, 69, 253, 0.15);
        border: 2px solid rgba(151, 116, 254, 0.65);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: #9774FE;
      }

      .lk-card-eyebrow {
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: #9774FE;
      }

      .lk-card-name {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #FFFFFF;
        line-height: 1.2;
        margin: 4px 0 4px;
      }

      .lk-card-tagline {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.65);
      }

      .lk-card-desc {
        font-size: 14px;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.75;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
      }

      /* ===== Botões ===== */
      .lk-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 20px;
      }

      .lk-btn {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 16px 20px;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.14);
        text-decoration: none;
        text-align: left;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }

      .lk-btn:hover {
        transform: translateY(-2px);
        border-color: rgba(151, 116, 254, 0.6);
        background: rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.25);
      }

      .lk-btn-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 50%;
        background: rgba(115, 69, 253, 0.18);
        color: #9774FE;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .lk-btn-title {
        flex: 1;
        font-size: 14px;
        font-weight: 600;
        color: #FFFFFF;
      }

      .lk-btn-arrow {
        color: #9774FE;
        transition: transform 0.25s ease;
      }

      .lk-btn:hover .lk-btn-arrow {
        transform: rotate(45deg);
      }

      /* Botão destaque — gradiente roxo com shimmer */
      .lk-btn.featured {
        border: 1px solid #9774FE;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        box-shadow: 0 12px 32px rgba(115, 69, 253, 0.4);
        animation: shimmer-purple 4s linear infinite;
      }

      .lk-btn.featured .lk-btn-icon {
        background: rgba(255, 255, 255, 0.25);
        color: #FFFFFF;
      }

      .lk-btn.featured .lk-btn-arrow {
        color: #FFFFFF;
      }

      .lk-btn.featured:hover {
        box-shadow: 0 16px 40px rgba(115, 69, 253, 0.55);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      /* ===== Redes sociais ===== */
      .lk-socials {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
      }

      .lk-social {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.7);
        transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
      }

      .lk-social:hover {
        color: #9774FE;
        border-color: rgba(151, 116, 254, 0.5);
        transform: translateY(-2px);
      }

      .lk-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
      }

      .lk-info-line {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        text-align: left;
        transition: color 0.2s ease;
      }

      .lk-info-line svg {
        flex-shrink: 0;
        color: #9774FE;
      }

      .lk-info-line:hover {
        color: #9774FE;
      }

      .lk-footer {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
        margin-top: 34px;
      }

      /* ===== Mobile ===== */
      @media (max-width: 640px) {
        .lk-page { padding: 44px 20px; align-items: flex-start; }
        .lk-headline { font-size: 26px; }
        .lk-card { padding: 22px 20px; }
        .lk-avatar { width: 68px; height: 68px; min-width: 68px; font-size: 15px; }
      }
    </style>
  </head>
  <body>
    <main class="lk-page">
      <div class="lk-dots" aria-hidden="true"></div>
      <div class="lk-bg" aria-hidden="true">
        <span class="lk-orb lk-orb-1"></span>
        <span class="lk-orb lk-orb-2"></span>
        <span class="lk-orb lk-orb-3"></span>
      </div>

      <div class="lk-container">

        <!-- Hero -->
        <span class="lk-badge">Agência de posicionamento profissional</span>
        <h1 class="lk-headline">
          Organizamos o <span class="wr-gradient">caos</span> do seu digital.
        </h1>
        <p class="lk-body">
          Sites, identidade visual e automações para transformar sua presença online em autoridade.
        </p>

        <!-- Card de apresentação -->
        <div class="lk-card">
          <div class="lk-card-top">
            <div class="lk-avatar"><span>OI</span></div>
            <div class="lk-card-id">
              <span class="lk-card-eyebrow">A agência</span>
              <h2 class="lk-card-name">One Impact</h2>
              <p class="lk-card-tagline">Sites · Identidade Visual · Automações</p>
            </div>
          </div>
          <p class="lk-card-desc">
            Unificamos sua presença online em uma estrutura profissional que passa
            credibilidade e transforma visitantes em clientes.
          </p>

          <!-- Botões -->
          <div class="lk-buttons">
            <a href={WHATSAPP} target="_blank" rel="noopener" class="lk-btn featured">
              <span class="lk-btn-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
              </span>
              <span class="lk-btn-title">Falar com a gente</span>
              <svg class="lk-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>

            <a href="/" class="lk-btn">
              <span class="lk-btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              </span>
              <span class="lk-btn-title">Conhecer o site da agência</span>
              <svg class="lk-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>

            <a href="/clientes-atendidos-sites" class="lk-btn">
              <span class="lk-btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="16" rx="2" /><line x1="3" y1="9" x2="21" y2="9" />
                </svg>
              </span>
              <span class="lk-btn-title">Sites que entregamos</span>
              <svg class="lk-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
          </div>

          <!-- Redes sociais -->
          <div class="lk-socials">
            <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram" class="lk-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href={`mailto:${EMAIL}`} aria-label="E-mail" class="lk-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          </div>

          <!-- Contato -->
          <div class="lk-info">
            <a href={`mailto:${EMAIL}`} class="lk-info-line">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>{EMAIL}</span>
            </a>
          </div>
        </div>

        <p class="lk-footer">© {new Date().getFullYear()} One Impact. Todos os direitos reservados.</p>

      </div>
    </main>
  </body>
</html>
