    <script>
      import Lenis from 'lenis'

      // Scroll suave (mesma config da pagina-v2)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }

      const revealGroups = document.querySelectorAll('[data-reveal]')
      requestAnimationFrame(() => {
        revealGroups.forEach((group) => group.classList.add('is-visible'))
      })

      // Count-up do número-herói (0 → 75%)
      const countupEl = document.getElementById('stat-countup')
      const runCountup = () => {
        if (!countupEl) return
        const target = 75
        const duration = 1400
        const start = performance.now()
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration)
          const eased = 1 - Math.pow(1 - progress, 3)
          countupEl.textContent = `${Math.round(eased * target)}%`
          if (progress < 1) requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      }

      // Reveal reversível por scroll — anima ao entrar, desfaz ao sair
      const scrollGroups = document.querySelectorAll('[data-reveal-scroll]')
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting)
            if (entry.isIntersecting && entry.target.contains(countupEl)) runCountup()
          })
        },
        { threshold: 0.3 },
      )
      scrollGroups.forEach((group) => observer.observe(group))

      // Menu flutuante — aparece depois que a seção de dados termina de passar
      const floatingHeader = document.getElementById('floating-header')
      const dadosSection = document.getElementById('dados')

      if (floatingHeader && dadosSection) {
        const updateHeader = () => {
          const rect = dadosSection.getBoundingClientRect()
          floatingHeader.classList.toggle('is-shown', rect.bottom <= window.innerHeight)
        }
        window.addEventListener('scroll', updateHeader, { passive: true })
        window.addEventListener('resize', updateHeader, { passive: true })
        updateHeader()
      }

      // Menu mobile — abre/fecha
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')

      if (mobileMenuToggle && mobileMenu) {
        const setMobileMenu = (open: boolean) => {
          mobileMenuToggle.setAttribute('aria-expanded', String(open))
          mobileMenuToggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu')
          mobileMenu.classList.toggle('is-open', open)
          mobileMenu.setAttribute('aria-hidden', String(!open))
          mobileMenu.toggleAttribute('inert', !open)
        }

        mobileMenuToggle.addEventListener('click', () => {
          setMobileMenu(mobileMenuToggle.getAttribute('aria-expanded') !== 'true')
        })

        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMobileMenu(false))
        })

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMobileMenu(false)
        })
      }

      // Cursor Spotlight — segue o mouse via CSS vars
      const spotlight = document.getElementById('cursor-spotlight')
      if (spotlight) {
        window.addEventListener('mousemove', (e) => {
          spotlight.style.setProperty('--x', `${e.clientX}px`)
          spotlight.style.setProperty('--y', `${e.clientY}px`)
        })
      }
    </script>
