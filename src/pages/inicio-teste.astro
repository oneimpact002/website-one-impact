---
const marqueeTopics = [
  'ADVOGADOS',
  'MÉDICOS',
  'NUTRICIONISTAS',
  'PSICÓLOGOS',
  'ARQUITETOS',
  'CONTADORES',
  'CONSULTORES',
  'COACHES',
]
const marqueeItems = [...marqueeTopics, ...marqueeTopics]
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>One Impact | Início (teste)</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #0D0A1A;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .hero {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        padding: 72px 20px 40px;
      }

      /* Imagem do celular — fundo do hero */
      .hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: #0D0A1A url('/hero-teste-celular-3.webp') center bottom / cover no-repeat;
      }

      .hero > .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 0;
      }

      .title {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.12;
        color: #FFFFFF;
        max-width: 820px;
      }

      .title-highlight {
        color: #9774FE;
      }

      .description {
        max-width: 500px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.75);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
        padding: 14px 48px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      /* Malha de pontos — bolinhas bem pequenas, textura sutil (acima dos cards) */
      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 45%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 45%, black, transparent 85%);
      }

      /* Menu flutuante — só aparece depois da seção de dados */
      .floating-header {
        position: fixed;
        top: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 5px 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 9999px;
        background: rgba(247, 245, 253, 0.78);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.16);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-16px);
        transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
      }

      .floating-header.is-shown {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .desktop-menu {
        display: none;
        align-items: center;
        gap: 2px;
      }

      .desktop-menu a {
        padding: 8px 11px;
        border-radius: 9999px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .desktop-menu a:hover {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
      }

      .mobile-menu-toggle {
        width: 34px;
        height: 34px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0;
        border: 1px solid rgba(19, 15, 38, 0.12);
        border-radius: 50%;
        background: rgba(19, 15, 38, 0.06);
        box-shadow: 0 3px 10px rgba(19, 15, 38, 0.08);
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
      }

      .mobile-menu-toggle > span {
        width: 18px;
        height: 1.5px;
        border-radius: 9999px;
        background: #130F26;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }

      .mobile-menu-toggle:hover,
      .mobile-menu-toggle[aria-expanded='true'] {
        border-color: rgba(19, 15, 38, 0.2);
        background: rgba(19, 15, 38, 0.1);
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(2) {
        opacity: 0;
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
      }

      .mobile-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px;
        border: 1px solid rgba(255, 255, 255, 0.62);
        border-radius: 5px;
        background: rgba(247, 245, 253, 0.94);
        box-shadow: 0 18px 42px rgba(19, 15, 38, 0.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px) scale(0.98);
        transform-origin: top center;
        transition: opacity 0.22s ease, visibility 0.22s ease, transform 0.22s ease;
      }

      .mobile-menu.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
      }

      .mobile-menu a {
        padding: 13px 16px;
        border-radius: 5px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .mobile-menu a:hover,
      .mobile-menu a:focus-visible {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
        outline: none;
      }

      @media (min-width: 900px) {
        .desktop-menu {
          display: flex;
        }

        .mobile-menu-toggle,
        .mobile-menu {
          display: none;
        }
      }

      /* Marquee — áreas atendidas */
      .marquee-section {
        position: relative;
        overflow: hidden;
        padding: 17px 0;
        background: #130F26;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        border-bottom: 1px solid rgba(115, 69, 253, 0.16);
      }

      .marquee-wrapper {
        display: flex;
        overflow: hidden;
        width: 100%;
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      }

      .marquee-track {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        white-space: nowrap;
        animation: marquee-scroll 30s linear infinite;
        flex-shrink: 0;
        padding-right: 2.5rem;
      }

      .marquee-track:hover {
        animation-play-state: paused;
      }

      .marquee-item {
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.15em;
        color: rgba(255, 255, 255, 0.86);
      }

      .marquee-separator {
        font-size: 13px;
        color: #9774FE;
        opacity: 0.7;
      }

      @keyframes marquee-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      /* Reveal reversível — aparece ao entrar na tela, some ao sair */
      .reveal-ready [data-reveal-scroll] .reveal-fade {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal-scroll] .reveal-fade:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal-scroll] .reveal-fade:nth-child(3) { transition-delay: 160ms; }

      .reveal-ready [data-reveal-scroll].is-visible .reveal-fade {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      /* Seção Dados — número-herói + barras horizontais */
      .dados-section {
        position: relative;
        overflow: hidden;
        padding: 88px 20px;
        background: #130F26;
      }

      .dados-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 45%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 45%, black, transparent 85%);
      }

      .dados-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .dados-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .dados-grid {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 32px;
        align-items: center;
      }

      .stat-hero-value {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 72px;
        font-weight: 700;
        line-height: 1;
        background: linear-gradient(90deg, #7345FD, #9774FE, #E9E1FF, #9774FE, #7345FD);
        background-size: 300% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: shimmer-purple 4s linear infinite;
      }

      .stat-hero-label {
        max-width: 380px;
        margin-top: 10px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
      }

      .stat-bars {
        width: 100%;
        max-width: 640px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        text-align: left;
      }

      .stat-bar-label {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 6px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
      }

      .stat-bar-label strong {
        color: #FFFFFF;
        font-weight: 700;
      }

      .stat-bar-track {
        height: 10px;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
      }

      .stat-bar-fill {
        height: 100%;
        width: 0;
        border-radius: 5px;
        background: linear-gradient(90deg, #7345FD, #9774FE);
        transition: width 1.1s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .is-visible .stat-bar-fill {
        width: var(--val);
      }

      .dados-fonte {
        margin-top: 8px;
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.45);
      }

      @media (min-width: 900px) {
        .dados-grid {
          flex-direction: row;
          justify-content: center;
          gap: 72px;
          align-items: center;
        }

        .stat-hero {
          text-align: left;
        }

        .stat-hero-value {
          font-size: 96px;
        }
      }

      /* Rodapé corporativo */
      .footer {
        background: #0D0A1A;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        padding: 56px 20px 0;
        font-family: 'Sora', sans-serif;
      }

      .footer-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .footer-col h4 {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-brand strong {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-brand p {
        margin: 10px 0 0;
        max-width: 280px;
        font-size: 12px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.6);
      }

      .footer-col ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-col a {
        font-size: 13px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        transition: color 0.2s ease;
      }

      .footer-col a:hover {
        color: #9774FE;
      }

      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .footer-bottom span {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      @media (min-width: 900px) {
        .footer-grid {
          display: grid;
          grid-template-columns: 2fr 1fr 1fr;
          gap: 40px;
        }
      }

      @media (max-width: 899px) {
        .footer-grid {
          display: flex;
          flex-direction: column;
          gap: 32px;
        }
      }

      /* Cursor Spotlight — revela a malha de pontos ao redor do mouse (ref: animacoes e efeitos.md) */
      .cursor-spotlight {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.65) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
        mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
      }

      /* ===== Boxes flutuantes de métricas (glassmorphism) ===== */
      .hero-floaters {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }

      .float-card {
        position: absolute;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 14px 16px;
        border-radius: 5px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.18);
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        text-align: left;
        animation: float-y 5.5s ease-in-out infinite alternate;
      }

      .float-card-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.75);
      }

      /* Donut de score */
      .float-score {
        align-items: center;
        text-align: center;
      }

      .float-donut {
        position: relative;
        width: 74px;
        height: 74px;
        border-radius: 50%;
        background: conic-gradient(#9774FE 0 349deg, rgba(255, 255, 255, 0.16) 349deg 360deg);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .float-donut::before {
        content: '';
        position: absolute;
        inset: 9px;
        border-radius: 50%;
        background: rgba(19, 15, 38, 0.88);
      }

      .float-donut strong {
        position: relative;
        font-size: 16px;
        font-weight: 700;
      }

      /* Pill de conversão */
      .float-pill {
        flex-direction: row;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 600;
      }

      .float-pill strong {
        color: #B9A3FF;
        font-weight: 700;
      }

      /* Checklist de etapas */
      .float-checklist ul {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .float-checklist li {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.85);
      }

      .float-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, #9774FE, #7446FD);
        color: #FFFFFF;
        font-size: 8px;
        font-weight: 700;
      }

      /* Card de novos clientes com gráfico de barras */
      .float-chart-value {
        font-size: 20px;
        font-weight: 700;
        color: #B9A3FF;
        line-height: 1;
      }

      .float-bars {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        height: 34px;
      }

      .float-bars span {
        width: 8px;
        border-radius: 2px;
        background: rgba(151, 116, 254, 0.35);
      }

      .float-bars span:nth-child(1) { height: 30%; }
      .float-bars span:nth-child(2) { height: 45%; }
      .float-bars span:nth-child(3) { height: 40%; }
      .float-bars span:nth-child(4) { height: 65%; }
      .float-bars span:nth-child(5) { height: 80%; }
      .float-bars span:nth-child(6) { height: 100%; background: #9774FE; }

      .float-chart-delta {
        font-size: 9px;
        font-weight: 600;
        color: #8BE79B;
      }

      /* Posições — desktop */
      .float-score { top: 24%; left: 8%; animation-delay: -1s; }
      .float-pill-conversao { top: 50%; left: 11%; animation-delay: -2.5s; }
      .float-checklist { top: 62%; left: 7%; animation-delay: -4s; }
      .float-chart { top: 26%; right: 7%; animation-delay: -1.8s; }
      .float-pill-automacao { top: 56%; right: 10%; animation-delay: -3.2s; }

      @keyframes float-y {
        from { transform: translateY(0); }
        to { transform: translateY(-10px); }
      }

      /* Mobile — menos cards, menores, nas laterais do celular */
      @media (max-width: 899px) {
        .float-card {
          padding: 10px 12px;
          gap: 6px;
        }

        .float-donut {
          width: 54px;
          height: 54px;
        }

        .float-donut::before {
          inset: 7px;
        }

        .float-donut strong {
          font-size: 12px;
        }

        .float-card-label {
          font-size: 8px;
        }

        .float-chart-value {
          font-size: 15px;
        }

        .float-bars {
          height: 24px;
        }

        .float-bars span {
          width: 6px;
        }

        .float-chart-delta {
          font-size: 8px;
        }

        .float-checklist li {
          font-size: 8px;
