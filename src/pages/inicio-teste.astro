      @media (min-width: 900px) {
        .title {
          font-size: 54px;
          letter-spacing: -1px;
        }

        .hero {
          padding-top: 96px;
        }

        /* Em telas largas a imagem (vertical) fica contida e centralizada */
        .hero-bg {
          background-size: contain;
          background-position: center bottom;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-ready [data-reveal] .reveal-item {
          opacity: 1;
          transform: none;
          transition: none;
        }

        .button,
        .stat-hero-value {
