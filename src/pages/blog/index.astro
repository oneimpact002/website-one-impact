---
import { getCollection } from 'astro:content'
import Rastreio from '../../components/Rastreio.astro';
import Header from '../../components/Header.astro'
import PostCard from '../../components/PostCard.astro';
import { FERRAMENTAS } from '../../data/ferramentas.js';
import { CANAL } from '../../data/canal.js';

const WHATSAPP = 'https://link.oneimpact.com.br/contato-agencia-one-impact';

const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf())

// Assuntos para o filtro do topo, com a quantidade de artigos de cada um.
const categories = [...new Set(posts.map((p) => p.data.category))].map((name) => ({
  name,
  count: posts.filter((p) => p.data.category === name).length,
}))

const fmtDate =(d: Date) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' }).format(d)

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog One Impact',
  url: 'https://agenciaoneimpact.com.br/blog',
  description: 'Conteúdo sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais.',
  publisher: {
    '@type': 'Organization',
    name: 'One Impact',
    url: 'https://agenciaoneimpact.com.br',
  },
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog sobre Criação de Sites e Posicionamento Digital | One Impact</title>
    <meta name="description" content="Guias práticos sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais." />
    <link rel="canonical" href="https://agenciaoneimpact.com.br/blog" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Blog One Impact" />
    <meta property="og:description" content="Guias práticos sobre criação de sites e posicionamento digital para profissionais." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenciaoneimpact.com.br/blog" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal-scroll] .reveal-fade {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }

      .reveal-ready [data-reveal-scroll].is-visible .reveal-fade {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
      }

      /* Hero editorial, alinhado à esquerda */
      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 56px;
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(75, 47, 190, 0.25) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
        mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 45% 55% at 85% 10%, rgba(115, 69, 253, 0.14), transparent 70%);
      }

      .hero .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.35);
        background: rgba(115, 69, 253, 0.08);
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      h1 {
        max-width: 640px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
        color: #130F26;
      }

      h1 .hl {
        color: #7345FD;
      }

      .hero-desc {
        max-width: 560px;
        font-size: 14.5px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      /* Destaque — post mais recente */
      /* Lista de posts — card horizontal, imagem + conteúdo */
      .posts-section {
        padding: 8px 20px 72px;
      }

      .posts-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .post-row {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 5px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 8px 24px rgba(19, 15, 38, 0.06);
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .post-row:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 34px rgba(115, 69, 253, 0.14);
      }

      .post-row-media {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: linear-gradient(135deg, #130F26, #4B2FBE);
      }

      .post-row-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .post-row-media-fallback {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .post-row-media-fallback span {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(247, 245, 253, 0.9);
      }

      .post-row-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 22px 20px;
      }

      .post-meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        font-size: 11.5px;
        color: rgba(19, 15, 38, 0.55);
      }

      .post-cat {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 9999px;
        background: rgba(115, 69, 253, 0.1);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      .post-row-body h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.35;
        color: #130F26;
      }

      .post-row-body p {
        font-size: 14px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(19, 15, 38, 0.68);
      }

      .read-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        font-size: 13px;
        font-weight: 700;
        color: #7345FD;
      }

      .posts-empty {
        max-width: 560px;
        margin: 0 auto;
        padding: 28px 20px;
        border-radius: 5px;
        border: 1px dashed rgba(115, 69, 253, 0.4);
        background: #FFFFFF;
        text-align: center;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      /* CTA final — bloco escuro para fechar */
      .final-section {
        position: relative;
        overflow: hidden;
        padding: 80px 20px;
        text-align: center;
        background: #130F26;
      }

      .final-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 60% at 50% 100%, rgba(115, 69, 253, 0.25), transparent 70%);
      }

      .final-section .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        max-width: 640px;
      }

      .final-badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #C9BBFF;
      }

      .final-section h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        color: #F7F5FD;
      }

      .final-section h2 .hl {
        color: #C9BBFF;
      }

      .final-desc {
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.75);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 9999px;
        background: linear-gradient(135deg, #7345FD, #4B2FBE);
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        color: #F7F5FD;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(115, 69, 253, 0.4);
      }

      .final-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 14px 24px;
        margin-top: 6px;
      }

      .final-link {
        font-size: 13.5px;
        font-weight: 600;
        color: #C9BBFF;
        text-decoration: none;
      }

      .final-link:hover {
        text-decoration: underline;
      }

      @media (min-width: 768px) {
        h1 {
          font-size: 42px;
        }

        .post-row {
          flex-direction: row;
        }

        .post-row-media {
          width: 320px;
          aspect-ratio: auto;
          flex-shrink: 0;
        }

        .post-row-body {
          justify-content: center;
          padding: 28px 36px;
        }

        .post-row-body h2 {
          font-size: 21px;
        }

        .final-section h2 {
          font-size: 32px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-ready [data-reveal-scroll] .reveal-fade {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* Rodapé — mesmo padrão da home */
      .footer {
        background: #0D0A1A;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        padding: 56px 20px 0;
        font-family: 'Sora', sans-serif;
      }

      .footer-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .footer-col h4 {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-logo {
        height: 34px;
        width: auto;
        display: block;
      }

      .footer-brand p {
        margin: 10px 0 0;
        max-width: 280px;
        font-size: 12px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.6);
      }

      .footer-col ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-col a {
        font-size: 13px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        transition: color 0.2s ease;
      }

      .footer-col a:hover {
        color: #9774FE;
      }

      .footer-social {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .footer-social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.3);
        background: rgba(115, 69, 253, 0.1);
        color: rgba(255, 255, 255, 0.75);
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }

      .footer-social-icon:hover {
        color: #FFFFFF;
        border-color: rgba(151, 116, 254, 0.55);
        background: rgba(115, 69, 253, 0.2);
      }

      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .footer-bottom span {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      @media (min-width: 900px) {
        .footer-grid {
          display: grid;
          grid-template-columns: 2fr 1fr 1fr;
          gap: 40px;
        }
      }

      @media (max-width: 899px) {
        .footer-grid {
          display: flex;
          flex-direction: column;
          gap: 32px;
        }
      }

      /* Layout em duas colunas: artigos à esquerda, resumo e CTA à direita */
      .container.wide {
        max-width: 1160px;
      }

      .blog-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 32px;
      }

      @media (min-width: 980px) {
        .blog-layout {
          grid-template-columns: minmax(0, 1fr) 320px;
          gap: 36px;
        }

        /* Só o card de ferramentas acompanha a rolagem. A coluna inteira
           grudava na base da tela porque os dois cards juntos são altos. */
        .side-cta {
          position: sticky;
          top: 96px;
        }
      }

      .topics {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 26px;
      }

      .topics-label {
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(19, 15, 38, 0.55);
      }

      .topics-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .topic {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.1);
        background: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #130F26;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
      }

      .topic span {
        font-size: 11px;
        color: rgba(19, 15, 38, 0.5);
      }

      .topic:hover {
        border-color: rgba(115, 69, 253, 0.5);
      }

      .topic.is-active {
        border-color: #7345FD;
        background: #7345FD;
        color: #FFFFFF;
      }

      .topic.is-active span {
        color: rgba(255, 255, 255, 0.8);
      }

      .posts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 22px;
      }

      @media (min-width: 640px) {
        .posts-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }


      /* Coluna da direita */
      .blog-side {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .side-card {
        padding: 22px 20px;
        border-radius: 12px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 8px 24px rgba(19, 15, 38, 0.06);
      }

      .side-title {
        margin-bottom: 14px;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(19, 15, 38, 0.55);
      }

      .about-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .about-head img {
        width: 56px;
        height: 56px;
        border-radius: 9999px;
        object-fit: cover;
      }

      .about-head strong {
        display: block;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 14px;
        color: #130F26;
      }

      .about-head span {
        font-size: 12px;
        color: rgba(19, 15, 38, 0.6);
      }

      .side-about p {
        font-size: 13px;
        line-height: 1.7;
        color: rgba(19, 15, 38, 0.72);
      }

      .about-links {
        display: flex;
        gap: 14px;
        margin-top: 14px;
      }

      .about-links a {
        font-size: 12.5px;
        font-weight: 600;
        color: #4B2FBE;
        text-decoration: none;
      }

      .about-links a:hover {
        text-decoration: underline;
      }

      .side-cta {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
        padding: 24px 22px 22px;
        border: 1px solid rgba(115, 69, 253, 0.3);
        background: linear-gradient(135deg, #130F26 0%, #2a1a66 65%, #4B2FBE 100%);
        color: #F7F5FD;
      }

      .side-cta::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(255, 255, 255, 0.14) 0.8px, transparent 0.8px);
        background-size: 14px 14px;
        -webkit-mask-image: radial-gradient(ellipse 70% 60% at 100% 0%, black, transparent 75%);
        mask-image: radial-gradient(ellipse 70% 60% at 100% 0%, black, transparent 75%);
      }

      .side-cta > * {
        position: relative;
        z-index: 1;
      }

      .cta-top {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .cta-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #7345FD, #9b7bff);
        color: #FFFFFF;
        box-shadow: 0 8px 20px rgba(115, 69, 253, 0.45);
      }

      .side-cta-tag {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #B9A4FF;
      }

      .side-cta h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 18px;
        line-height: 1.3;
        color: #FFFFFF;
      }

      .side-cta p {
        font-size: 13px;
        line-height: 1.65;
        color: rgba(247, 245, 253, 0.82);
      }

      .tool-mini-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        list-style: none;
      }

      .tool-mini-list li {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.08);
      }

      .tool-mini-icon {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #7345FD;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #FFFFFF;
      }

      .tool-mini-list strong {
        display: block;
        font-size: 13.5px;
        color: #FFFFFF;
      }

      .tool-mini-list small {
        font-size: 11.5px;
        color: rgba(247, 245, 253, 0.7);
      }

      .side-cta .cta-button {
        justify-content: center;
        gap: 8px;
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        padding: 12px 22px;
        border-radius: 9999px;
        background: #7345FD;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        color: #FFFFFF;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .cta-button:hover {
        background: #8a63ff;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container wide" data-reveal-scroll>
        <span class="badge reveal-fade">Blog One Impact</span>
        <h1 class="reveal-fade">Guias para criar seu site e <span class="hl">vender mais na internet</span></h1>
        <p class="hero-desc reveal-fade">
          Hospedagem, ferramentas e posicionamento digital explicados de forma direta, a partir do que usamos nos projetos da agência e no canal do YouTube.
        </p>
      </div>
    </section>

    <section class="posts-section">
      <div class="container wide" data-reveal-scroll>
        {posts.length === 0 && (
          <p class="posts-empty reveal-fade">Os primeiros artigos estão sendo preparados. Volte em breve!</p>
        )}
        {posts.length > 0 && (
          <>
          <div class="topics reveal-fade" role="group" aria-label="Filtrar por assunto">
            <span class="topics-label">Explore por assunto</span>
            <div class="topics-list">
              <button type="button" class="topic is-active" data-filter="todos" aria-pressed="true">Todos <span>{posts.length}</span></button>
              {categories.map((c) => (
                <button type="button" class="topic" data-filter={c.name} aria-pressed="false">{c.name} <span>{c.count}</span></button>
              ))}
            </div>
          </div>

          <div class="blog-layout">
            <div class="blog-main">
              <div class="posts-grid reveal-fade">
                {posts.map((post, i) => (
                  <PostCard post={post} priority={i < 2} />))}
