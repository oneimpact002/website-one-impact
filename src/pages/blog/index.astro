    <script>
      import Lenis from 'lenis'

      const scrollGroups = document.querySelectorAll('[data-reveal-scroll]')
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting)
          })
        },
        { threshold: 0.05 },
      )
      scrollGroups.forEach((group) => observer.observe(group))

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
    <script is:inline>
      // Filtro por assunto. Todos os artigos já estão no HTML, o filtro só esconde os outros.
      var topics = document.querySelectorAll('.topic')
      var cards = document.querySelectorAll('.post-card')
      topics.forEach(function (topic) {
        topic.addEventListener('click', function () {
          var filter = topic.dataset.filter
          topics.forEach(function (t) {
            var on = t === topic
            t.classList.toggle('is-active', on)
            t.setAttribute('aria-pressed', on ? 'true' : 'false')
          })
          cards.forEach(function (card) {
            card.hidden = filter !== 'todos' && card.dataset.category !== filter
          })
        })
      })
    </script>
