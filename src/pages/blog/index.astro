---
import { getCollection } from 'astro:content'

const WHATSAPP = 'https://wa.me/5541988733518?text=' + encodeURIComponent('Olá! Vim pelo blog da One Impact e quero saber mais.');

const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf())

const featured = posts[0]
const rest = posts.slice(1)

const fmtDate = (d: Date) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' }).format(d)
const readingTime = (body: string | undefined) => Math.max(1, Math.round((body ? body.split(/\s+/).length : 0) / 200))

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog One Impact',
  url: 'https://agenciaoneimpact.com.br/blog',
  description: 'Conteúdo sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais.',
  publisher: {
    '@type': 'Organization',
    name: 'One Impact',
    url: 'https://agenciaoneimpact.com.br',
  },
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog sobre Criação de Sites e Posicionamento Digital | One Impact</title>
    <meta name="description" content="Guias práticos sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais." />
    <link rel="canonical" href="https://agenciaoneimpact.com.br/blog" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Blog One Impact" />
    <meta property="og:description" content="Guias práticos sobre criação de sites e posicionamento digital para profissionais." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenciaoneimpact.com.br/blog" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal-scroll] .reveal-fade {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }

      .reveal-ready [data-reveal-scroll].is-visible .reveal-fade {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .floating-header {
        position: fixed;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 60;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        width: min(92%, 720px);
        padding: 10px 16px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: rgba(255, 255, 255, 0.82);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.12);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .back-link {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        color: rgba(19, 15, 38, 0.7);
        transition: color 0.2s ease;
      }

      .back-link:hover {
        color: #7345FD;
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
      }

      /* Hero editorial, alinhado à esquerda */
      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 56px;
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(75, 47, 190, 0.25) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
        mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 45% 55% at 85% 10%, rgba(115, 69, 253, 0.14), transparent 70%);
      }

      .hero .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.35);
        background: rgba(115, 69, 253, 0.08);
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      h1 {
        max-width: 640px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
        color: #130F26;
      }

      h1 .hl {
        color: #7345FD;
      }

      .hero-desc {
        max-width: 560px;
        font-size: 14.5px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      /* Destaque — post mais recente */
      .featured-section {
        padding: 8px 20px 24px;
      }

      .featured-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 5px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 12px 36px rgba(19, 15, 38, 0.08);
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .featured-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 44px rgba(115, 69, 253, 0.18);
      }

      .featured-media {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: linear-gradient(135deg, #130F26, #4B2FBE);
      }

      .featured-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .featured-media-fallback {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .featured-media-fallback span {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(247, 245, 253, 0.9);
      }

      .featured-tag {
        position: absolute;
        top: 14px;
        left: 14px;
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        background: #7345FD;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #F7F5FD;
      }

      .featured-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 24px 20px;
      }

      .post-meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        font-size: 11.5px;
        color: rgba(19, 15, 38, 0.55);
      }

      .post-cat {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 9999px;
        background: rgba(115, 69, 253, 0.1);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      .featured-body h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 21px;
        font-weight: 700;
        line-height: 1.3;
        color: #130F26;
      }

      .featured-body > p {
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      .read-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #7345FD;
      }

      /* Grid dos demais posts */
      .posts-section {
        padding: 8px 20px 72px;
      }

      .posts-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .post-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 5px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 8px 24px rgba(19, 15, 38, 0.06);
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 34px rgba(115, 69, 253, 0.16);
      }

      .post-card-cover {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: linear-gradient(135deg, #130F26, #4B2FBE);
      }

      .post-card-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .post-card-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
      }

      .post-card h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 16.5px;
        font-weight: 600;
        line-height: 1.35;
        color: #130F26;
      }

      .post-card p {
        font-size: 13px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(19, 15, 38, 0.68);
      }

      .posts-empty {
        max-width: 560px;
        margin: 0 auto;
        padding: 28px 20px;
        border-radius: 5px;
        border: 1px dashed rgba(115, 69, 253, 0.4);
        background: #FFFFFF;
        text-align: center;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      /* CTA final — bloco escuro para fechar */
      .final-section {
        position: relative;
        overflow: hidden;
        padding: 80px 20px;
        text-align: center;
        background: #130F26;
      }

      .final-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 60% at 50% 100%, rgba(115, 69, 253, 0.25), transparent 70%);
      }

      .final-section .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        max-width: 640px;
      }

      .final-badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #C9BBFF;
      }

      .final-section h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        color: #F7F5FD;
      }

      .final-desc {
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.75);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 9999px;
        background: linear-gradient(135deg, #7345FD, #4B2FBE);
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        color: #F7F5FD;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(115, 69, 253, 0.4);
      }

      @media (min-width: 768px) {
        h1 {
          font-size: 42px;
        }

        .featured-card {
          flex-direction: row;
        }

        .featured-media {
          width: 52%;
          aspect-ratio: auto;
          flex-shrink: 0;
        }

        .featured-body {
          justify-content: center;
          padding: 36px 32px;
        }

        .featured-body h2 {
          font-size: 25px;
        }

        .posts-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .final-section h2 {
          font-size: 32px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-ready [data-reveal-scroll] .reveal-fade {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="floating-header">
      <a class="brand" href="/" aria-label="One Impact — início">
        <strong>One Impact</strong>
      </a>
      <a class="back-link" href="/">← Voltar ao início</a>
    </header>

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container" data-reveal-scroll>
        <span class="badge reveal-fade">Blog One Impact</span>
        <h1 class="reveal-fade">Conteúdo para o seu negócio <span class="hl">aparecer e vender mais</span></h1>
        <p class="hero-desc reveal-fade">
          Guias práticos sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais.
        </p>
      </div>
    </section>

    {featured && (
      <section class="featured-section">
        <div class="container" data-reveal-scroll>
          <a class="featured-card reveal-fade" href={`/blog/${featured.id}`}>
            <div class="featured-media">
              {featured.data.cover ? (
                <img src={featured.data.cover} alt={featured.data.coverAlt ?? featured.data.title} loading="eager" fetchpriority="high" />
              ) : (
                <span class="featured-media-fallback"><span>One Impact</span></span>
              )}
              <span class="featured-tag">Mais recente</span>
            </div>
            <div class="featured-body">
              <span class="post-meta-row">
                <span class="post-cat">{featured.data.category}</span>
                <time datetime={featured.data.datePublished.toISOString()}>{fmtDate(featured.data.datePublished)}</time>
                <span>·</span>
                <span>{readingTime(featured.body)} min de leitura</span>
              </span>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.description}</p>
              <span class="read-link">Ler artigo completo <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </div>
      </section>
    )}

    <section class="posts-section">
      <div class="container" data-reveal-scroll>
        {posts.length === 0 && (
          <p class="posts-empty reveal-fade">Os primeiros artigos estão sendo preparados. Volte em breve!</p>
        )}
        {rest.length > 0 && (
          <div class="posts-grid reveal-fade">
            {rest.map((post) => (
              <a class="post-card" href={`/blog/${post.id}`}>
                <div class="post-card-cover">
                  {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} loading="lazy" decoding="async" />}
                </div>
                <div class="post-card-body">
                  <span class="post-meta-row">
                    <span class="post-cat">{post.data.category}</span>
                    <time datetime={post.data.datePublished.toISOString()}>{fmtDate(post.data.datePublished)}</time>
                  </span>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="read-link">Ler artigo <span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="final-section">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="container" data-reveal-scroll>
        <span class="final-badge reveal-fade">Vamos conversar</span>
        <h2 class="reveal-fade">Quer um site que aplica tudo isso por você?</h2>
        <p class="final-desc reveal-fade">Conta pra gente sobre o seu negócio e receba um orçamento personalizado, sem compromisso.</p>
        <a href={WHATSAPP} class="button reveal-fade" target="_blank" rel="noopener">
          Falar com a One Impact
        </a>
      </div>
    </section>

    <script>
      import Lenis from 'lenis'

      const scrollGroups = document.querySelectorAll('[data-reveal-scroll]')
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting)
          })
        },
        { threshold: 0.05 },
      )
      scrollGroups.forEach((group) => observer.observe(group))

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
  </body>
</html>
