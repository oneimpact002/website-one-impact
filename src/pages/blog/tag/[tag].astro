---
import { getCollection } from 'astro:content'
import Rastreio from '../../../components/Rastreio.astro';
import AnimacaoRolagem from '../../../components/AnimacaoRolagem.astro'
import Header from '../../../components/Header.astro'
import Footer from '../../../components/Footer.astro'
import PostCard from '../../../components/PostCard.astro'
import { tagsComPagina } from '../../../lib/blog.js'

// Uma página por tag com 2 ou mais artigos (ex.: /blog/tag/hostinger).
// Ajuda o Google a entender o assunto do blog e agrupa os artigos do tema.
export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
    .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf())

  return [...tagsComPagina(posts).values()].map((tag) => ({
    params: { tag: tag.slug },
    props: { nome: tag.nome, posts: tag.posts },
  }))
}

const { nome, posts } = Astro.props
const url = `https://agenciaoneimpact.com.br/blog/tag/${Astro.params.tag}`
const titulo = `${nome}: artigos e guias | Blog One Impact`
const descricao = `Todos os artigos do blog da One Impact sobre ${nome}: ${posts.length} guias práticos com base na nossa experiência.`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${nome}: artigos e guias`,
  description: descricao,
  url,
  inLanguage: 'pt-BR',
  isPartOf: { '@type': 'Blog', name: 'Blog One Impact', url: 'https://agenciaoneimpact.com.br/blog' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://agenciaoneimpact.com.br/blog/${p.id}`,
      name: p.data.title,
    })),
  },
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://agenciaoneimpact.com.br' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://agenciaoneimpact.com.br/blog' },
    { '@type': 'ListItem', position: 3, name: nome, item: url },
  ],
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 40px;
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 45% 55% at 85% 10%, rgba(115, 69, 253, 0.14), transparent 70%);
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(75, 47, 190, 0.25) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
        mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
      }

      .hero .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
      }

      .breadcrumb {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 12px;
        color: rgba(19, 15, 38, 0.55);
      }

      .breadcrumb a {
        color: rgba(19, 15, 38, 0.7);
        text-decoration: none;
      }

      .breadcrumb a:hover {
        color: #7345FD;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.35);
        background: rgba(115, 69, 253, 0.08);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      h1 {
        max-width: 700px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
        color: #130F26;
      }

      h1 .hl {
        color: #7345FD;
      }

      .hero-desc {
        max-width: 600px;
        font-size: 14.5px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      .posts-section {
        padding: 8px 20px 72px;
      }

      .posts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 22px;
      }

      @media (min-width: 640px) {
        .posts-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 980px) {
        .posts-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .back-to-blog {
        display: inline-block;
        margin-top: 32px;
        font-size: 13px;
        font-weight: 600;
        color: #4B2FBE;
        text-decoration: none;
      }

      .back-to-blog:hover {
        text-decoration: underline;
      }
    </style>
    <AnimacaoRolagem />
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container" data-reveal-scroll data-reveal-filhos>
        <nav class="breadcrumb" aria-label="Você está em">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{nome}</span>
        </nav>
        <span class="badge">Tag</span>
        <h1>Artigos sobre <span class="hl">{nome}</span></h1>
        <p class="hero-desc">
          {posts.length} {posts.length === 1 ? 'artigo' : 'artigos'} do blog sobre {nome}, escritos a partir da nossa experiência de uso nos projetos da agência.
        </p>
      </div>
    </section>

    <section class="posts-section">
      <div class="container" data-reveal-scroll data-reveal-filhos>
        <div class="posts-grid">
          {posts.map((post, i) => <PostCard post={post} priority={i < 3} />)}
        </div>
        <a class="back-to-blog" href="/blog">← Ver todos os artigos do blog</a>
      </div>
    </section>

    <Footer />
    <Rastreio />
  </body>
</html>
