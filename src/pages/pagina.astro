---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="One Impact | Sites e Automações"
  description="Sites e automações que geram resultado real para o seu negócio."
  bodyClass="diagnostico-page"
>
  <Header />

  <section id="inicio" class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <h1 class="hero-title">
          Sites e automações que geram
          <span class="hero-title-highlight">resultado real</span>.
        </h1>
        <p class="hero-subtitle">
          Criamos presença digital e automações que transformam visitantes em clientes todos os dias.
        </p>
        <a href="#contato" class="hero-cta">
          <span class="hero-cta-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#130F26" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </span>
          Fale com a gente
        </a>
      </div>

      <div class="glass-card" aria-hidden="true">
        <div class="card-glow"></div>

        <div class="card-nodes">
          <div class="node-item">
            <div class="node-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2.5" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <circle cx="6.5" cy="6.5" r="0.6" fill="#fff" />
              </svg>
            </div>
            <span class="node-label">Site</span>
          </div>

          <svg class="connector" viewBox="0 0 100 20" preserveAspectRatio="none">
            <line x1="0" y1="10" x2="100" y2="10" class="connector-line" />
            <line x1="0" y1="10" x2="100" y2="10" class="connector-flow" />
          </svg>

          <div class="node-item">
            <div class="node-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="5" r="2.2" />
                <circle cx="5" cy="18" r="2.2" />
                <circle cx="19" cy="18" r="2.2" />
                <path d="M12 7.2V12M12 12L6.3 16.3M12 12l5.7 4.3" />
              </svg>
            </div>
            <span class="node-label">Automação</span>
          </div>
        </div>

        <p class="card-caption">Presença digital e automação, conectadas em um só lugar.</p>
      </div>
    </div>
  </section>

  <section class="marquee-section" aria-label="Serviços oferecidos">
    <div class="marquee-track">
      <div class="marquee-group">
        <span class="marquee-item">Site profissional</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Automação de WhatsApp</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Identidade visual</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Google Meu Negócio</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Automação de atendimento</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Presença digital organizada</span>
        <span class="marquee-dot"></span>
      </div>
      <div class="marquee-group" aria-hidden="true">
        <span class="marquee-item">Site profissional</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Automação de WhatsApp</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Identidade visual</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Google Meu Negócio</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Automação de atendimento</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Presença digital organizada</span>
        <span class="marquee-dot"></span>
      </div>
    </div>
  </section>

  <section id="realidade" class="reality">
    <div class="reality-orb"></div>

    <div class="reality-inner">
      <h2 class="reality-title" data-reveal>
        Você já é bom no que faz. Seu digital ainda não mostra isso.
      </h2>
      <p class="reality-subtitle" data-reveal>
        Profissionais liberais, autônomos e prestadores de serviço constroem anos de experiência, mas dependem só de indicação porque não têm site, automação ou presença digital organizada.
      </p>

      <div class="symptom-list" data-reveal>
        <span class="symptom"><span class="symptom-dot"></span>Sem site profissional</span>
        <span class="symptom"><span class="symptom-dot"></span>Instagram desorganizado</span>
        <span class="symptom"><span class="symptom-dot"></span>Atendimento lento no WhatsApp</span>
        <span class="symptom"><span class="symptom-dot"></span>Depende só de indicação</span>
        <span class="symptom"><span class="symptom-dot"></span>Google Meu Negócio incompleto</span>
      </div>
    </div>
  </section>

  <div id="contato">
    <Footer />
  </div>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll('[data-reveal]');

    if (reduceMotion) {
      revealEls.forEach((el) => el.classList.add('reveal-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      revealEls.forEach((el) => observer.observe(el));
    }
  </script>

  <style>
    .hero {
      position: relative;
      overflow: hidden;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      background: #000;
      padding: 6rem 24px 4rem;
    }

    .hero-inner {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      gap: 48px;
    }

    @media (min-width: 900px) {
      .hero-inner {
        grid-template-columns: 1.1fr 0.9fr;
        gap: 32px;
      }
    }

    @media (max-width: 899px) {
      .hero {
        align-items: flex-end;
        min-height: calc(100dvh - 200px);
        padding-bottom: 56px;
      }

      .glass-card {
        display: none;
      }
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      text-align: left;
    }

    .hero-title {
      font-family: 'Zalando Sans Expanded', sans-serif;
      font-weight: 800;
      font-size: clamp(34px, 6vw, 58px);
      line-height: 1.08;
      letter-spacing: -0.02em;
      color: #F7FAFF;
      max-width: 14ch;
      opacity: 0;
      animation: fade-up 0.7s ease forwards;
      animation-delay: 0.05s;
    }

    .hero-title-highlight {
      background: linear-gradient(90deg, #9774FE, #7446FD);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-family: 'Sora', sans-serif;
      font-size: 17px;
      line-height: 1.65;
      color: rgba(247, 250, 255, 0.6);
      max-width: 42ch;
      opacity: 0;
      animation: fade-up 0.7s ease forwards;
      animation-delay: 0.18s;
    }

    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 8px 28px 8px 8px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #fff;
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      box-shadow: 0 10px 36px rgba(139, 57, 255, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.18);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      opacity: 0;
      animation: fade-up 0.7s ease forwards;
      animation-delay: 0.3s;
    }

    .hero-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 44px rgba(139, 57, 255, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.22);
    }

    .hero-cta-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 9999px;
      background: linear-gradient(135deg, #9774FE, #7446FD);
      flex-shrink: 0;
    }

    .glass-card {
      position: relative;
      width: 100%;
      max-width: 380px;
      margin: 0 auto;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.045);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 40px 28px 32px;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      animation: float 6s ease-in-out infinite alternate;
    }

    .card-glow {
      position: absolute;
      left: 10%;
      right: 10%;
      bottom: -45%;
      height: 60%;
      background: radial-gradient(ellipse at center, rgba(139, 57, 255, 0.55), transparent 70%);
      filter: blur(30px);
      pointer-events: none;
    }

    .card-nodes {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .node-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .node-icon {
      width: 56px;
      height: 56px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.16);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 24px rgba(139, 57, 255, 0.45);
    }

    .node-label {
      font-family: 'Sora', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: rgba(247, 250, 255, 0.75);
    }

    .connector {
      flex: 1;
      height: 20px;
      min-width: 40px;
    }

    .connector-line {
      stroke: rgba(255, 255, 255, 0.14);
      stroke-width: 1.5;
    }

    .connector-flow {
      stroke: rgba(168, 114, 255, 0.7);
      stroke-width: 1.5;
      stroke-dasharray: 6 14;
      animation: dash-flow 2.5s linear infinite;
    }

    .card-caption {
      position: relative;
      z-index: 2;
      margin-top: 24px;
      font-family: 'Sora', sans-serif;
      font-size: 13px;
      line-height: 1.6;
      color: rgba(247, 250, 255, 0.5);
      text-align: center;
    }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes float {
      from { transform: translateY(0); }
      to { transform: translateY(-10px); }
    }

    @keyframes dash-flow {
      to { stroke-dashoffset: -40; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-title, .hero-subtitle, .hero-cta {
        opacity: 1;
        animation: none;
      }
      .glass-card, .connector-flow {
        animation: none;
      }
    }

    .marquee-section {
      position: relative;
      overflow: hidden;
      background: #0B0912;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 28px 0;
      mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee-scroll 26s linear infinite;
    }

    .marquee-group {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .marquee-item {
      font-family: 'Zalando Sans Expanded', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: rgba(247, 250, 255, 0.7);
      white-space: nowrap;
      padding: 0 20px;
    }

    .marquee-dot {
      width: 6px;
      height: 6px;
      border-radius: 9999px;
      background: #A872FF;
      flex-shrink: 0;
    }

    @keyframes marquee-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee-track {
        animation: none;
      }
    }

    .reality {
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, #0B0912 0%, #0D0B14 100%);
      padding: 120px 24px;
    }

    .reality-orb {
      position: absolute;
      top: 20%;
      left: 50%;
      transform: translateX(-50%);
      width: 30rem;
      height: 20rem;
      border-radius: 9999px;
      background: #5907DB;
      filter: blur(160px);
      opacity: 0.16;
      pointer-events: none;
    }

    .reality-inner {
      position: relative;
      z-index: 10;
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
    }

    .reality-title {
      font-family: 'Zalando Sans Expanded', sans-serif;
      font-weight: 800;
      font-size: clamp(28px, 4.2vw, 44px);
      line-height: 1.18;
      letter-spacing: -0.01em;
      color: #F7FAFF;
      max-width: 20ch;
      margin: 0 auto;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .reality-subtitle {
      font-family: 'Sora', sans-serif;
      font-size: 16px;
      line-height: 1.65;
      color: rgba(247, 250, 255, 0.6);
      max-width: 56ch;
      margin: 20px auto 0;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease 0.1s, transform 0.7s ease 0.1s;
    }

    .symptom-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      max-width: 640px;
      margin: 40px auto 0;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease 0.2s, transform 0.7s ease 0.2s;
    }

    .symptom {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-family: 'Sora', sans-serif;
      font-size: 14px;
      color: rgba(247, 250, 255, 0.8);
    }

    .symptom-dot {
      width: 6px;
      height: 6px;
      border-radius: 9999px;
      background: #A872FF;
      flex-shrink: 0;
    }

    .reveal-visible {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .reality-title, .reality-subtitle, .symptom-list {
        transition: none;
      }
    }
  </style>
</Layout>
