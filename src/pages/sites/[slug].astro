---
import { siteProjects } from '../../data/sitesPortfolio.js'

export function getStaticPaths() {
  return siteProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`Site ${project.name} — projeto da One Impact.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>One Impact | Site — {project.name}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      /* ── Header flutuante ── */
      .floating-header {
        position: fixed;
        top: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 9999px;
        background: rgba(247, 245, 253, 0.78);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.16);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .back-link {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        color: rgba(19, 15, 38, 0.7);
        transition: color 0.2s ease;
      }

      .back-link:hover {
        color: #7345FD;
      }

      /* ── Intro ── */
      .intro-section {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 48px;
        text-align: center;
      }

      .intro-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(115, 69, 253, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      .badge-dark {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.15);
        background: rgba(19, 15, 38, 0.05);
        color: rgba(19, 15, 38, 0.75);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 18px;
        position: relative;
        z-index: 1;
      }

      .intro-title {
        position: relative;
        z-index: 1;
        max-width: 640px;
        margin: 0 auto 18px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        letter-spacing: -0.5px;
        color: #130F26;
      }

      @media (min-width: 900px) {
        .intro-title {
          font-size: 46px;
          letter-spacing: -1px;
        }
      }

      .intro-desc {
        position: relative;
        z-index: 1;
        max-width: 560px;
        margin: 0 auto;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.7;
        color: #4F4F57;
      }

      .intro-chips {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
        margin-top: 18px;
      }

      .case-chip {
        display: inline-flex;
        padding: 5px 11px;
        border-radius: 9999px;
        background: rgba(19, 15, 38, 0.04);
        border: 1px solid rgba(19, 15, 38, 0.12);
        color: rgba(19, 15, 38, 0.7);
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        font-weight: 600;
      }

      /* ── Pranchas ── */
      .boards-section {
        padding: 24px 20px 72px;
      }

      .boards-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .board {
        width: 100%;
        display: block;
        border-radius: 18px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        box-shadow: 0 12px 30px rgba(19, 15, 38, 0.08);
      }

      /* ── CTA final ── */
      .cta-section {
        padding: 20px 20px 100px;
        text-align: center;
      }

      .cta-title {
        max-width: 520px;
        margin: 0 auto 14px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.25;
        color: #130F26;
      }

      .cta-desc {
        max-width: 460px;
        margin: 0 auto 30px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.7;
        color: #4F4F57;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 40px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .button {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="floating-header">
      <a class="brand" href="/" aria-label="One Impact — início">
        <strong>One Impact</strong>
      </a>
      <a class="back-link" href="/clientes-atendidos-sites">← Todos os projetos</a>
    </header>

    <section class="intro-section">
      <div class="intro-dots" aria-hidden="true"></div>
      <div data-reveal>
        <span class="badge-dark reveal-item">{project.tag}</span>
        <h1 class="intro-title reveal-item">{project.name}</h1>
        <p class="intro-desc reveal-item">{project.desc}</p>
        <div class="intro-chips reveal-item">
          {project.chips.map((chip) => <span class="case-chip">{chip}</span>)}
        </div>
      </div>
    </section>

    <section class="boards-section">
      <div class="boards-container">
        {project.slides.map((slide, i) => (
          <img
            class="board"
            src={slide}
            alt={`Tela ${i + 1} do site ${project.name}`}
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
      </div>
    </section>

    <section class="cta-section">
      <div data-reveal>
        <h2 class="cta-title reveal-item">Quer um site assim para a sua marca?</h2>
        <p class="cta-desc reveal-item">Este projeto foi pensado para aumentar a percepção de autoridade do cliente — não só a estética.</p>
        <a href="https://link.oneimpact.com.br/contato-whatsapp" class="button reveal-item" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.25 0.513 1.968 0.74l0.149 0.041c0.442 0.14 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.34-0.247-0.712-0.434z"/></svg>
          Falar no WhatsApp
        </a>
      </div>
    </section>

    <script>
      import Lenis from 'lenis'

      const revealGroups = document.querySelectorAll('[data-reveal]')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (reduceMotion) {
        revealGroups.forEach((group) => group.classList.add('is-visible'))
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
        )

        revealGroups.forEach((group) => revealObserver.observe(group))

        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
  </body>
</html>
