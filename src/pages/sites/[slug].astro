---
import { siteProjects } from '../../data/sitesPortfolio.js'

export function getStaticPaths() {
  return siteProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`Site ${project.name} — projeto da One Impact.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>One Impact | Site — {project.name}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      /* ── Header flutuante ── */
      .floating-header {
        position: fixed;
        top: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 9999px;
        background: rgba(247, 245, 253, 0.78);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.16);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .back-link {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        color: rgba(19, 15, 38, 0.7);
        transition: color 0.2s ease;
      }

      .back-link:hover {
        color: #7345FD;
      }

      /* ── Intro ── */
      .intro-section {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 48px;
        text-align: center;
      }

      .intro-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(115, 69, 253, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      .badge-dark {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.15);
        background: rgba(19, 15, 38, 0.05);
        color: rgba(19, 15, 38, 0.75);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 18px;
        position: relative;
        z-index: 1;
      }

      .intro-title {
        position: relative;
        z-index: 1;
        max-width: 640px;
        margin: 0 auto 18px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        letter-spacing: -0.5px;
        color: #130F26;
      }

      @media (min-width: 900px) {
        .intro-title {
          font-size: 46px;
          letter-spacing: -1px;
        }
      }

      .intro-desc {
        position: relative;
        z-index: 1;
        max-width: 560px;
        margin: 0 auto;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.7;
        color: #4F4F57;
      }

      .intro-chips {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
        margin-top: 18px;
      }

      .case-chip {
        display: inline-flex;
        padding: 5px 11px;
        border-radius: 9999px;
        background: rgba(19, 15, 38, 0.04);
        border: 1px solid rgba(19, 15, 38, 0.12);
        color: rgba(19, 15, 38, 0.7);
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        font-weight: 600;
      }

      /* ── Pranchas ── */
      .boards-section {
        padding: 24px 20px 72px;
      }

      .boards-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .board {
        width: 100%;
        display: block;
        border-radius: 18px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        box-shadow: 0 12px 30px rgba(19, 15, 38, 0.08);
      }

      /* ── CTA final ── */
      .cta-section {
        padding: 20px 20px 100px;
        text-align: center;
      }

      .cta-title {
        max-width: 520px;
        margin: 0 auto 14px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.25;
        color: #130F26;
      }

      .cta-desc {
        max-width: 460px;
        margin: 0 auto 30px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.7;
        color: #4F4F57;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 40px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .button {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="floating-header">
      <a class="brand" href="/" aria-label="One Impact — início">
        <strong>One Impact</strong>
      </a>
      <a class="back-link" href="/clientes-atendidos-sites">← Todos os projetos</a>
    </header>

    <section class="intro-section">
      <div class="intro-dots" aria-hidden="true"></div>
      <div data-reveal>
        <span class="badge-dark reveal-item">{project.tag}</span>
        <h1 class="intro-title reveal-item">{project.name}</h1>
        <p class="intro-desc reveal-item">{project.desc}</p>
        <div class="intro-chips reveal-item">
          {project.chips.map((chip) => <span class="case-chip">{chip}</span>)}
        </div>
      </div>
    </section>

    <section class="boards-section">
      <div class="boards-container">
        {project.slides.map((slide, i) => (
          <img
            class="board"
            src={slide}
            alt={`Tela ${i + 1} do site ${project.name}`}
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
      </div>
    </section>

    <section class="cta-section">
      <div data-reveal>
        <h2 class="cta-title reveal-item">Quer um site assim para a sua marca?</h2>
        <p class="cta-desc reveal-item">Este projeto foi pensado para aumentar a percepção de autoridade do cliente — não só a estética.</p>
        <a href="https://link.oneimpact.com.br/contato-agencia-one-impact" class="button reveal-item" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M16 3.2C8.27 3.2 2 8.44 2 14.9c0 3.63 1.98 6.87 5.08 9.01L5.6 29.6l6.35-3.3c1.3.25 2.66.38 4.05.38 7.73 0 14-5.24 14-11.7S23.73 3.2 16 3.2z"/></svg>
          Falar com a gente
        </a>
      </div>
    </section>

    <script>
      import Lenis from 'lenis'

      const revealGroups = document.querySelectorAll('[data-reveal]')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (reduceMotion) {
        revealGroups.forEach((group) => group.classList.add('is-visible'))
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
        )

        revealGroups.forEach((group) => revealObserver.observe(group))

        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
  </body>
</html>
