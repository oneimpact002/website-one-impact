---
import Rastreio from '../components/Rastreio.astro';
import AnimacaoRolagem from '../components/AnimacaoRolagem.astro'
import CupomChip from '../components/CupomChip.astro'
import CopiarCupom from '../components/CopiarCupom.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { FERRAMENTAS } from '../data/ferramentas.js'
import { AFILIADOS, linkAfiliado } from '../data/afiliados.js'

const url = 'https://agenciaoneimpact.com.br/ferramentas'
const titulo = 'Ferramentas que usamos e recomendamos | One Impact'
const descricao =
  'As ferramentas que a One Impact usa nos projetos da agência e recomenda para criar sites, com a nossa experiência de uso e links para quem quiser contratar.'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Ferramentas que usamos e recomendamos',
  description: descricao,
  url,
  inLanguage: 'pt-BR',
  publisher: { '@type': 'Organization', name: 'One Impact', url: 'https://agenciaoneimpact.com.br' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: FERRAMENTAS.map((f, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: f.nome,
      description: f.resumo,
    })),
  },
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://agenciaoneimpact.com.br' },
    { '@type': 'ListItem', position: 2, name: 'Ferramentas', item: url },
  ],
}

const ferramentas = FERRAMENTAS.map((f) => ({
  ...f,
  link: f.afiliado ? linkAfiliado(f.afiliado, f.id, 'ferramentas') : null,
  nomeAfiliado: f.afiliado ? AFILIADOS[f.afiliado].nome : null,
  cupom: f.afiliado ? AFILIADOS[f.afiliado].cupom : null,
}))
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      ul {
        list-style: none;
      }

      .container {
        max-width: 960px;
        margin: 0 auto;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 32px;
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 45% 55% at 85% 10%, rgba(115, 69, 253, 0.14), transparent 70%);
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(75, 47, 190, 0.25) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
        mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
      }

      .hero .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.35);
        background: rgba(115, 69, 253, 0.08);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      h1 {
        max-width: 700px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
        color: #130F26;
      }

      h1 .hl {
        color: #7345FD;
      }

      .hero-desc {
        max-width: 620px;
        font-size: 14.5px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      .back-button {
        font-size: 12.5px;
        font-weight: 500;
        text-decoration: none;
        color: rgba(19, 15, 38, 0.6);
        transition: color 0.2s ease;
      }

      .back-button:hover {
        color: #7345FD;
      }

      .tools-section {
        padding: 16px 20px 72px;
      }

      .tools-list {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      /* Card da ferramenta: faixa escura em cima, corpo claro embaixo */
      .tool-card {
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 14px 40px rgba(19, 15, 38, 0.08);
      }

      .tool-top {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 32px 26px 28px;
        background: linear-gradient(135deg, #130F26 0%, #2a1a66 60%, #4B2FBE 100%);
        color: #F7F5FD;
      }

      .tool-top::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(255, 255, 255, 0.14) 0.8px, transparent 0.8px);
        background-size: 14px 14px;
        -webkit-mask-image: radial-gradient(ellipse 60% 90% at 90% 0%, black, transparent 75%);
        mask-image: radial-gradient(ellipse 60% 90% at 90% 0%, black, transparent 75%);
      }

      .tool-top > * {
        position: relative;
        z-index: 1;
      }

      .tool-cat {
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #B9A4FF;
      }

      .tool-top h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 34px;
        line-height: 1.1;
        color: #FFFFFF;
      }

      .tool-resumo {
        max-width: 560px;
        font-size: 14.5px;
        line-height: 1.75;
        color: rgba(247, 245, 253, 0.85);
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 26px;
        border-radius: 9999px;
        background: #FFFFFF;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        color: #4B2FBE;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      /* No topo escuro o botão ficava esticado na largura toda do card */
      .tool-top > .cta-button {
        align-self: flex-start;
      }

      .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.32);
      }

      .cta-button.solid {
        background: #7345FD;
        color: #FFFFFF;
        box-shadow: 0 10px 28px rgba(115, 69, 253, 0.35);
      }

      .tool-body {
        display: flex;
        flex-direction: column;
        gap: 30px;
        padding: 28px 26px 30px;
      }

      .checks {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .checks li {
        position: relative;
        padding-left: 32px;
        font-size: 13.5px;
        line-height: 1.65;
        color: rgba(19, 15, 38, 0.78);
      }

      .checks li::before {
        content: '✓';
        position: absolute;
        top: 1px;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 9999px;
        background: rgba(115, 69, 253, 0.12);
        font-size: 12px;
        font-weight: 700;
        color: #7345FD;
      }

      /* Planos: o que a pessoa quer saber na hora de escolher */
      .plans {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
      }

      @media (min-width: 720px) {
        .plans {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .plan {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 16px 16px 14px;
        border-radius: 12px;
        border: 1px solid rgba(19, 15, 38, 0.1);
        background: #FFFFFF;
      }

      .plan.is-best {
        border: 2px solid #7345FD;
        background: rgba(115, 69, 253, 0.05);
      }

      .plan-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .plan-head strong {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 15px;
        color: #130F26;
      }

      .plan-head em {
        padding: 3px 9px;
        border-radius: 9999px;
        background: #7345FD;
        font-size: 10px;
        font-style: normal;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #FFFFFF;
      }

      .plan p {
        font-size: 13px;
        line-height: 1.65;
        color: rgba(19, 15, 38, 0.72);
      }

      .plan-price {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-top: auto;
      }

      .plan-price b {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 20px;
        color: #4B2FBE;
      }

      .plan-price span {
        font-size: 12px;
        color: rgba(19, 15, 38, 0.55);
      }

      .plans-note {
        margin-top: 12px;
        font-size: 11.5px;
        line-height: 1.6;
        color: rgba(19, 15, 38, 0.55);
      }

      .text-link {
        display: inline-block;
        margin-top: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #4B2FBE;
        text-decoration: none;
      }

      .text-link:hover {
        text-decoration: underline;
      }

      /* Vídeos e guias */
      .sub-title {
        margin-bottom: 14px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 15px;
        color: #130F26;
      }

      .videos {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }

      @media (min-width: 720px) {
        .videos {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .video-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .video-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 34px rgba(115, 69, 253, 0.16);
      }

      .video-thumb {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #130F26;
      }

      .video-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .video-play {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        transform: translate(-50%, -50%);
        border-radius: 9999px;
        background: rgba(115, 69, 253, 0.95);
        color: #FFFFFF;
        box-shadow: 0 8px 22px rgba(115, 69, 253, 0.5);
      }

      .video-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 14px 16px 16px;
      }

      .video-info strong {
        font-size: 13.5px;
        line-height: 1.5;
        color: #130F26;
      }

      .tool-final {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding-top: 4px;
      }

      .tool-foot {
        font-size: 11.5px;
        line-height: 1.6;
        color: rgba(19, 15, 38, 0.55);
      }

      .more-note {
        margin-top: 24px;
        font-size: 13px;
        line-height: 1.7;
        color: rgba(19, 15, 38, 0.6);
      }

      .more-note a {
        color: #4B2FBE;
        font-weight: 600;
      }
    </style>
    <AnimacaoRolagem />
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container" data-reveal-scroll data-reveal-filhos>
        <a class="back-button" href="/blog" data-track="ferramentas-voltar-blog" data-track-label="Voltar ao blog">← Voltar ao blog</a>
        <span class="badge">Ferramentas</span>
        <h1>Ferramentas que usamos e <span class="hl">recomendamos</span></h1>
        <p class="hero-desc">
          Só entra aqui o que usamos nos projetos da agência e que indicaríamos para um cliente.
        </p>
      </div>
    </section>

    <section class="tools-section">
      <div class="container" data-reveal-scroll data-reveal-filhos>
        <div class="tools-list">
          {ferramentas.map((f) => (
            <article class="tool-card" id={f.id}>
              <div class="tool-top">
                <span class="tool-cat">{f.categoria}</span>
                <h2>{f.nome}</h2>
                <p class="tool-resumo">{f.resumo}</p>
                {f.link && (
                  <a class="cta-button" href={f.link} target="_blank" rel="sponsored noopener" data-track={`ferramenta-${f.id}`} data-track-label={`${f.botao} (topo da página de ferramentas)`}>
                    {f.botao} <span aria-hidden="true">→</span>
                  </a>
                )}
                {f.cupom && f.link && <CupomChip cupom={f.cupom} rastreio={`ferramentas-${f.id}`} />}
              </div>

              <div class="tool-body">
                <div>
                  <h3 class="sub-title">Qual plano escolher</h3>
                  <ul class="plans">
                    {f.planos.map((p) => (
                      <li class:list={['plan', { 'is-best': p.destaque }]}>
                        <div class="plan-head">
                          <strong>{p.nome}</strong>
                          {p.destaque && <em>{p.destaque}</em>}
                        </div>
                        <p>{p.texto}</p>
                        <div class="plan-price"><b>{p.preco}</b><span>por mês</span></div>
                      </li>
                    ))}
                  </ul>
                  <p class="plans-note">Preço por mês no contrato de 24 meses, conferido em {f.precosConferidosEm}. Pode mudar, vale conferir na página da {f.nomeAfiliado}.</p>
                  {f.guia && <a class="text-link" href={f.guia.href}>{f.guia.titulo} →</a>}
                </div>

                <ul class="checks">{f.porQueRecomendamos.map((item) => <li>{item}</li>)}</ul>

                {f.videos.length > 0 && (
                  <div>
                    <h3 class="sub-title">Assista antes de decidir</h3>
                    <div class="videos">
                      {f.videos.map((v) => (
                        <a class="video-card" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener" data-track={`ferramenta-video-${f.id}`} data-track-label={v.titulo}>
                          <div class="video-thumb">
                            <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt={`Capa do vídeo: ${v.titulo}`} loading="lazy" width="480" height="360" />
                            <span class="video-play" aria-hidden="true">
                              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                            </span>
                          </div>
                          <div class="video-info">
                            <strong>{v.titulo}</strong>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {f.link && (
                  <div class="tool-final">
                    {f.cupom && <CupomChip cupom={f.cupom} rastreio={`ferramentas-${f.id}-fim`} variante="claro" />}
                    <a class="cta-button solid" href={f.link} target="_blank" rel="sponsored noopener" data-track={`ferramenta-${f.id}-fim`} data-track-label={`${f.botao} (fim do card)`}>
                      {f.botao} <span aria-hidden="true">→</span>
                    </a>
                    <p class="tool-foot">Contratando pelo nosso link, você apoia o nosso canal e ajuda a gente a continuar produzindo conteúdo gratuito.</p>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>

        <p class="more-note">
          Vamos incluir novas ferramentas aqui conforme a gente for avaliando e testando. Se quiser ver uma avaliação específica, conta nos comentários dos vídeos do <a href="https://www.youtube.com/@karolchristie" target="_blank" rel="noopener" data-track="ferramentas-youtube">canal no YouTube</a>.
        </p>
      </div>
    </section>

    <Footer />
    <CopiarCupom />
    <Rastreio />
  </body>
</html>
