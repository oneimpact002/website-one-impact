        font-weight: 700;
        color: #FFFFFF;
        opacity: 0;
        transition: opacity 0.4s ease 0.7s;
      }

      .is-visible .stat-col-value {
        opacity: 1;
      }

      .stat-col-label {
        min-height: 42px;
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        line-height: 1.4;
        text-align: center;
