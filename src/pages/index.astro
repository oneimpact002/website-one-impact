      /* Seção 3 — visual da hero antiga (fundo claro, glow, órbitas e malha) */
      .cta-section {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 88px 20px 72px;
        background: #F7F5FD;
      }

      .cta-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 62% 46% at 50% 28%, rgba(115, 69, 253, 0.13), transparent 70%),
          radial-gradient(ellipse 42% 34% at 12% 88%, rgba(151, 116, 254, 0.10), transparent 72%),
          radial-gradient(ellipse 42% 34% at 88% 86%, rgba(151, 116, 254, 0.10), transparent 72%);
      }

      .orbit-layer {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        animation: orbit-spin 46s linear infinite;
      }

      .orbit-layer-inner {
        inset: 17%;
        animation-duration: 30s;
        animation-direction: reverse;
      }

      .orbit-layer::before {
        content: '';
        position: absolute;
        top: -4px;
        left: 50%;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7345FD;
        box-shadow: 0 0 12px rgba(115, 69, 253, 0.65);
