      .whatsapp-bar-text {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        color: #FFFFFF;
      }

      .whatsapp-bar-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 11px 20px;
        border: 1px solid #9774FE;
        border-radius: 9999px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(115, 69, 253, 0.4);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease;
      }

      .whatsapp-bar-btn:hover {
        transform: translateY(-2px);
      }

      @media (min-width: 900px) {
        .whatsapp-bar {
          left: auto;
          right: 24px;
          bottom: 24px;
          min-width: 0;
          transform: translateY(16px);
        }

        .whatsapp-bar.is-shown {
          transform: translateY(0);
        }
      }

      /* Seção de serviços — bento com card destaque */
      .services-section {
        position: relative;
        overflow: hidden;
        padding: 88px 20px;
        background: #130F26;
      }

      .services-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 40%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 40%, black, transparent 85%);
      }

      .services-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .services-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .bento-grid {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .bento-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 28px 24px;
        text-align: left;
        border-radius: 5px;
        border: 1px solid rgba(151, 116, 254, 0.28);
        background: linear-gradient(145deg, #232035, #16112B);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      }

      /* Textura de bolinhas em todos os cards */
      .bento-card::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.3) 1px, transparent 1px);
        background-size: 14px 14px;
        -webkit-mask-image: radial-gradient(ellipse 90% 80% at 85% 10%, black, transparent 70%);
        mask-image: radial-gradient(ellipse 90% 80% at 85% 10%, black, transparent 70%);
      }

      .bento-card:hover {
        transform: translateY(-6px);
        border-color: rgba(151, 116, 254, 0.5);
        box-shadow: 0 20px 44px rgba(115, 69, 253, 0.22);
      }

      /* Card destaque — roxo sólido */
      .bento-main {
        position: relative;
        overflow: hidden;
        border-color: rgba(255, 255, 255, 0.25);
        background: linear-gradient(160deg, #7345FD, #4B2FBE);
        box-shadow: 0 20px 50px rgba(115, 69, 253, 0.35);
      }

      .bento-main::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(255, 255, 255, 0.28) 1px, transparent 1px);
        background-size: 14px 14px;
        -webkit-mask-image: radial-gradient(ellipse 90% 80% at 85% 10%, black, transparent 70%);
        mask-image: radial-gradient(ellipse 90% 80% at 85% 10%, black, transparent 70%);
      }

      .bento-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 5px;
        border: 1px solid rgba(151, 116, 254, 0.32);
        background: rgba(115, 69, 253, 0.14);
        color: #9774FE;
      }

      .bento-main .bento-icon {
        border-color: rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.14);
        color: #FFFFFF;
      }

      .bento-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .bento-main h3 {
        font-size: 21px;
      }

      .bento-card p {
        margin: 0;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.7);
      }

      .bento-main p {
        color: rgba(255, 255, 255, 0.85);
      }

      .bento-features {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 4px 0 0;
        padding: 0;
        list-style: none;
      }

      .bento-features li {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.9);
      }

      .bento-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        font-size: 9px;
        font-weight: 700;
        color: #FFFFFF;
      }

      /* Chips de subitens — serviços dentro de cada card */
      .bento-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 4px 0 0;
      }

      .bento-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(151, 116, 254, 0.35);
        background: rgba(115, 69, 253, 0.12);
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        color: rgba(255, 255, 255, 0.88);
      }

      .bento-main .bento-chip {
        border-color: rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.14);
        color: #FFFFFF;
      }

      .bento-note {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 2px 0 0;
        font-family: 'Sora', sans-serif;
        font-size: 11.5px;
        font-style: italic;
        color: rgba(255, 255, 255, 0.5);
      }

      .bento-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: auto;
        padding-top: 10px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        color: #9774FE;
        transition: gap 0.2s ease, color 0.2s ease;
      }

      .bento-link:hover {
        gap: 10px;
        color: #C9BBFF;
      }

      .bento-main .bento-link {
        color: #FFFFFF;
      }

      .bento-main .bento-link:hover {
        color: #E9E1FF;
      }

      @media (min-width: 900px) {
        .bento-grid {
          display: grid;
          grid-template-columns: 1.25fr 1fr;
          grid-template-rows: 1fr 1fr;
          gap: 20px;
        }

        .bento-main {
          grid-row: span 2;
          padding: 40px 36px;
        }
      }

      /* Seção 4 — cases da One Impact (mesmo padrão da pagina-v2) */
      .cases-section {
        padding: 88px 20px;
        background: #130F26;
      }

      .cases-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .cases-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      /* Scroll-stacking — cada case empilha por cima do anterior (ref: Card Stacking, animacoes e efeitos.md) */
      .cases-stack {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 28px;
        margin-bottom: 40px;
      }

      .stack-card {
        position: relative;
        position: sticky;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        text-align: left;
        border: 1px solid rgba(151, 116, 254, 0.28);
        border-radius: 5px;
        background: linear-gradient(145deg, #232035, #16112B);
        box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.5), 0 0 40px rgba(115, 69, 253, 0.12);
      }

      /* Linha gradiente no topo do card */
      .stack-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        z-index: 1;
        background: linear-gradient(90deg, #4B2FBE, #9774FE, #D9CCFF, #9774FE, #4B2FBE);
      }

      /* Moldura de navegador na imagem */
      .stack-card-media {
        display: flex;
        flex-direction: column;
        background: #232035;
      }

      .stack-card-browserbar {
        display: flex;
        align-items: center;
        gap: 5px;
        height: 26px;
        flex-shrink: 0;
        padding: 0 12px;
        background: rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .stack-card-browserbar span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(151, 116, 254, 0.45);
      }

      .stack-card-media .case-card-image {
        flex: 1;
      }

      .stack-card:nth-child(1) { top: 84px; }
      .stack-card:nth-child(2) { top: 100px; }
      .stack-card:nth-child(3) { top: 116px; }

      .case-card-image {
        width: 100%;
        aspect-ratio: 1376 / 700;
        background: linear-gradient(160deg, #4B2FBE, #7345FD 55%, #9774FE);
      }

      .case-card-image-casa3 {
        background: #F5F0EC url('/case-casa3-arquitetura.webp') center top / cover no-repeat;
      }

      .case-card-image-fogaca {
        background: #1B2232 url('/case-jorge-fogaca.webp') center top / cover no-repeat;
      }

      .case-card-image-katiuscia {
        background: #E9ECE7 url('/case-katiuscia-souza.webp') center top / cover no-repeat;
      }

      .case-card-body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 22px;
      }

      .case-card-tag {
        display: inline-flex;
        padding: 3px 8px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.32);
        background: rgba(115, 69, 253, 0.14);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9774FE;
      }

      .stack-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .stack-card p {
        margin: 0;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.7);
      }

      .case-card-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: auto;
        padding-top: 8px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        color: #9774FE;
        transition: gap 0.2s ease, color 0.2s ease;
      }

      .case-card-link:hover {
        gap: 10px;
        color: #C9BBFF;
      }

      .cases-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.5);
        background: transparent;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }

      .cases-more-btn:hover {
        background: rgba(115, 69, 253, 0.14);
        transform: translateY(-2px);
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.25);
      }

      /* Desktop: imagem e texto lado a lado dentro do card empilhado */
      @media (min-width: 900px) {
        .stack-card {
          display: grid;
          grid-template-columns: 1.2fr 1fr;
          align-items: stretch;
        }

        .stack-card-media {
          height: 100%;
        }

        .stack-card .case-card-image {
          height: 100%;
          aspect-ratio: auto;
          min-height: 380px;
        }

        .stack-card .case-card-body {
          justify-content: center;
          padding: 48px;
          gap: 14px;
        }

        .stack-card .case-card h3,
        .stack-card h3 {
          font-size: 24px;
        }
      }

      /* Seção fit — pra quem é / não é o serviço */
      .fit-section {
        position: relative;
        overflow: hidden;
        padding: 88px 20px;
        background: #F7F5FD;
      }

      .fit-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .fit-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.25;
        color: #130F26;
      }

      .fit-grid {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .fit-card {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 28px 24px;
        text-align: left;
        border-radius: 5px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 12px 30px rgba(19, 15, 38, 0.08);
      }

      .fit-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 16px;
        font-weight: 700;
        color: #130F26;
      }

      .fit-yes h3 {
        color: #4B2FBE;
      }

      .fit-card ul {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .fit-card li {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 300;
        line-height: 1.6;
        color: rgba(19, 15, 38, 0.75);
      }

      .fit-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        margin-top: 1px;
        border-radius: 50%;
        font-size: 11px;
        font-weight: 700;
      }

      .fit-yes .fit-mark {
        border: 1px solid rgba(115, 69, 253, 0.35);
        background: rgba(115, 69, 253, 0.1);
        color: #7345FD;
      }

      .fit-no .fit-mark {
        border: 1px solid rgba(19, 15, 38, 0.15);
        background: rgba(19, 15, 38, 0.04);
        color: rgba(19, 15, 38, 0.4);
      }

      .fit-no {
        background: #FBFAFE;
        border-color: rgba(19, 15, 38, 0.06);
        box-shadow: none;
      }

      .fit-no li {
        color: rgba(19, 15, 38, 0.55);
      }

      .fit-cta-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        margin-top: 40px;
      }

      .fit-cta-box::before {
        content: '';
        width: 160px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #7345FD, transparent);
      }

      .fit-cta-text {
        max-width: 560px;
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 26px;
        font-weight: 600;
        line-height: 1.35;
        text-align: center;
        color: #130F26;
      }

      .fit-section .badge {
        border-color: rgba(19, 15, 38, 0.15);
        background: rgba(19, 15, 38, 0.05);
        color: rgba(19, 15, 38, 0.75);
      }

      @media (min-width: 900px) {
        .fit-container h2 {
          font-size: 32px;
          max-width: 560px;
        }

        .fit-grid {
          flex-direction: row;
        }

        .fit-card {
          flex: 1;
          padding: 32px;
        }
      }

      /* Seção depoimentos — carrossel (padrão Neurolândia, visual One Impact) */
      .depo-section {
        position: relative;
        overflow: hidden;
        padding: 88px 0;
        background: #130F26;
      }

      .depo-head {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .depo-head .badge {
        margin-bottom: 15px;
      }

      .depo-head h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .depo-carousel {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 20px;
      }

      .depo-track {
        display: flex;
        gap: 16px;
        align-items: stretch;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding: 4px 2px 8px;
      }

      .depo-track::-webkit-scrollbar {
        display: none;
      }

      .depo-card {
        position: relative;
        flex: 0 0 100%;
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        padding: 26px 22px;
        text-align: left;
        border: 1px solid rgba(151, 116, 254, 0.28);
        border-radius: 5px;
        background: linear-gradient(145deg, #232035, #16112B);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease, border-color 0.3s ease;
      }

      .depo-card:hover {
        transform: translateY(-4px);
        border-color: rgba(151, 116, 254, 0.5);
      }

      @media (min-width: 900px) {
        .depo-track {
          gap: 20px;
        }

        .depo-card {
          flex: 0 0 calc((100% - 40px) / 3);
        }
      }

      .depo-quote-icon {
        position: absolute;
        top: 22px;
        right: 22px;
        opacity: 0.3;
      }

      .depo-stars {
        color: #9774FE;
        font-size: 14px;
        letter-spacing: 3px;
        margin-bottom: 14px;
      }

      .depo-quote {
        margin: 0 0 12px;
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.82);
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
        overflow: hidden;
        transition: max-height 0.45s ease;
      }

      .depo-quote.expanded {
        -webkit-line-clamp: unset;
      }

      .depo-more {
        align-self: flex-start;
        background: none;
        border: none;
        padding: 0;
        margin: 0 0 20px;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #9774FE;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .depo-more:hover {
        color: #C9BBFF;
      }

      .depo-person {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: auto;
      }

      .depo-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.4);
        background: rgba(115, 69, 253, 0.18);
        color: #9774FE;
        overflow: hidden;
      }

      .depo-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
      }

      .depo-name {
        margin: 0;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #FFFFFF;
      }

      .depo-role {
        margin: 2px 0 0;
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.55);
      }

      .depo-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        margin-top: 22px;
      }

      .depo-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid rgba(115, 69, 253, 0.5);
        background: transparent;
        color: #FFFFFF;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .depo-nav:hover {
        background: rgba(115, 69, 253, 0.14);
        transform: translateY(-2px);
      }

      .depo-dots {
        display: flex;
        gap: 8px;
      }

      .depo-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(151, 116, 254, 0.25);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .depo-dot.active {
        background: #9774FE;
        transform: scale(1.3);
      }

      /* Seção equipe — as sócias */
      .team-section {
        position: relative;
        overflow: hidden;
        padding: 88px 20px;
        background: #130F26;
      }

      .team-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .team-container .badge {
        margin-bottom: 15px;
      }

      .team-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .team-grid {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .team-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        border-radius: 5px;
        border: 1px solid rgba(151, 116, 254, 0.28);
        background: linear-gradient(145deg, #232035, #16112B);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      .team-card:hover {
        transform: translateY(-6px);
        border-color: rgba(151, 116, 254, 0.5);
        box-shadow: 0 20px 44px rgba(115, 69, 253, 0.22);
      }

      .team-card-photo {
        width: 100%;
        aspect-ratio: 4 / 5;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
          radial-gradient(ellipse 70% 60% at 50% 30%, rgba(151, 116, 254, 0.3), transparent 70%),
          linear-gradient(160deg, #2A2344, #16112B);
        border-bottom: 1px solid rgba(151, 116, 254, 0.2);
      }

      .team-card-photo svg {
        color: rgba(151, 116, 254, 0.45);
      }

      .team-card-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
      }

      .team-card-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 20px;
      }

      .team-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .team-card-role {
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9774FE;
      }

      .team-card p {
        margin: 6px 0 0;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.7);
      }

      /* Descrição recolhida em 3 linhas até clicar em ler mais */
      .team-card p.is-clamped {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* Durante a animação de abrir/fechar, anima a altura */
      .team-card p.is-animating {
        display: block;
        overflow: hidden;
        transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .team-readmore {
        margin-top: 6px;
        padding: 0;
        border: none;
        background: none;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #9774FE;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .team-readmore:hover {
        color: #C9BBFF;
      }

      @media (min-width: 900px) {
        .team-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(280px, 340px));
          justify-content: center;
          gap: 20px;
        }
      }

      /* Seção FAQ — acordeão */
      .faq-section {
        position: relative;
        overflow: hidden;
        padding: 88px 20px;
        background: #0D0A1A;
      }

      .faq-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .faq-container h2 {
        margin: 0 0 32px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .faq-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
      }

      .faq-item {
        border-radius: 5px;
        border: 1px solid rgba(151, 116, 254, 0.2);
        background: #130F26;
        text-align: left;
        overflow: hidden;
      }

      .faq-heading {
        margin: 0;
        font-size: inherit;
        font-weight: inherit;
      }

      .faq-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        width: 100%;
        padding: 18px 20px;
        border: none;
        background: none;
        cursor: pointer;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-align: left;
        color: #FFFFFF;
      }

      .faq-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.4);
        color: #9774FE;
        transition: transform 0.3s ease, background 0.3s ease;
      }

      .faq-item.is-open .faq-icon {
        transform: rotate(45deg);
        background: rgba(115, 69, 253, 0.18);
      }

      .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease;
      }

      .faq-answer p {
        margin: 0;
        padding: 0 20px 20px;
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.72);
      }

      @media (min-width: 900px) {
        .faq-container h2 {
          font-size: 32px;
        }

        .faq-question {
          padding: 22px 26px;
          font-size: 15px;
        }

        .faq-answer p {
          padding: 0 26px 22px;
        }
      }

      /* Seção final — CTA escuro com círculos e orbs (visual da hero antiga) */
      .final-section {
        position: relative;
        overflow: hidden;
        min-height: 90vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 88px 20px;
        background: #130F26;
      }

      .final-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 45% at 50% 50%, rgba(115, 69, 253, 0.2), transparent 70%);
      }

      .final-circles {
        position: absolute;
        z-index: 0;
        top: 50%;
        left: 50%;
        width: min(640px, 88vw);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.28);
        pointer-events: none;
      }

      .final-circles::before {
        content: '';
        position: absolute;
        inset: 17%;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.36);
      }

      .final-circles::after {
        content: '';
        position: absolute;
        inset: -22%;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.18);
      }

      .final-section > .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      /* Rodapé corporativo */
      .footer {
        background: #0D0A1A;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        padding: 56px 20px 0;
        font-family: 'Sora', sans-serif;
      }

      .footer-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .footer-col h4 {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-logo {
        height: 34px;
        width: auto;
        display: block;
      }

      .footer-brand p {
        margin: 10px 0 0;
        max-width: 280px;
        font-size: 12px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.6);
      }

      .footer-col ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-col a {
        font-size: 13px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        transition: color 0.2s ease;
      }

      .footer-col a:hover {
        color: #9774FE;
      }

      .footer-social {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .footer-social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.3);
        background: rgba(115, 69, 253, 0.1);
        color: rgba(255, 255, 255, 0.75);
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }

      .footer-social-icon:hover {
        color: #FFFFFF;
        border-color: rgba(151, 116, 254, 0.55);
        background: rgba(115, 69, 253, 0.2);
      }

      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .footer-bottom span {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      @media (min-width: 900px) {
        .footer-grid {
          display: grid;
          grid-template-columns: 2fr 1fr 1fr;
          gap: 40px;
        }
      }

      @media (max-width: 899px) {
        .footer-grid {
          display: flex;
          flex-direction: column;
          gap: 32px;
        }
      }

      /* Bolinhas de vidro com ícone — flutuando ao lado do celular */
      .hero-orbs {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }

      .glass-orb {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05) 60%);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
        color: #9774FE;
        animation: orb-float 3s ease-in-out infinite alternate;
      }

      .glass-orb-1 { top: 62%; left: 19%; animation-delay: -1s; }
      .glass-orb-2 { top: 52%; right: 16%; animation-delay: -3s; }

      @keyframes orb-float {
        from { transform: translateY(0); }
        to { transform: translateY(-12px); }
      }

      @media (max-width: 899px) {
        .glass-orb {
          width: 48px;
          height: 48px;
        }

        .glass-orb svg {
          width: 20px;
          height: 20px;
        }

        .glass-orb-1 { top: 58%; left: 20px; }
        .glass-orb-2 { top: 68%; right: 20px; }
      }

      /* Box de gráfico — vendas com área e ponto destacado */
      .glass-chart {
        position: absolute;
        display: flex;
        flex-direction: column;
        gap: 2px;
        width: 185px;
        padding: 11px 12px;
        border-radius: 5px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        font-family: 'Sora', sans-serif;
        color: #FFFFFF;
        text-align: left;
        animation: orb-float 3.5s ease-in-out infinite alternate;
        animation-delay: -2s;
        top: 30%;
        left: 8%;
      }

      .glass-chart-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.7);
      }

      .glass-chart-value {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 5px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.1;
      }

      .glass-chart-arrow {
        font-size: 14px;
        font-weight: 700;
        color: #9774FE;
      }

      .glass-chart svg {
        width: 100%;
        height: auto;
        display: block;
      }

      @media (max-width: 899px) {
        .glass-chart {
          width: 130px;
          padding: 10px 10px;
          top: 76%;
          left: 12px;
        }

        .glass-chart-value {
          font-size: 13px;
        }
      }

      /* Box de novos contatos — glass com ícone */
      .glass-contacts {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 16px 12px 12px;
        border-radius: 5px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        font-family: 'Sora', sans-serif;
        color: #FFFFFF;
        text-align: left;
        animation: orb-float 4s ease-in-out infinite alternate;
        animation-delay: -1.5s;
        top: 68%;
        right: 10%;
      }

      .glass-contacts-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.45);
        background: rgba(115, 69, 253, 0.22);
        color: #9774FE;
      }

      .glass-contacts-info {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .glass-contacts-value {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.1;
      }

      .glass-contacts-label {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.7);
      }

      @media (max-width: 899px) {
        .glass-contacts {
          display: none;
        }
      }

      /* Cursor Spotlight — revela a malha de pontos ao redor do mouse (ref: animacoes e efeitos.md) */
      .cursor-spotlight {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.65) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
        mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
      }

      /* Sem spotlight no mobile / telas de toque */
      @media (max-width: 899px), (hover: none) {
        .cursor-spotlight {
          display: none;
        }
      }

      @media (min-width: 900px) {
        .title {
          font-size: 38px;
          letter-spacing: -1px;
        }

        .hero {
          padding-top: 96px;
          justify-content: center;
          text-align: left;
        }

        /* Conteúdo à esquerda, dentro da área central de 1140px */
        .hero > .container {
          width: min(100% - 40px, 1140px);
          align-items: flex-start;
        }

        /* Título em 2 linhas, área de conteúdo reduzida */
        .hero .title {
          max-width: 500px;
        }

        /* Seção dados — badge e título à esquerda */
        .dados-container {
          align-items: flex-start;
          text-align: left;
        }

        /* Balões flutuantes do lado oposto ao conteúdo */
        .glass-chart {
          left: auto;
          right: 33%;
          top: 29%;
        }

        .glass-orb-1 {
          left: auto;
          right: 35%;
          top: 60%;
        }

        .glass-orb-2 {
          right: 22%;
          top: 35%;
        }

        /* Em telas largas usa a arte horizontal própria de desktop */
        .hero-bg {
          background: #0D0A1A url('/hero-desktop-1.webp') center / cover no-repeat;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-ready [data-reveal] .reveal-item {
          opacity: 1;
          transform: none;
          transition: none;
        }

        .button,
        .stat-hero-value,
        .orbit-layer,
        .solve-chip,
        .hero-dots::before,
        .hero-dots::after {
          animation: none;
        }

        .marquee-track {
          animation-play-state: paused;
        }
      }
    </style>
  </head>
