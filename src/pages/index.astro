              <a href="mailto:contato@agenciaoneimpact.com.br" class="footer-social-icon" aria-label="E-mail">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© 2026 One Impact — Todos os direitos reservados.</span>
          <span>agenciaoneimpact.com.br</span>
        </div>
      </div>
    </footer>

    <script>
      import Lenis from 'lenis'

      // Scroll suave (mesma config da pagina-v2)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }

      const revealGroups = document.querySelectorAll('[data-reveal]')
      requestAnimationFrame(() => {
        revealGroups.forEach((group) => group.classList.add('is-visible'))
      })

      // Reveal reversível por scroll — anima ao entrar, desfaz ao sair
      // threshold baixo: seções altas (ex: equipe) nunca chegam a 30% visíveis no mobile
      const scrollGroups = document.querySelectorAll('[data-reveal-scroll]')
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting)
          })
        },
        { threshold: 0.1 },
      )
      scrollGroups.forEach((group) => observer.observe(group))

      // Menu flutuante — aparece depois que a seção de dados termina de passar
      const floatingHeader = document.getElementById('floating-header')
      const dadosSection = document.getElementById('dados')

      const whatsappBar = document.getElementById('whatsapp-bar')

      if (floatingHeader && dadosSection) {
        const updateHeader = () => {
          const rect = dadosSection.getBoundingClientRect()
          const shown = rect.bottom <= window.innerHeight
          floatingHeader.classList.toggle('is-shown', shown)
          whatsappBar?.classList.toggle('is-shown', shown)
        }
        window.addEventListener('scroll', updateHeader, { passive: true })
        window.addEventListener('resize', updateHeader, { passive: true })
        updateHeader()
      }

      // Scrollspy — destaca no menu a seção visível
      const menuLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desktop-menu a[href^="#"]'))
      const spyTargets = menuLinks
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter((section): section is HTMLElement => Boolean(section))

      if (menuLinks.length && spyTargets.length) {
        const updateSpy = () => {
          let current = ''
          spyTargets.forEach((section) => {
            if (section.getBoundingClientRect().top <= window.innerHeight * 0.4) {
              current = `#${section.id}`
            }
          })
          menuLinks.forEach((link) => {
            link.classList.toggle('is-active', link.hash === current)
          })
        }
        window.addEventListener('scroll', updateSpy, { passive: true })
        updateSpy()
      }

      // Menu mobile — abre/fecha
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')

      const menuBackdrop = document.getElementById('menu-backdrop')

      if (mobileMenuToggle && mobileMenu) {
        const setMobileMenu = (open: boolean) => {
          mobileMenuToggle.setAttribute('aria-expanded', String(open))
          mobileMenuToggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu')
          mobileMenu.classList.toggle('is-open', open)
          mobileMenu.setAttribute('aria-hidden', String(!open))
          mobileMenu.toggleAttribute('inert', !open)
          menuBackdrop?.classList.toggle('is-open', open)
          document.body.style.overflow = open ? 'hidden' : ''
        }

        menuBackdrop?.addEventListener('click', () => setMobileMenu(false))

        mobileMenuToggle.addEventListener('click', () => {
          setMobileMenu(mobileMenuToggle.getAttribute('aria-expanded') !== 'true')
        })

        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMobileMenu(false))
        })

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMobileMenu(false)
        })
      }

      // Carrosséis de depoimentos — setas + bolinhas (padrão Neurolândia), um por seção
      document.querySelectorAll<HTMLElement>('.depo-carousel').forEach((carousel) => {
        const depoTrack = carousel.querySelector<HTMLElement>('.depo-track')
        const depoDots = carousel.querySelector<HTMLElement>('.depo-dots')
        const depoPrev = carousel.querySelector<HTMLButtonElement>('.depo-nav-prev')
        const depoNext = carousel.querySelector<HTMLButtonElement>('.depo-nav-next')
        if (!depoTrack || !depoDots || !depoPrev || !depoNext) return

        const depoPages = () => Math.round((depoTrack.scrollWidth - depoTrack.clientWidth) / depoTrack.clientWidth) + 1
        const depoIndex = () => Math.min(Math.round(depoTrack.scrollLeft / depoTrack.clientWidth), depoDots.children.length - 1)

        const depoUpdate = () => {
          const i = depoIndex()
          Array.from(depoDots.children).forEach((d, j) => d.classList.toggle('active', j === i))
        }

        const depoBuild = () => {
          depoDots.innerHTML = ''
          for (let i = 0; i < depoPages(); i++) {
            const dot = document.createElement('button')
            dot.className = 'depo-dot'
            dot.setAttribute('aria-label', `Ir para depoimentos ${i + 1}`)
            dot.addEventListener('click', () => depoTrack.scrollTo({ left: i * depoTrack.clientWidth, behavior: 'smooth' }))
            depoDots.appendChild(dot)
          }
          depoUpdate()
        }

        const depoStep = () => {
          const a = depoTrack.children[0] as HTMLElement | undefined
          const b = depoTrack.children[1] as HTMLElement | undefined
          if (!a) return depoTrack.clientWidth
          return b ? b.getBoundingClientRect().left - a.getBoundingClientRect().left : a.getBoundingClientRect().width
        }

        depoPrev.addEventListener('click', () => depoTrack.scrollBy({ left: -depoStep(), behavior: 'smooth' }))
        depoNext.addEventListener('click', () => depoTrack.scrollBy({ left: depoStep(), behavior: 'smooth' }))
        depoTrack.addEventListener('scroll', depoUpdate, { passive: true })
        window.addEventListener('resize', depoBuild)
        depoBuild()
      })

      // Depoimentos — Leia mais (só aparece quando o texto está cortado)
      document.querySelectorAll<HTMLButtonElement>('.depo-more').forEach((btn) => {
        const quote = btn.previousElementSibling as HTMLElement | null
        if (!quote) return

        const check = () => {
          const clipped = quote.scrollHeight > quote.clientHeight + 2
          btn.style.display = clipped || quote.classList.contains('expanded') ? '' : 'none'
        }

        let collapsedH = 0

        btn.addEventListener('click', () => {
          const isExpanded = quote.classList.contains('expanded')

          if (!isExpanded) {
            collapsedH = quote.clientHeight
            quote.classList.add('expanded')
            const fullH = quote.scrollHeight
            quote.style.maxHeight = collapsedH + 'px'
            void quote.offsetHeight
            quote.style.maxHeight = fullH + 'px'
            setTimeout(() => { quote.style.maxHeight = '' }, 500)
          } else {
            quote.style.maxHeight = quote.scrollHeight + 'px'
            void quote.offsetHeight
            quote.style.maxHeight = collapsedH + 'px'
            setTimeout(() => {
              quote.classList.remove('expanded')
              quote.style.maxHeight = ''
            }, 500)
          }

          btn.textContent = isExpanded ? 'Leia mais' : 'Leia menos'
          btn.setAttribute('aria-expanded', String(!isExpanded))
        })

        window.addEventListener('resize', check)
        check()
      })

      // Ler mais / ler menos nas descrições da equipe — com abertura suave
      document.querySelectorAll<HTMLButtonElement>('.team-readmore').forEach((btn) => {
        const text = btn.previousElementSibling as HTMLElement | null
        if (!text) return

        const collapsedHeight = text.offsetHeight
        let animating = false

        const finish = () => {
          text.classList.remove('is-animating')
          text.style.maxHeight = ''
          animating = false
        }

        btn.addEventListener('click', () => {
          if (animating) return
          animating = true
          const expanded = btn.getAttribute('aria-expanded') === 'true'

          if (!expanded) {
            // abrir: parte da altura recolhida até a altura total
            text.classList.remove('is-clamped')
            text.classList.add('is-animating')
            text.style.maxHeight = `${collapsedHeight}px`
            requestAnimationFrame(() => {
              text.style.maxHeight = `${text.scrollHeight}px`
            })
            text.addEventListener('transitionend', finish, { once: true })
            btn.textContent = 'Ler menos'
            btn.setAttribute('aria-expanded', 'true')
          } else {
            // fechar: da altura total de volta às 3 linhas
            text.classList.add('is-animating')
            text.style.maxHeight = `${text.scrollHeight}px`
            requestAnimationFrame(() => {
              text.style.maxHeight = `${collapsedHeight}px`
            })
            text.addEventListener(
              'transitionend',
              () => {
                text.classList.add('is-clamped')
                finish()
              },
              { once: true },
            )
            btn.textContent = 'Ler mais'
            btn.setAttribute('aria-expanded', 'false')
          }
        })
      })

      // FAQ — acordeão
      document.querySelectorAll<HTMLElement>('.faq-item').forEach((item) => {
        const btn = item.querySelector<HTMLButtonElement>('.faq-question')
        const answer = item.querySelector<HTMLElement>('.faq-answer')
        if (!btn || !answer) return

        btn.addEventListener('click', () => {
          const isOpen = item.classList.toggle('is-open')
          btn.setAttribute('aria-expanded', String(isOpen))
          answer.style.maxHeight = isOpen ? `${answer.scrollHeight}px` : ''
        })
      })

      // Cursor Spotlight — segue o mouse via CSS vars
      const spotlight = document.getElementById('cursor-spotlight')
      if (spotlight) {
        window.addEventListener('mousemove', (e) => {
          spotlight.style.setProperty('--x', `${e.clientX}px`)
          spotlight.style.setProperty('--y', `${e.clientY}px`)
        })
      }
    </script>
  </body>
</html>
