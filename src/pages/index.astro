---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GraficoTaxaFechamento from '../components/GraficoTaxaFechamento.astro';
import Pretitulo from '../components/Pretitulo.astro';
import Marquee from '../components/Marquee.astro';
---

<Layout
  title="Site para Advogados | One Impact"
  description="Site para advogados"
>
  <Header />

  <main>
    <section id="inicio" class="secao" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, var(--bg-main) 0%, var(--bg-surface) 100%); position: relative; background-image: radial-gradient(rgba(247, 250, 255, 0.12) 1.2px, transparent 1.2px), linear-gradient(180deg, var(--bg-main) 0%, var(--bg-surface) 100%); background-size: 24px 24px, 100% 100%;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted);">01</span>

      <div style="text-align: center; max-width: 800px; padding: 0 24px;">
        <Pretitulo text="Site para Advogados - Presença Jurídica Profissional" />

        <h1 class="titulo-hero" style="color: var(--text-primary); margin-bottom: 24px;">
          Existe uma nova forma de criar sites para advogados, focada em conversão e não apenas em aparência
        </h1>

        <p class="texto-descricao" style="color: var(--text-secondary); margin-bottom: 40px;">
          Utilizando o Protocolo Advogado Silencioso, seu site deixa de ser apenas um cartão de visitas e passa a atuar como uma ferramenta de captação e qualificação.
        </p>

        <a
          href="#contato"
          class="btn-primary"
        >
          Quero um Site para Meu Escritorio
        </a>
      </div>
    </section>

    <Marquee
      words={['Sites Estratégicos', 'Posicionamento Digital', 'Captação de Clientes', 'Autoridade Jurídica', 'Conversão Real', 'Marketing Jurídico', 'Presença Online', 'Geração de Leads']}
    />

    <section id="problema" class="secao" style="background-color: var(--text-primary); padding: 96px 24px; position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--bg-main); opacity: 0.2;">03</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <Pretitulo text="Por que voce ainda nao tem resultados no digital" />
        <h2 class="titulo-secao" style="color: var(--bg-main); margin-bottom: 32px;">
          Nao e falta de esforco. E falta de estrategia.
        </h2>

        <p class="texto-descricao" style="color: var(--bg-main); margin-bottom: 15px;">
          Voce provavelmente ja tentou. Colocou uma pagina no ar, pediu para um amigo fazer, usou um template barato. Apareceu alguma coisa, mas nada de cliente novo.
        </p>
        <p class="texto-descricao" style="color: var(--bg-main); margin-bottom: 44px;">
          O problema nao e voce. E que sem uma estrategia, qualquer site fica invisivel. Voce ate tem presenca, mas nao tem presenca que converte.
        </p>

        <div style="padding: 28px 36px; border-radius: 16px; border-left: 4px solid var(--bg-main); background-color: var(--bg-main);">
          <p class="texto-descricao" style="font-weight: 700; color: var(--text-primary); line-height: 1.5;">
            "Um site sem estrategia e como um cartaz no deserto. Ninguem ve, ningue-m procura."
          </p>
          <p style="font-size: 13px; color: var(--text-primary); margin-top: 12px; font-weight: 600; font-family: 'Sora', sans-serif;">— Principio One Impact</p>
        </div>
      </div>
    </section>

    <section id="dados-pesquisa" class="secao" style="background-color: var(--bg-main); padding: 96px 24px; border-top: 1px solid var(--border); position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted);">04</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 64px;">
          <p style="font-size: 11px; letter-spacing: 0.2em; color: var(--text-primary); opacity: 0.3; text-transform: uppercase; text-align: center; margin-bottom: 64px; font-family: 'Sora', sans-serif;">
          Pesquisas mostram
        </p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 40px; max-width: 680px; margin: 0 auto;">
          <div style="display: flex; align-items: baseline; gap: 24px; flex-wrap: wrap;">
            <span style="font-size: 72px; font-weight: 800; line-height: 1; color: var(--text-primary); flex-shrink: 0; font-variant-numeric: tabular-nums; font-family: 'Zalando Sans Expanded', sans-serif;">
              73%
            </span>
            <p class="texto-descricao" style="color: var(--text-primary); flex: 1; min-width: 240px;">
              <span style="color: var(--danger); font-weight: 700;">dos clientes</span> pesquisam advogados online antes de contratar.
            </p>
          </div>

          <div style="height: 1px; background: var(--border);"></div>

          <div style="display: flex; align-items: baseline; gap: 24px; flex-wrap: wrap;">
            <span style="font-size: 72px; font-weight: 800; line-height: 1; color: var(--text-primary); flex-shrink: 0; font-variant-numeric: tabular-nums; font-family: 'Zalando Sans Expanded', sans-serif;">
              3x
            </span>
            <p class="texto-descricao" style="color: var(--text-primary); flex: 1; min-width: 240px;">
              <span style="color: var(--danger); font-weight: 700;">mais chances</span> de ser encontrado quando voce tem site profissional vs apenas redes sociais.
            </p>
          </div>

          <div style="height: 1px; background: var(--border);"></div>

          <div style="display: flex; align-items: baseline; gap: 24px; flex-wrap: wrap;">
            <span style="font-size: 72px; font-weight: 800; line-height: 1; color: var(--text-primary); flex-shrink: 0; font-variant-numeric: tabular-nums; font-family: 'Zalando Sans Expanded', sans-serif;">
              80%
            </span>
            <p class="texto-descricao" style="color: var(--text-primary); flex: 1; min-width: 240px;">
              <span style="color: var(--danger); font-weight: 700;">dos visitantes</span> de um site juridico ja estao prontos para contratar. So precisam te encontrar.
            </p>
          </div>
        </div>

        <p style="text-align: center; font-size: 14px; color: var(--text-primary); opacity: 0.25; margin-top: 64px; font-style: italic; font-family: 'Sora', sans-serif;">
          A diferenca entre o advogado que e encontrado e o que e ignorado: um site com estrategia.
        </p>
      </div>
    </section>

    <section id="dados" class="secao" style="background-color: var(--bg-surface); padding: 96px 24px; position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--bg-main); opacity: 0.2;">05</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <GraficoTaxaFechamento />

          <div>
            <p style="font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bg-main); margin-bottom: 16px; font-family: 'Sora', sans-serif;">
              O que os dados mostram
            </p>

            <h2 class="titulo-secao" style="color: var(--bg-main); margin-bottom: 24px;">
              Quem responde primeiro fecha o negocio.
            </h2>

            <p class="texto-descricao" style="color: var(--bg-main); margin-bottom: 15px;">
              Um visitante que te encontra pelo site e preenche o formulario tem <strong style="font-weight: 700;">78% de chance de fechar</strong> se voce responder em ate 5 minutos. O mesmo lead, ignorado por 24 horas, cai para 3%.
            </p>

            <p class="texto-descricao" style="color: var(--bg-main); margin-bottom: 36px;">
              Nao e falta de produto bom. Nao e preco. E a demora na resposta que mata a oportunidade — e manda o cliente direto para o concorrente que foi mais rapido.
            </p>

            <div style="display: flex; align-items: flex-start; gap: 20px; padding: 22px 24px; border-radius: 16px; border: 1px solid var(--border); background-color: var(--bg-main); margin-bottom: 36px;">
              <div>
                <p style="font-size: 38px; font-weight: 800; color: var(--text-primary); line-height: 1; font-family: 'Zalando Sans Expanded', sans-serif;">21x</p>
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px; font-family: 'Sora', sans-serif;">mais chance</p>
              </div>
              <p class="texto-card" style="color: var(--text-primary); opacity: 0.55;">
                de qualificar o lead quando o contato acontece nos primeiros 5 minutos versus depois de 30 minutos.
              </p>
            </div>

            <a
              href="#contato"
              class="btn-primary"
            >
              QUERO ATRAIR LEADS QUALIFICADOS <span style="font-size: 16px;">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="sintomas" class="secao" style="background-color: var(--bg-main); padding: 96px 24px; position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted);">06</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="text-align: center; max-width: 600px; margin: 0 auto 56px;">
          <p style="font-size: 11px; letter-spacing: 0.2em; color: var(--danger); text-transform: uppercase; margin-bottom: 16px; font-family: 'Sora', sans-serif;">
            O problema
          </p>
          <h2 class="titulo-secao" style="color: var(--text-primary);">
            Todo advogado competente ja viveu algum desses.
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 15px; max-width: 720px; margin: 0 auto;">
          <div style="display: flex; align-items: center; gap: 20px; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 100px; padding: 18px 28px; background-color: rgba(239, 68, 68, 0.06);">
            <div style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.8;">
              Voce trabalha muito, mas os clientes que chegam nao sao os que voce quer atender.
            </p>
          </div>

          <div style="display: flex; align-items: center; gap: 20px; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 100px; padding: 18px 28px; background-color: rgba(239, 68, 68, 0.06);">
            <div style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.8;">
              Concorrentes menos experientes parecem mais conhecidos do que voce no digital.
            </p>
          </div>

          <div style="display: flex; align-items: center; gap: 20px; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 100px; padding: 18px 28px; background-color: rgba(239, 68, 68, 0.06);">
            <div style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.8;">
              Ja tentou postar mais nas redes, mas nao sentiu diferenca real nos resultados.
            </p>
          </div>

          <div style="display: flex; align-items: center; gap: 20px; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 100px; padding: 18px 28px; background-color: rgba(239, 68, 68, 0.06);">
            <div style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.8;">
              Quando algum pesquisa seu nome, o que aparece nao representa quem voce realmente e.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="solucao" class="secao" style="background-color: var(--bg-main); padding: 96px 24px; position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted);">07</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; margin-bottom: 64px;">
          <div>
            <p style="font-size: 11px; letter-spacing: 0.2em; color: var(--text-primary); text-transform: uppercase; margin-bottom: 16px; font-family: 'Sora', sans-serif;">
              A diferenca esta
            </p>
            <h2 class="titulo-secao" style="color: var(--text-primary);">
              Voce nao precisa de um site generico
            </h2>
          </div>
          <p class="texto-descricao" style="color: var(--text-primary); opacity: 0.4;">
            Todo escritorio tem uma pagina no Facebook. Todos tem um WhatsApp. O que diferencia e um site que converte visitantes em clientes.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--border);">
          <div style="padding: 40px 32px; border-right: 1px solid var(--border);">
            <span style="font-size: 20px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted); display: block; margin-bottom: 24px;">01</span>
            <h3 class="titulo-card" style="color: var(--text-primary); margin-bottom: 16px;">Pagina no Facebook</h3>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.4;">
              Todos tem. Mas nao mostra quem voce e, nao explica suas areas e nao gera confianca real.
            </p>
          </div>
          <div style="padding: 40px 32px; border-right: 1px solid var(--border);">
            <span style="font-size: 20px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted); display: block; margin-bottom: 24px;">02</span>
            <h3 class="titulo-card" style="color: var(--text-primary); margin-bottom: 16px;">WhatsApp</h3>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.4;">
              Todo mundo usa. Mas e impersonal, nao tem historia, nao mostra autoridade nem resultado.
            </p>
          </div>
          <div style="padding: 40px 32px;">
            <span style="font-size: 20px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted); display: block; margin-bottom: 24px;">03</span>
            <h3 class="titulo-card" style="color: var(--text-primary); margin-bottom: 16px;">Site Modelo</h3>
            <p class="texto-card" style="color: var(--text-primary); opacity: 0.4;">
              Generico, sem copy, sem estrategia. E o que seus concorrentes tambem tem - e nao funciona.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="solucao-detalhe" class="secao" style="background-color: var(--bg-main); padding: 96px 24px; position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--text-muted);">08</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <div>
            <p style="font-size: 11px; letter-spacing: 0.2em; color: var(--text-primary); text-transform: uppercase; margin-bottom: 20px; font-family: 'Sora', sans-serif;">
              A solucao
            </p>
            <h2 class="titulo-secao" style="color: var(--text-primary); margin-bottom: 20px;">
              Site com estrategia. Presenca que representa.
            </h2>
            <p class="texto-descricao" style="color: var(--text-primary); opacity: 0.45; margin-bottom: 40px;">
              Construimos o site que voce nunca teve — antes de qualquer execucao. Um digital que representa quem voce ja e, para os clientes que voce quer atrair.
            </p>
            <a
              href="#contato"
              class="btn-primary"
            >
              QUERO COMECAR <span style="font-size: 16px;">→</span>
            </a>
          </div>

          <div style="display: flex; flex-direction: column; gap: 15px;">
            <div style="display: flex; align-items: center; gap: 16px; border: 1px solid rgba(247, 250, 255, 0.2); border-radius: 100px; padding: 16px 24px; background-color: rgba(247, 250, 255, 0.04);">
              <div style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="texto-card" style="color: var(--text-primary);">
                Posicionamento claro para atrair clientes certos, nao qualquer cliente
              </p>
            </div>

            <div style="display: flex; align-items: center; gap: 16px; border: 1px solid rgba(247, 250, 255, 0.2); border-radius: 100px; padding: 16px 24px; background-color: rgba(247, 250, 255, 0.04);">
              <div style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="texto-card" style="color: var(--text-primary);">
                Presenca digital que comunica seu nivel real de expertise
              </p>
            </div>

            <div style="display: flex; align-items: center; gap: 16px; border: 1px solid rgba(247, 250, 255, 0.2); border-radius: 100px; padding: 16px 24px; background-color: rgba(247, 250, 255, 0.04);">
              <div style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="texto-card" style="color: var(--text-primary);">
                Estrategia antes da execucao — sem gastar com o que nao funciona
              </p>
            </div>

            <div style="display: flex; align-items: center; gap: 16px; border: 1px solid rgba(247, 250, 255, 0.2); border-radius: 100px; padding: 16px 24px; background-color: rgba(247, 250, 255, 0.04);">
              <div style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="texto-card" style="color: var(--text-primary);">
                Visibilidade para quem ja precisa do que voce oferece
              </p>
            </div>

            <div style="display: flex; align-items: center; gap: 16px; border: 1px solid rgba(247, 250, 255, 0.2); border-radius: 100px; padding: 16px 24px; background-color: rgba(247, 250, 255, 0.04);">
              <div style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="texto-card" style="color: var(--text-primary);">
                Conversao de visitantes em clientes qualificados
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="resultados" class="secao" style="background-color: var(--text-primary); padding: 96px 24px; position: relative;">
      <span style="position: absolute; top: 32px; left: 32px; font-size: 12px; font-family: monospace; letter-spacing: 0.15em; color: var(--bg-main); opacity: 0.2;">09</span>

      <div style="max-width: 1140px; margin: 0 auto;">
        <div style="text-align: center; max-width: 560px; margin: 0 auto 64px;">
          <p style="font-size: 11px; letter-spacing: 0.2em; color: var(--bg-main); text-transform: uppercase; margin-bottom: 16px; font-family: 'Sora', sans-serif;">
            O que muda
          </p>
          <h2 class="titulo-secao" style="color: var(--bg-main);">
            O que acontece quando voce tem um site com estrategia
          </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 48px;">
          <div class="card" style="padding: 36px 32px; text-align: center;">
            <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--bg-main)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <p style="font-size: 42px; font-weight: 800; color: var(--bg-main); line-height: 1; margin-bottom: 10px; font-family: 'Zalando Sans Expanded', sans-serif;">+3x</p>
            <p class="texto-card" style="color: var(--bg-main);">mais clientes qualificados</p>
          </div>

          <div class="card" style="padding: 36px 32px; text-align: center;">
            <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px;">
