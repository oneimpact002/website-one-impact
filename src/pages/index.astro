---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="One Impact | Em breve"
  description="One Impact — Em breve"
  bodyClass="diagnostico-page"
>
  <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background-image:radial-gradient(rgba(247,250,255,0.15) 1.2px,transparent 1.2px),linear-gradient(180deg,#0a0a0f 0%,#12111a 100%);background-size:24px 24px,100% 100%;">

    <div style="position:absolute;top:25%;left:-8rem;width:24rem;height:24rem;background:#5907DB;border-radius:9999px;filter:blur(120px);opacity:0.3;pointer-events:none;"></div>
    <div style="position:absolute;bottom:25%;right:-8rem;width:24rem;height:24rem;background:#677BFF;border-radius:9999px;filter:blur(120px);opacity:0.25;pointer-events:none;"></div>

    <div style="position:relative;z-index:10;text-align:center;max-width:600px;padding:0 24px;">

      <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:32px;padding:6px 16px;border-radius:9999px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);">
        <span style="width:6px;height:6px;border-radius:50%;background:#8539FF;animation:pulse 2s infinite;"></span>
        <span style="font-size:11px;color:rgba(255,255,255,0.6);font-weight:500;letter-spacing:0.1em;text-transform:uppercase;font-family:'Sora',sans-serif;">Site em manutenção</span>
      </div>

      <h1 style="font-size:clamp(36px,6vw,64px);font-weight:900;color:#fff;line-height:1.05;letter-spacing:-0.02em;margin-bottom:20px;font-family:'Inter',sans-serif;">
        Estamos preparando<br>
        <span style="background:linear-gradient(90deg,#8539FF,#677BFF);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">algo melhor</span>
      </h1>

      <p style="font-size:16px;color:rgba(255,255,255,0.6);line-height:1.7;margin-bottom:40px;font-family:'Sora',sans-serif;">
        Nosso site está em atualização. Voltamos em breve com novidades.
      </p>

      <a
        href="https://wa.me/5541988733518"
        style="display:inline-flex;align-items:center;gap:8px;padding:16px 32px;border-radius:12px;background:linear-gradient(135deg,#5907DB,#8539FF,#677BFF);color:#fff;font-weight:700;font-size:15px;text-decoration:none;box-shadow:0 0 40px rgba(133,57,255,0.4);font-family:'Sora',sans-serif;"
      >
        Fale conosco →
      </a>

      <p style="margin-top:16px;font-size:14px;color:rgba(255,255,255,0.4);font-family:'Sora',sans-serif;">
        (41) 9 8873-3518
      </p>

    </div>
  </div>

  <style>
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
  </style>
</Layout>
