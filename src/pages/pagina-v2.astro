---
const marqueeTopics = [
  'ADVOGADOS',
  'MÉDICOS',
  'NUTRICIONISTAS',
  'PSICÓLOGOS',
  'ARQUITETOS',
  'CONTADORES',
  'CONSULTORES',
  'COACHES',
]
const marqueeItems = [...marqueeTopics, ...marqueeTopics]
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>One Impact | Agência de Criação de Sites</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #130F26;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(5) { transition-delay: 320ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .reveal-ready [data-scroll-reveal-card] {
        opacity: 0;
        transform: translate3d(0, 28px, 0);
        transition:
          opacity 0.95s ease,
          transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-scroll-reveal-card].is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .floating-header {
        position: fixed;
        top: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 5px 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 9999px;
        background: rgba(247, 245, 253, 0.78);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.16);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .desktop-menu {
        display: none;
        align-items: center;
        gap: 2px;
      }

      .desktop-menu a {
        padding: 8px 11px;
        border-radius: 9999px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .desktop-menu a:hover {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
      }

      .mobile-menu-toggle {
        width: 34px;
        height: 34px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0;
        border: 1px solid rgba(19, 15, 38, 0.12);
        border-radius: 50%;
        background: rgba(19, 15, 38, 0.06);
        box-shadow: 0 3px 10px rgba(19, 15, 38, 0.08);
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
      }

      .mobile-menu-toggle > span {
        width: 18px;
        height: 1.5px;
        border-radius: 9999px;
        background: #130F26;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }

      .mobile-menu-toggle:hover,
      .mobile-menu-toggle[aria-expanded='true'] {
        border-color: rgba(19, 15, 38, 0.2);
        background: rgba(19, 15, 38, 0.1);
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(2) {
        opacity: 0;
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
      }

      .mobile-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px;
        border: 1px solid rgba(255, 255, 255, 0.62);
        border-radius: 22px;
        background: rgba(247, 245, 253, 0.94);
        box-shadow: 0 18px 42px rgba(19, 15, 38, 0.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px) scale(0.98);
        transform-origin: top center;
        transition: opacity 0.22s ease, visibility 0.22s ease, transform 0.22s ease;
      }

      .mobile-menu.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
      }

      .mobile-menu a {
        padding: 13px 16px;
        border-radius: 14px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .mobile-menu a:hover,
      .mobile-menu a:focus-visible {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
        outline: none;
      }

      @media (min-width: 900px) {
        .desktop-menu {
          display: flex;
        }

        .mobile-menu-toggle,
        .mobile-menu {
          display: none;
        }
      }

      .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        text-align: center;
        padding: 24px 24px 80px;
        background: #FFFFFF;
      }

      .hero > .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }

      .hero-floaters {
        display: none;
      }

      .hero-dots {
        display: none;
      }

      /* MOBILE — texto no topo + imagem de fundo (teste) */
      @media (max-width: 899px) {
        .hero {
          min-height: 105vh;
          justify-content: flex-start;
          padding-top: 130px;
          position: relative;
          overflow: hidden;
          background: #2C1794 url('/hero-novo-boa-resolucao-3.jpg') center / cover no-repeat;
        }

        .hero-dots {
          display: block;
          position: absolute;
          inset: 0;
          z-index: 0;
          pointer-events: none;
          background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
          background-size: 14px 14px;
        }

        .hero > .container {
          position: relative;
          z-index: 1;
        }

        .hero-floaters {
          display: block;
          position: absolute;
          inset: 0;
          z-index: 1;
          pointer-events: none;
        }

        .hero-floater {
          position: absolute;
          display: flex;
          align-items: center;
          gap: 8px;
          max-width: 160px;
          padding: 10px 12px;
          border-radius: 14px;
          border: 1px solid rgba(255, 255, 255, 0.28);
          background: rgba(255, 255, 255, 0.13);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
          color: #FFFFFF;
          font-family: 'Sora', sans-serif;
          font-size: 9px;
          font-weight: 600;
          letter-spacing: 0.02em;
          line-height: 1.4;
          text-align: left;
          box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.2);
          animation: hero-floater-float 4s ease-in-out infinite;
        }

        .hero-floater svg {
          flex-shrink: 0;
          width: 16px;
          height: 16px;
          padding: 4px;
          border-radius: 50%;
          background: linear-gradient(135deg, #9774FE, #7446FD);
          color: #FFFFFF;
          box-shadow: 0 2px 6px rgba(116, 70, 253, 0.5);
        }

        .hero-floater-2 { top: 58%; right: 14px; rotate: 2deg; animation-delay: -1s; }
        .hero-floater-3 { top: 74%; left: 14px; rotate: -1.5deg; animation-delay: -2s; }
        .hero-floater-4 { top: 85%; right: 14px; rotate: 1.5deg; animation-delay: -3s; }

        @keyframes hero-floater-float {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-8px); }
        }

        .hero .badge {
          border-color: rgba(255, 255, 255, 0.3);
          background: rgba(255, 255, 255, 0.1);
          color: rgba(255, 255, 255, 0.85);
        }

        .hero .title {
          color: #FFFFFF;
        }

        .hero .description {
          color: rgba(255, 255, 255, 0.85);
        }
      }

      .badge {
        display: inline-flex;
        padding: 8px 18px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.15);
        background: rgba(19, 15, 38, 0.05);
        color: rgba(19, 15, 38, 0.75);
        font-family: 'Sora', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: -10px;
      }

      .title {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.15;
        color: #130F26;
      }

      .title-small {
        display: block;
        font-size: 20px;
        font-weight: 500;
        opacity: 0.85;
        margin-bottom: 6px;
      }

      .title-highlight {
        color: inherit;
      }

      .description {
        max-width: 500px;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.6;
        color: #777779;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 48px;
        border-radius: 10px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      .marquee-section {
        position: relative;
        overflow: hidden;
        padding: 17px 0;
        background: #130F26;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        border-bottom: 1px solid rgba(115, 69, 253, 0.16);
      }

      .marquee-wrapper {
        display: flex;
        overflow: hidden;
        width: 100%;
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      }

      .marquee-track {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        white-space: nowrap;
        animation: marquee-scroll 30s linear infinite;
        flex-shrink: 0;
        padding-right: 2.5rem;
      }

      .marquee-track:hover {
        animation-play-state: paused;
      }

      .marquee-item {
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.15em;
        color: rgba(255, 255, 255, 0.86);
      }

      .marquee-separator {
        font-size: 13px;
        color: #9774FE;
        opacity: 0.7;
      }

      @keyframes marquee-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      .empathy-section {
        position: relative;
        overflow: hidden;
        padding: 80px 20px;
        background: linear-gradient(160deg, #2b2147 0%, #453569 30%, #5b4690 50%, #453569 70%, #2b2147 100%);
      }

      .empathy-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
      }

      .empathy-content {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        text-align: center;
      }

      .badge-dark {
        display: inline-flex;
        padding: 8px 18px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.75);
        font-family: 'Sora', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 14px;
      }

      .empathy-content h2 {
        margin: 0 0 32px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .ghost-title-wrap {
        position: relative;
        width: 100%;
        margin: 0 0 32px;
      }

      .ghost-title-wrap h2 {
        position: relative;
        z-index: 1;
        margin: 0;
      }

      .compare-container .ghost-title-wrap {
        margin-bottom: 12px;
      }

      .ghost-title {
        position: absolute;
        top: -18px;
        left: 50%;
        z-index: 0;
        transform: translate(-50%, -50%);
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 64px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
        color: rgba(255, 255, 255, 0.05);
        pointer-events: none;
        user-select: none;
      }

      .empathy-content p {
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        line-height: 1.7;
      }

      .empathy-lead {
        margin: 0 0 16px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.95);
      }

      .empathy-text {
        margin: 0 0 20px;
        color: rgba(255, 255, 255, 0.85);
      }

      .empathy-content blockquote {
        position: relative;
        overflow: hidden;
        margin: 0;
        padding: 28px 24px 24px;
        border: 1px solid rgba(115, 69, 253, 0.46);
        border-radius: 16px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04));
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 1.75;
        text-align: left;
        color: rgba(255, 255, 255, 0.9);
      }

      .empathy-content blockquote strong {
        font-weight: 600;
        color: #9774FE;
      }

      .compare-section {
        overflow: hidden;
        padding: 88px 20px;
      }

      .compare-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .compare-container h2 {
        margin: 0 0 12px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .compare-hint {
        margin: 0 0 32px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.5);
      }

      .compare-slider {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid rgba(115, 69, 253, 0.3);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
        cursor: ew-resize;
        touch-action: none;
        --pos: 50%;
      }

      .compare-after,
      .compare-before {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .compare-before {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }

      .compare-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .compare-placeholder-before {
        background: linear-gradient(160deg, #3a3a3a, #1a1a1a);
      }

      .compare-placeholder-after {
        background: linear-gradient(160deg, #4B2FBE, #7345FD 55%, #9774FE);
      }

      .compare-label {
        position: absolute;
        top: 16px;
        z-index: 2;
        padding: 6px 14px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(19, 15, 38, 0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .compare-label-before {
        left: 16px;
      }

      .compare-label-after {
        right: 16px;
      }

      .compare-handle {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--pos);
        z-index: 3;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3px;
        background: #FFFFFF;
        pointer-events: none;
      }

      .compare-handle::before {
        content: '↔';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #FFFFFF;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
        color: #130F26;
        font-size: 16px;
        pointer-events: auto;
      }

      .services-section {
        padding: 88px 20px;
      }

      .services-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .services-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .services-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        align-items: stretch;
      }

      .service-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        padding: 28px;
        text-align: left;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, #4B2FBE, #9774FE, #D9CCFF, #9774FE, #4B2FBE);
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .service-card:hover {
        transform: translateY(-6px);
        border-color: rgba(115, 69, 253, 0.45);
        box-shadow: 0 20px 44px rgba(115, 69, 253, 0.2);
      }

      .service-card:hover::before {
        opacity: 1;
      }

      .service-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .service-card-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(115, 69, 253, 0.32);
        border-radius: 12px;
        background: rgba(115, 69, 253, 0.14);
        box-shadow: 0 0 24px rgba(115, 69, 253, 0.22);
        color: #9774FE;
      }

      .service-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .service-card-features {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
        margin: 0;
        padding: 14px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        list-style: none;
      }

      .service-card-features li {
        position: relative;
        padding-left: 22px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.75);
      }

      .service-card-features li::before {
        content: '';
        position: absolute;
        top: 5px;
        left: 0;
        width: 12px;
        height: 8px;
        border-left: 2px solid #9774FE;
        border-bottom: 2px solid #9774FE;
        transform: rotate(-45deg);
      }

      .service-card-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: auto;
        padding-top: 8px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        color: #9774FE;
        transition: gap 0.2s ease, color 0.2s ease;
      }

      .service-card-link span {
        transition: transform 0.2s ease;
      }

      .service-card-link:hover {
        gap: 10px;
        color: #C9BBFF;
      }

      .cases-section {
        padding: 88px 20px;
      }

      .cases-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .cases-container h2 {
        margin: 0 0 40px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      /* Mobile: carrossel horizontal com scroll-snap */
      .cases-grid {
        width: 100%;
        display: flex;
        gap: 16px;
        margin-bottom: 40px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      .cases-grid::-webkit-scrollbar {
        display: none;
      }

      .case-card {
        flex: 0 0 85%;
        scroll-snap-align: center;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      .case-card:hover {
        transform: translateY(-6px);
        border-color: rgba(115, 69, 253, 0.45);
        box-shadow: 0 20px 44px rgba(115, 69, 253, 0.2);
      }

      .case-card-image {
        width: 100%;
        aspect-ratio: 16 / 10;
        background: linear-gradient(160deg, #4B2FBE, #7345FD 55%, #9774FE);
      }

      .case-card-body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 22px;
      }

      .case-card-tag {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.32);
        background: rgba(115, 69, 253, 0.14);
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9774FE;
      }

      .case-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .case-card p {
        margin: 0;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.62);
      }

      .cases-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.5);
        background: transparent;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }

      .cases-more-btn:hover {
