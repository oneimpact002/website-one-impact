          flex: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-ready [data-reveal] .reveal-item,
        .reveal-ready [data-scroll-reveal-card] {
          opacity: 1;
          transform: none;
          transition: none;
        }

        .title-highlight,
        .button {
          animation: none;
        }

        .marquee-track {
          animation-play-state: paused;
        }
      }
    </style>
