    <script>
      import Lenis from 'lenis'

      const revealGroups = document.querySelectorAll('[data-reveal]')
      const scrollRevealCards = document.querySelectorAll('[data-scroll-reveal-card]')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (reduceMotion) {
        revealGroups.forEach((group) => group.classList.add('is-visible'))
        scrollRevealCards.forEach((card) => card.classList.add('is-visible'))
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
        )

        revealGroups.forEach((group) => revealObserver.observe(group))

        const cardObserver = new IntersectionObserver(
          (entries, observer) => {
            entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
              .forEach((entry, index) => {
                window.setTimeout(() => entry.target.classList.add('is-visible'), index * 180)
                observer.unobserve(entry.target)
              })
          },
          { threshold: 0.24, rootMargin: '0px 0px -10% 0px' },
        )

        scrollRevealCards.forEach((card) => cardObserver.observe(card))

        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }

      const mobileMenuToggle = document.getElementById('mobile-menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')

      if (mobileMenuToggle && mobileMenu) {
        const setMobileMenu = (open: boolean) => {
          mobileMenuToggle.setAttribute('aria-expanded', String(open))
          mobileMenuToggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu')
          mobileMenu.classList.toggle('is-open', open)
          mobileMenu.setAttribute('aria-hidden', String(!open))
          mobileMenu.toggleAttribute('inert', !open)
        }

        mobileMenuToggle.addEventListener('click', () => {
          setMobileMenu(mobileMenuToggle.getAttribute('aria-expanded') !== 'true')
        })

        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMobileMenu(false))
        })

        document.addEventListener('click', (event) => {
          if (!document.querySelector('.floating-header')?.contains(event.target as Node)) {
            setMobileMenu(false)
          }
        })

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMobileMenu(false)
        })

        window.addEventListener('resize', () => {
          if (window.innerWidth >= 900) setMobileMenu(false)
        })
      }

      const compareSlider = document.getElementById('compare-slider')
      const compareHandle = document.getElementById('compare-handle')

      if (compareSlider && compareHandle) {
        let dragging = false
        let autoPlay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches

        const setPos = (pos: number) => {
          compareSlider.style.setProperty('--pos', `${Math.min(100, Math.max(0, pos))}%`)
        }

        const setPosition = (clientX: number) => {
          const rect = compareSlider.getBoundingClientRect()
          setPos(((clientX - rect.left) / rect.width) * 100)
        }

        const stopAutoPlay = () => {
          autoPlay = false
        }

        const autoAnimate = (time: number) => {
          if (!autoPlay) return
          setPos(50 + Math.sin(time / 1800) * 30)
          requestAnimationFrame(autoAnimate)
        }

        if (autoPlay) requestAnimationFrame(autoAnimate)

        compareHandle.addEventListener('pointerdown', (event) => {
          stopAutoPlay()
          dragging = true
          compareHandle.setPointerCapture(event.pointerId)
        })

        compareSlider.addEventListener('pointerdown', (event) => {
          stopAutoPlay()
          dragging = true
          setPosition(event.clientX)
        })

        window.addEventListener('pointermove', (event) => {
          if (!dragging) return
          setPosition(event.clientX)
        })

        window.addEventListener('pointerup', () => {
          dragging = false
        })
      }
    </script>
  </body>
