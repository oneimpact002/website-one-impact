        transform: translateY(-2px);
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.25);
      }

      /* Desktop: grid de 3 colunas */
      @media (min-width: 900px) {
        .cases-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 20px;
          overflow-x: visible;
        }

