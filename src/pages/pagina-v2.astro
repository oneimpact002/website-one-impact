---
const marqueeTopics = [
  'ADVOGADOS',
  'MÉDICOS',
  'NUTRICIONISTAS',
  'PSICÓLOGOS',
  'ARQUITETOS',
  'CONTADORES',
  'CONSULTORES',
  'COACHES',
]
const marqueeItems = [...marqueeTopics, ...marqueeTopics]

const empathyTitlePart1 = 'Sua presença na internet ainda não representa'.split(' ')
const empathyTitlePart2 = 'o profissional que você é?'.split(' ')
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>One Impact | Agência de Criação de Sites</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #130F26;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(5) { transition-delay: 320ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .reveal-ready [data-scroll-reveal-card] {
        opacity: 0;
        transform: translate3d(0, 28px, 0);
        transition:
          opacity 0.95s ease,
          transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-scroll-reveal-card].is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .floating-header {
        position: fixed;
        top: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 5px 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 9999px;
        background: rgba(247, 245, 253, 0.78);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.16);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .desktop-menu {
        display: none;
        align-items: center;
        gap: 2px;
      }

      .desktop-menu a {
        padding: 8px 11px;
        border-radius: 9999px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .desktop-menu a:hover {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
      }

      .mobile-menu-toggle {
        width: 34px;
        height: 34px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0;
        border: 1px solid rgba(19, 15, 38, 0.12);
        border-radius: 50%;
        background: rgba(19, 15, 38, 0.06);
        box-shadow: 0 3px 10px rgba(19, 15, 38, 0.08);
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
      }

      .mobile-menu-toggle > span {
        width: 18px;
        height: 1.5px;
        border-radius: 9999px;
        background: #130F26;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }

      .mobile-menu-toggle:hover,
      .mobile-menu-toggle[aria-expanded='true'] {
        border-color: rgba(19, 15, 38, 0.2);
        background: rgba(19, 15, 38, 0.1);
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(2) {
        opacity: 0;
      }

      .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
      }

      .mobile-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px;
        border: 1px solid rgba(255, 255, 255, 0.62);
        border-radius: 5px;
        background: rgba(247, 245, 253, 0.94);
        box-shadow: 0 18px 42px rgba(19, 15, 38, 0.22);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px) scale(0.98);
        transform-origin: top center;
        transition: opacity 0.22s ease, visibility 0.22s ease, transform 0.22s ease;
      }

      .mobile-menu.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
      }

      .mobile-menu a {
        padding: 13px 16px;
        border-radius: 5px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .mobile-menu a:hover,
      .mobile-menu a:focus-visible {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
        outline: none;
      }

      @media (min-width: 900px) {
        .desktop-menu {
          display: flex;
        }

        .mobile-menu-toggle,
        .mobile-menu {
          display: none;
        }
      }

      .hero {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 24px;
        background: #F7F5FD;
      }

      .hero > .container {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      /* Camada 1 — glow roxo suave (centro-topo + bordas inferiores) */
      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 62% 46% at 50% 28%, rgba(115, 69, 253, 0.13), transparent 70%),
          radial-gradient(ellipse 42% 34% at 12% 88%, rgba(151, 116, 254, 0.10), transparent 72%),
          radial-gradient(ellipse 42% 34% at 88% 86%, rgba(151, 116, 254, 0.10), transparent 72%);
      }

      /* Camada 2 — círculos concêntricos com dots orbitando */
      .hero-circles {
        position: absolute;
        z-index: 0;
        top: 50%;
        left: 50%;
        width: min(640px, 88vw);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(115, 69, 253, 0.16);
        pointer-events: none;
      }

      .hero-circles::before {
        content: '';
        position: absolute;
        inset: 17%;
        border-radius: 50%;
        border: 1px solid rgba(115, 69, 253, 0.22);
      }

      .hero-circles::after {
        content: '';
        position: absolute;
        inset: -22%;
        border-radius: 50%;
        border: 1px solid rgba(115, 69, 253, 0.10);
      }

      .orbit-layer {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        animation: orbit-spin 46s linear infinite;
      }

      .orbit-layer-inner {
        inset: 17%;
        animation-duration: 30s;
        animation-direction: reverse;
      }

      .orbit-layer::before {
        content: '';
        position: absolute;
        top: -4px;
        left: 50%;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7345FD;
        box-shadow: 0 0 12px rgba(115, 69, 253, 0.65);
      }

      @keyframes orbit-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      /* Malha de bolinhas — roxa sutil, some nas bordas via mask */
      .hero-dots {
        display: block;
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(115, 69, 253, 0.40) 1.2px, transparent 1.2px);
        background-size: 22px 22px;
        -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 32%, black, transparent 75%);
        mask-image: radial-gradient(ellipse 70% 60% at 50% 32%, black, transparent 75%);
      }

      /* MOBILE — texto em cima, mockups e círculos embaixo */
      @media (max-width: 899px) {
        .hero {
          min-height: 90vh;
          min-height: 90svh;
          justify-content: center;
          padding-top: 24px;
          position: relative;
          overflow: hidden;
          background: #F7F5FD;
        }

        .hero-circles {
          top: 50%;
          width: 520px;
        }

        .hero-dots {
          -webkit-mask-image: radial-gradient(ellipse 90% 55% at 50% 65%, black, transparent 80%);
          mask-image: radial-gradient(ellipse 90% 55% at 50% 65%, black, transparent 80%);
        }

        .hero > .container {
          position: relative;
          z-index: 1;
        }

      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.15);
        background: rgba(19, 15, 38, 0.05);
        color: rgba(19, 15, 38, 0.75);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 0;
      }

      .title {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.12;
        color: #130F26;
        max-width: 820px;
      }

      @media (min-width: 900px) {
        .title {
          font-size: 54px;
          letter-spacing: -1px;
        }
      }

      .title-small {
        display: block;
        font-size: 20px;
        font-weight: 500;
        opacity: 0.85;
        margin-bottom: 6px;
      }

      .title-highlight {
        color: #7345FD;
      }

      .description {
        max-width: 500px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.6;
        color: #4F4F57;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 48px;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      .marquee-section {
        position: relative;
        overflow: hidden;
        padding: 17px 0;
        background: #130F26;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        border-bottom: 1px solid rgba(115, 69, 253, 0.16);
      }

      .marquee-wrapper {
        display: flex;
        overflow: hidden;
        width: 100%;
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      }

      .marquee-track {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        white-space: nowrap;
        animation: marquee-scroll 30s linear infinite;
        flex-shrink: 0;
        padding-right: 2.5rem;
      }

      .marquee-track:hover {
        animation-play-state: paused;
      }

      .marquee-item {
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.15em;
        color: rgba(255, 255, 255, 0.86);
      }

      .marquee-separator {
        font-size: 13px;
        color: #9774FE;
        opacity: 0.7;
      }

      @keyframes marquee-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      .empathy-section {
        position: relative;
        overflow: hidden;
        padding: 80px 20px;
        background: #130F26;
      }

      /* Malha de bolinhas — sutil sobre o fundo escuro, some nas bordas via mask */
      .empathy-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.55) 1.5px, transparent 1.5px);
        background-size: 22px 22px;
        -webkit-mask-image: radial-gradient(ellipse 60% 85% at 50% 50%, black, transparent 88%);
        mask-image: radial-gradient(ellipse 60% 85% at 50% 50%, black, transparent 88%);
      }

      /* Fade inferior — esmaece luzes e pontos antes da seção acabar */
      .empathy-section::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 140px;
        z-index: 0;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(19, 15, 38, 0), #130F26);
      }

      /* Glows animados — blobs roxos desfocados se movendo lentamente */
      .empathy-glows {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        filter: blur(90px);
      }

      .glow-blob {
        position: absolute;
        border-radius: 50%;
      }

      .glow-blob-1 {
        width: 480px;
        height: 480px;
        top: -12%;
        left: -8%;
        background: #4B2FBE;
        opacity: 0.5;
        animation: blob-drift-1 6s ease-in-out infinite alternate;
      }

      .glow-blob-2 {
        width: 420px;
        height: 420px;
        right: -8%;
        bottom: -16%;
        background: #7345FD;
        opacity: 0.42;
        animation: blob-drift-2 7s ease-in-out infinite alternate;
      }

      .glow-blob-3 {
        width: 300px;
        height: 300px;
        top: 38%;
        left: 56%;
        background: #9774FE;
        opacity: 0.28;
        animation: blob-drift-3 8s ease-in-out infinite alternate;
      }

      /* Movimento em etapas: anda, pausa, anda de novo */
      @keyframes blob-drift-1 {
        0% { transform: translate(0, 0) scale(1); }
        35% { transform: translate(38vw, 3vh) scale(1.08); }
        55% { transform: translate(38vw, 3vh) scale(1.08); }
        90% { transform: translate(70vw, 6vh) scale(1.12); }
        100% { transform: translate(70vw, 6vh) scale(1.12); }
      }

      @keyframes blob-drift-2 {
        0% { transform: translate(0, 0) scale(1); }
        35% { transform: translate(-36vw, -2vh) scale(0.96); }
        55% { transform: translate(-36vw, -2vh) scale(0.96); }
        90% { transform: translate(-70vw, -5vh) scale(0.92); }
        100% { transform: translate(-70vw, -5vh) scale(0.92); }
      }

      @keyframes blob-drift-3 {
        0% { transform: translate(0, 0) scale(1); }
        35% { transform: translate(-24vw, 2vh) scale(1.08); }
        55% { transform: translate(-24vw, 2vh) scale(1.08); }
        90% { transform: translate(-45vw, 4vh) scale(1.15); }
        100% { transform: translate(-45vw, 4vh) scale(1.15); }
      }

      /* Reveal palavra-por-palavra com blur */
      .word {
        display: inline-block;
        opacity: 0;
        transform: translateY(0.55em);
        filter: blur(7px);
        transition:
          opacity 0.55s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
          filter 0.65s ease;
        transition-delay: calc(140ms + var(--i) * 55ms);
      }

      .reveal-ready [data-reveal].is-visible .word {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }

      .word-highlight {
        color: #9774FE;
      }

      .empathy-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
      }

      .empathy-content {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        text-align: center;
      }

      .badge-dark {
        display: inline-flex;
        padding: 8px 18px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.75);
        font-family: 'Sora', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 14px;
      }

      /* Badge sticker — inclinada com sombra dura deslocada */
      .empathy-content h2 {
        margin: 0 0 32px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 600;
        line-height: 1.25;
        color: #FFFFFF;
      }

      @media (min-width: 900px) {
        .empathy-content h2 {
          font-size: 42px;
        }

        .ghost-title {
          font-size: 96px;
        }
      }

      .empathy-text strong {
        font-weight: 600;
        color: #9774FE;
      }

      .ghost-title-wrap {
        position: relative;
        width: 100%;
        margin: 0 0 32px;
      }

      .ghost-title-wrap h2 {
        position: relative;
        z-index: 1;
        margin: 0;
      }

      .compare-container .ghost-title-wrap {
        margin-bottom: 12px;
      }

      .ghost-title {
        position: absolute;
        top: -18px;
        left: 50%;
        z-index: 0;
        transform: translate(-50%, -50%);
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 64px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
        color: rgba(255, 255, 255, 0.05);
        pointer-events: none;
        user-select: none;
      }

      .empathy-content p {
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        line-height: 1.7;
      }

      .empathy-text {
        margin: 0 0 20px;
        color: rgba(255, 255, 255, 0.85);
      }

      .empathy-content blockquote {
        position: relative;
        overflow: hidden;
        margin: 0;
        padding: 24px 20px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(145deg, #4B2FBE, #7345FD);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 1.75;
        text-align: left;
        color: rgba(255, 255, 255, 0.9);
      }

      .empathy-content blockquote strong {
        font-weight: 600;
        color: #FFFFFF;
      }

      .compare-section {
        overflow: hidden;
        padding: 88px 20px;
      }

      .compare-container .badge-dark {
        padding: 5px 12px;
        font-size: 8px;
      }

      @media (max-width: 899px) {
        .compare-container .badge-dark {
          padding: 3px 8px;
          font-size: 7px;
          letter-spacing: 0.1em;
        }

      }

      .compare-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .compare-container h2 {
        margin: 0 0 12px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .compare-hint {
        margin: 0 0 32px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.5);
      }

      .compare-slider {
        position: relative;
        width: 100%;
        aspect-ratio: 5 / 3;
        overflow: hidden;
        border-radius: 5px;
        border: 1px solid rgba(115, 69, 253, 0.3);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
        cursor: ew-resize;
        touch-action: none;
        --pos: 50%;
      }

      .compare-after,
      .compare-before {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .compare-before {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }

      .compare-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .compare-placeholder-before {
        background: #1a1a1a url('/compare-planexec-antes.webp') center / cover no-repeat;
      }

      .compare-placeholder-after {
        background: #4B2FBE url('/compare-planexec-depois.webp') center / cover no-repeat;
      }

      .compare-label {
        position: absolute;
        top: 16px;
        z-index: 2;
        padding: 6px 14px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(19, 15, 38, 0.55);
        backdrop-filter: blur(8px);
