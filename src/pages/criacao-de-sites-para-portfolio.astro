---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WhatsappBar from '../components/WhatsappBar.astro'

const WHATSAPP = 'https://link.oneimpact.com.br/contato-agencia-one-impact'
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Criação de Sites-Portfólio | One Impact</title>
    <meta name="description" content="Sites-portfólio pra mostrar seus melhores trabalhos e projetos entregues, com organização que gera confiança em quem visita." />
    <link rel="canonical" href="https://agenciaoneimpact.com.br/criacao-de-sites-para-portfolio" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Criação de Sites-Portfólio | One Impact" />
    <meta property="og:description" content="Sites-portfólio pra mostrar seus melhores trabalhos e projetos entregues." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenciaoneimpact.com.br/criacao-de-sites-para-portfolio" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #0D0A1A;
        font-family: 'Sora', sans-serif;
      }

      .container {
        max-width: 720px;
        margin: 0 auto;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 60px;
        text-align: center;
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 45% at 50% 30%, rgba(115, 69, 253, 0.2), transparent 70%);
      }

      .hero > .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        color: #FFFFFF;
      }

      @media (min-width: 900px) {
        h1 {
          font-size: 40px;
          letter-spacing: -1px;
        }
      }

      .hero-desc {
        max-width: 560px;
        font-size: 13px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.78);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
        padding: 14px 40px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      .wip-section {
        padding: 24px 20px 72px;
        text-align: center;
      }

      .wip-note {
        max-width: 520px;
        margin: 0 auto;
        padding: 16px 20px;
        border: 1px dashed rgba(151, 116, 254, 0.4);
        border-radius: 5px;
        background: rgba(151, 116, 254, 0.06);
        color: rgba(255, 255, 255, 0.65);
        font-size: 12.5px;
        line-height: 1.6;
      }

      .wip-back {
        display: inline-block;
        margin-top: 16px;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
      }

      .wip-back:hover {
        color: #9774FE;
      }

      .final-section {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 56px 20px;
        background: #130F26;
      }

      .final-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 45% at 50% 50%, rgba(115, 69, 253, 0.2), transparent 70%);
      }

      .final-section > .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .final-section h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 22px;
        font-weight: 600;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .final-desc {
        max-width: 460px;
        font-size: 13px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.75);
      }
    </style>
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container">
        <span class="badge">Criação de Sites</span>
        <h1>Sites-portfólio pra mostrar o seu melhor trabalho</h1>
        <p class="hero-desc">
          Uma vitrine profissional pros seus projetos entregues, organizada pra gerar confiança em quem visita antes mesmo do primeiro contato.
        </p>
        <a href={WHATSAPP} class="button" target="_blank" rel="noopener">
          Solicitar orçamento no WhatsApp
        </a>
      </div>
    </section>

    <section class="wip-section">
      <p class="wip-note">Estamos preparando o conteúdo completo desta página. Fale com a gente enquanto isso, ou volte pra ver todos os serviços.</p>
      <a href="/servicos" class="wip-back">← Ver todos os serviços</a>
    </section>

    <section class="final-section">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="container">
        <span class="badge">Vamos conversar</span>
        <h2>Pronto pra mostrar seu trabalho com o nível que ele merece?</h2>
        <p class="final-desc">Conta pra gente sobre os seus projetos e receba um orçamento personalizado, sem compromisso.</p>
        <a href={WHATSAPP} class="button" target="_blank" rel="noopener">
          Solicitar orçamento no WhatsApp
        </a>
      </div>
    </section>

    <Footer />
    <WhatsappBar />

    <script>
      import Lenis from 'lenis'

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
  </body>
</html>
