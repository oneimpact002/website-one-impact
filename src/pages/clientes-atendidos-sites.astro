---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfólio de sites da One Impact — projetos feitos para construir autoridade de marca." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>One Impact | Clientes Atendidos</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #130F26;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .reveal-ready [data-scroll-reveal-card] {
        opacity: 0;
        transform: translate3d(0, 28px, 0);
        transition:
          opacity 0.95s ease,
          transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-scroll-reveal-card].is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      /* ── Intro ── */
      .intro-section {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 40px;
        text-align: center;
      }

      /* Malha fina — mesma textura da /inicio-teste */
      .intro-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      /* Cursor Spotlight — revela a malha ao redor do mouse */
      .cursor-spotlight {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.65) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
        mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
      }

      @media (max-width: 899px), (hover: none) {
        .cursor-spotlight {
          display: none;
        }
      }

      /* Círculos concêntricos com orbs — mesmo visual da /inicio-teste */
      .intro-circles {
        position: absolute;
        z-index: 0;
        top: 60%;
        left: 50%;
        width: min(640px, 88vw);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.28);
        pointer-events: none;
      }

      .intro-circles::before {
        content: '';
        position: absolute;
        inset: 17%;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.36);
      }

      .intro-circles::after {
        content: '';
        position: absolute;
        inset: -22%;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.18);
      }

      .orbit-layer {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        animation: orbit-spin 46s linear infinite;
      }

      .orbit-layer-inner {
        inset: 17%;
        animation-duration: 30s;
        animation-direction: reverse;
      }

      .orbit-layer::before {
        content: '';
        position: absolute;
        top: -4px;
        left: 50%;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7345FD;
        box-shadow: 0 0 12px rgba(115, 69, 253, 0.65);
      }

      @keyframes orbit-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .badge-dark {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 18px;
        position: relative;
        z-index: 1;
      }

      .intro-title {
        position: relative;
        z-index: 1;
        max-width: 640px;
        margin: 0 auto 18px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        letter-spacing: -0.5px;
        color: #FFFFFF;
      }

      @media (min-width: 900px) {
        .intro-title {
          font-size: 46px;
          letter-spacing: -1px;
        }
      }

      .intro-title .hl {
        color: #9774FE;
      }

      .intro-desc {
        position: relative;
        z-index: 1;
        max-width: 520px;
        margin: 0 auto;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.7);
      }

      /* ── Cases ── */
      .cases-section {
        padding: 40px 20px 96px;
      }

      .cases-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
      }

      .cases-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 18px;
      }

      @media (min-width: 700px) {
        .cases-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1000px) {
        .cases-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .case-card {
        display: block;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
        text-decoration: none;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      .case-card:hover {
        transform: translateY(-4px);
        border-color: rgba(115, 69, 253, 0.45);
        box-shadow: 0 20px 44px rgba(115, 69, 253, 0.2);
      }

      .case-card-static {
        cursor: default;
      }

      .case-card-static:hover {
        transform: none;
        border-color: rgba(255, 255, 255, 0.12);
        box-shadow: none;
      }

      /* Barra de navegador — só as bolinhas, sem URL */
      .case-preview-bar {
        display: flex;
        align-items: center;
        gap: 5px;
        height: 26px;
        padding: 0 12px;
        background: rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .case-preview-bar span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
      }

      .case-card img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: center top;
      }

      .case-preview-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 16 / 10;
        padding: 12px;
        text-align: center;
        background: linear-gradient(160deg, #1c1733, #241d42);
      }

      .case-preview-fallback span {
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
      }

      .case-card figcaption {
        padding: 12px 14px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 600;
        text-align: left;
        color: rgba(255, 255, 255, 0.9);
      }

      /* ── CTA final ── */
      .cta-section {
        padding: 20px 20px 100px;
        text-align: center;
      }

      .cta-title {
        max-width: 520px;
        margin: 0 auto 14px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.25;
        color: #FFFFFF;
      }

      .cta-desc {
        max-width: 460px;
        margin: 0 auto 30px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.68);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 40px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .orbit-layer,
        .button {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <div class="cursor-spotlight" id="cursor-spotlight" aria-hidden="true"></div>

    <section class="intro-section">
      <div class="intro-dots" aria-hidden="true"></div>
      <div class="intro-circles" aria-hidden="true">
        <span class="orbit-layer"></span>
        <span class="orbit-layer orbit-layer-inner"></span>
      </div>
      <div data-reveal>
        <span class="badge-dark reveal-item">Clientes atendidos</span>
        <h1 class="intro-title reveal-item">Sites feitos para construir <span class="hl">autoridade</span>.</h1>
        <p class="intro-desc reveal-item">Uma seleção de projetos em que reposicionamos marcas e traduzimos experiência real em presença digital que gera confiança.</p>
      </div>
    </section>

    <section class="cases-section">
      <div class="cases-container">
        <div class="cases-grid" data-reveal>
          {cases.map((item) => {
            const href = item.projectPage || item.url || null
            const external = !item.projectPage && Boolean(item.url)
            const Tag = href ? 'a' : 'div'
            return (
              <Tag
                class={`case-card reveal-item${href ? '' : ' case-card-static'}`}
                href={href ?? undefined}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
              >
                <span class="case-preview-bar" aria-hidden="true"><span></span><span></span><span></span></span>
                {item.preview ? (
                  <img src={item.preview} alt={`Site ${item.name}`} loading="lazy" decoding="async" />
                ) : (
                  <div class="case-preview-fallback">
                    <span>{item.label}</span>
                  </div>
                )}
                <figcaption>{item.name} · {item.label}</figcaption>
              </Tag>
            )
          })}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div data-reveal>
        <h2 class="cta-title reveal-item">Quer um site assim para a sua marca?</h2>
        <p class="cta-desc reveal-item">Cada projeto acima foi pensado para aumentar a percepção de autoridade do cliente — não só a estética.</p>
        <a href="https://link.oneimpact.com.br/contato-agencia-one-impact" class="button reveal-item" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M16 3.2C8.27 3.2 2 8.44 2 14.9c0 3.63 1.98 6.87 5.08 9.01L5.6 29.6l6.35-3.3c1.3.25 2.66.38 4.05.38 7.73 0 14-5.24 14-11.7S23.73 3.2 16 3.2z"/></svg>
          Falar com a gente
        </a>
      </div>
    </section>

    <Footer />
    <WhatsappBar />

    <script>
      import Lenis from 'lenis'

      const revealGroups = document.querySelectorAll('[data-reveal]')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (reduceMotion) {
        revealGroups.forEach((group) => group.classList.add('is-visible'))
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { threshold: 0.05, rootMargin: '0px 0px -8% 0px' },
        )

        revealGroups.forEach((group) => revealObserver.observe(group))

        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }

      // Cursor Spotlight — segue o mouse via CSS vars
      const spotlight = document.getElementById('cursor-spotlight')
      if (spotlight) {
        window.addEventListener('mousemove', (e) => {
          spotlight.style.setProperty('--x', `${e.clientX}px`)
          spotlight.style.setProperty('--y', `${e.clientY}px`)
        })
      }
    </script>
  </body>
</html>
