<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfólio de sites da One Impact — projetos feitos para construir autoridade de marca." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>One Impact | Clientes Atendidos</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #130F26;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal] .reveal-item {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 0.65s ease,
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-reveal] .reveal-item:nth-child(2) { transition-delay: 80ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(3) { transition-delay: 160ms; }
      .reveal-ready [data-reveal] .reveal-item:nth-child(4) { transition-delay: 240ms; }

      .reveal-ready [data-reveal].is-visible .reveal-item {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .reveal-ready [data-scroll-reveal-card] {
        opacity: 0;
        transform: translate3d(0, 28px, 0);
        transition:
          opacity 0.95s ease,
          transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal-ready [data-scroll-reveal-card].is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      /* ── Header flutuante ── */
      .floating-header {
        position: fixed;
        top: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 5px 5px 16px;
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 9999px;
        background: rgba(247, 245, 253, 0.78);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.16);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand > strong {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* ── Intro ── */
      .intro-section {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 40px;
        text-align: center;
      }

      /* Malha fina — mesma textura da /inicio-teste */
      .intro-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      /* Cursor Spotlight — revela a malha ao redor do mouse */
      .cursor-spotlight {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.65) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
        mask-image: radial-gradient(circle 200px at var(--x, -999px) var(--y, -999px), black 0%, transparent 100%);
      }

      @media (max-width: 899px), (hover: none) {
        .cursor-spotlight {
          display: none;
        }
      }

      /* Círculos concêntricos com orbs — mesmo visual da /inicio-teste */
      .intro-circles {
        position: absolute;
        z-index: 0;
        top: 60%;
        left: 50%;
        width: min(640px, 88vw);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.28);
        pointer-events: none;
      }

      .intro-circles::before {
        content: '';
        position: absolute;
        inset: 17%;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.36);
      }

      .intro-circles::after {
        content: '';
        position: absolute;
        inset: -22%;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.18);
      }

      .orbit-layer {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        animation: orbit-spin 46s linear infinite;
      }

      .orbit-layer-inner {
        inset: 17%;
        animation-duration: 30s;
        animation-direction: reverse;
      }

      .orbit-layer::before {
        content: '';
        position: absolute;
        top: -4px;
        left: 50%;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7345FD;
        box-shadow: 0 0 12px rgba(115, 69, 253, 0.65);
      }

      @keyframes orbit-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .badge-dark {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 18px;
        position: relative;
        z-index: 1;
      }

      .intro-title {
        position: relative;
        z-index: 1;
        max-width: 640px;
        margin: 0 auto 18px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        letter-spacing: -0.5px;
        color: #FFFFFF;
      }

      @media (min-width: 900px) {
        .intro-title {
          font-size: 46px;
          letter-spacing: -1px;
        }
      }

      .intro-title .hl {
        color: #9774FE;
      }

      .intro-desc {
        position: relative;
        z-index: 1;
        max-width: 520px;
        margin: 0 auto;
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.7);
      }

      /* ── Cases ── */
      .cases-section {
        padding: 40px 20px 96px;
      }

      .cases-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
      }

      .cases-grid {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      .case-card {
        display: grid;
        grid-template-columns: 1fr;
        align-items: stretch;
        text-align: left;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      @media (min-width: 700px) {
        .case-card {
          grid-template-columns: 220px 1fr;
        }
      }

      .case-card:hover {
        transform: translateY(-4px);
        border-color: rgba(115, 69, 253, 0.45);
        box-shadow: 0 20px 44px rgba(115, 69, 253, 0.2);
      }

      /* Prévia do site — mock de navegador com o domínio real */
      .site-preview {
        width: 100%;
        height: 140px;
        display: flex;
        flex-direction: column;
        background: linear-gradient(160deg, #1c1733, #241d42);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      @media (min-width: 700px) {
        .site-preview {
          height: 100%;
          border-bottom: none;
          border-right: 1px solid rgba(255, 255, 255, 0.08);
        }
      }

      .site-preview-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px 8px;
      }

      .site-preview-dots {
        display: flex;
        gap: 4px;
        flex-shrink: 0;
      }

      .site-preview-dots span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
      }

      .site-preview-url {
        flex: 1;
        padding: 3px 9px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.5);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .site-preview-fill {
        flex: 1;
        margin: 0 12px 12px;
        border-radius: 8px;
        border: 1px solid rgba(19, 15, 38, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        text-align: center;
        background: #FFFFFF;
      }

      /* Prévia com print real do site */
      .site-preview-fill-image {
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
      }

      .case-card-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
      }

      .site-preview-label {
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(19, 15, 38, 0.6);
      }

      .case-card-body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 22px;
      }

      .case-card-tag {
        display: inline-flex;
        padding: 3px 8px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.32);
        background: rgba(115, 69, 253, 0.14);
        font-family: 'Sora', sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9774FE;
      }

      .case-card h3 {
        margin: 0;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.2;
        color: #FFFFFF;
      }

      .case-card p {
        margin: 0;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.68);
      }

      .case-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 2px 0 0;
      }

      .case-chip {
        display: inline-flex;
        padding: 5px 11px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.72);
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        font-weight: 600;
      }

      .service-card-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
        padding: 10px 20px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.5);
        background: rgba(115, 69, 253, 0.14);
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        color: #FFFFFF;
        transition: gap 0.2s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }

      .service-card-link span {
        transition: transform 0.2s ease;
      }

      .service-card-link:hover {
        gap: 11px;
        background: rgba(115, 69, 253, 0.28);
        transform: translateY(-2px);
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.25);
      }

      /* ── CTA final ── */
      .cta-section {
        padding: 20px 20px 100px;
        text-align: center;
      }

      .cta-title {
        max-width: 520px;
        margin: 0 auto 14px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.25;
        color: #FFFFFF;
      }

      .cta-desc {
        max-width: 460px;
        margin: 0 auto 30px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.68);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 40px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      /* Rodapé corporativo — mesmo da /inicio-teste */
      .footer {
        background: #0D0A1A;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        padding: 56px 20px 0;
        font-family: 'Sora', sans-serif;
      }

      .footer-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .footer-col h4 {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-brand strong {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-brand p {
        margin: 10px 0 0;
        max-width: 280px;
        font-size: 12px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.6);
      }

      .footer-col ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-col a {
        font-size: 13px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        transition: color 0.2s ease;
      }

      .footer-col a:hover {
        color: #9774FE;
      }

      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .footer-bottom span {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      @media (min-width: 900px) {
        .footer-grid {
          display: grid;
          grid-template-columns: 2fr 1fr 1fr;
          gap: 40px;
        }
      }

      @media (max-width: 899px) {
        .footer-grid {
          display: flex;
          flex-direction: column;
          gap: 32px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .orbit-layer,
        .button {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="floating-header">
      <a class="brand" href="/" aria-label="One Impact — início">
        <strong>One Impact</strong>
      </a>
    </header>

    <div class="cursor-spotlight" id="cursor-spotlight" aria-hidden="true"></div>

    <section class="intro-section">
