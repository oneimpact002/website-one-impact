---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WhatsappBar from '../components/WhatsappBar.astro'

const WHATSAPP = 'https://link.oneimpact.com.br/contato-whatsapp'

const sites = [
  { title: 'Criação de Sites', desc: 'Site completo sob medida, com design exclusivo e SEO técnico incluso.', href: '/criacao-de-sites' },
  { title: 'Para Anúncios', desc: 'Landing pages feitas pra converter tráfego pago em cliente.', href: '/criacao-de-sites-para-anuncios' },
  { title: 'Para o Google', desc: 'Sites estruturados pra aparecer pra quem já está buscando você.', href: '/criacao-de-sites-para-google' },
  { title: 'Para Posicionamento de Marca', desc: 'Presença digital consistente com a autoridade que você já construiu.', href: '/criacao-de-sites-para-posicionamento-de-marca' },
  { title: 'Para Portfólio', desc: 'Vitrine profissional pros seus melhores projetos entregues.', href: '/criacao-de-sites-para-portfolio' },
  { title: 'Para Médicos', desc: 'Sites pensados pras particularidades da área da saúde.', href: '/criacao-de-sites-para-medicos' },
  { title: 'Para Advogados', desc: 'Sites pensados pras particularidades da advocacia.', href: '/criacao-de-sites-para-advogados' },
]

const automacoes = [
  { title: 'Automação com IA', desc: 'Atendimento automático e inteligente no WhatsApp, 24 horas por dia.', href: '/automacao-atendimento-ia' },
  { title: 'Automação para Instagram', desc: 'Respostas automáticas no direct e nos comentários.', href: '/automacao-atendimento-instagram' },
]
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nossos Serviços | One Impact</title>
    <meta name="description" content="Criação de sites e automação de atendimento pra profissionais liberais e negócios que querem parar de depender só da indicação." />
    <link rel="canonical" href="https://agenciaoneimpact.com.br/servicos" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Nossos Serviços | One Impact" />
    <meta property="og:description" content="Criação de sites e automação de atendimento pra quem quer parar de depender só da indicação." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenciaoneimpact.com.br/servicos" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #0D0A1A;
        font-family: 'Sora', sans-serif;
      }

      .container-md {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 20px;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 60px;
        text-align: center;
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(151, 116, 254, 0.35) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
        mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, black, transparent 85%);
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 45% at 50% 30%, rgba(115, 69, 253, 0.2), transparent 70%);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        max-width: 640px;
        margin: 0 auto;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.16;
        color: #FFFFFF;
      }

      @media (min-width: 900px) {
        h1 {
          font-size: 40px;
          letter-spacing: -1px;
        }
      }

      .hero-desc {
        max-width: 520px;
        font-size: 13px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.78);
      }

      .section {
        padding: 24px 20px 64px;
      }

      h2 {
        margin: 0 0 24px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 20px;
        font-weight: 600;
        color: #FFFFFF;
        text-align: center;
      }

      .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
        max-width: 1140px;
        margin: 0 auto;
      }

      @media (min-width: 700px) {
        .services-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1000px) {
        .services-grid.services-grid-3 {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .service-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 22px 20px;
        border: 1px solid rgba(151, 116, 254, 0.28);
        border-radius: 5px;
        background: linear-gradient(145deg, #232035, #16112B);
        text-decoration: none;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }

      .service-card:hover {
        transform: translateY(-4px);
        border-color: rgba(151, 116, 254, 0.5);
      }

      .service-card h3 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: #FFFFFF;
      }

      .service-card p {
        font-size: 12.5px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.7);
      }

      .service-card span.arrow {
        margin-top: 4px;
        font-size: 12px;
        font-weight: 700;
        color: #9774FE;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
        padding: 14px 40px;
        border: 1px solid #9774FE;
        border-radius: 5px;
        background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
        background-size: 300% 100%;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 26px rgba(115, 69, 253, 0.35);
        animation: shimmer-purple 4s linear infinite;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 32px rgba(115, 69, 253, 0.48);
      }

      @keyframes shimmer-purple {
        0% { background-position: 0% 50%; }
        100% { background-position: 300% 50%; }
      }

      .final-section {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 56px 20px;
        background: #130F26;
      }

      .final-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 45% at 50% 50%, rgba(115, 69, 253, 0.2), transparent 70%);
      }

      .final-section > .final-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .final-section h2 {
        margin: 0;
        font-size: 22px;
      }

      .final-desc {
        max-width: 460px;
        font-size: 13px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.75);
      }
    </style>
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="hero-inner">
        <span class="badge">Nossos serviços</span>
        <h1>Tudo que a One Impact faz pelo seu negócio</h1>
        <p class="hero-desc">
          Criação de sites e automação de atendimento, pensados pra quem quer parar de depender só da indicação.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container-md">
        <h2>Criação de sites</h2>
        <div class="services-grid services-grid-3">
          {sites.map((s) => (
            <a href={s.href} class="service-card">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <span class="arrow">Saiba mais →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-md">
        <h2>Automação de atendimento</h2>
        <div class="services-grid">
          {automacoes.map((s) => (
            <a href={s.href} class="service-card">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <span class="arrow">Saiba mais →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="final-section">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="final-inner">
        <span class="badge">Vamos conversar</span>
        <h2>Não sabe por onde começar?</h2>
        <p class="final-desc">Conta pra gente sobre o seu negócio e a gente te ajuda a escolher o melhor caminho, sem compromisso.</p>
        <a href={WHATSAPP} class="button" target="_blank" rel="noopener">
          Falar com a gente no WhatsApp
        </a>
      </div>
    </section>

    <Footer />
    <WhatsappBar />

    <script>
      import Lenis from 'lenis'

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
  </body>
</html>
