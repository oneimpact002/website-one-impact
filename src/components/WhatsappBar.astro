---
const text = Astro.props.text ?? 'Vamos organizar seu digital?'
const WHATSAPP = 'https://link.oneimpact.com.br/contato-whatsapp'
---

<div class="whatsapp-bar">
  <span class="whatsapp-bar-text">{text}</span>
  <a href={WHATSAPP} class="whatsapp-bar-btn" target="_blank" rel="noopener">
    <svg width="15" height="15" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.25 0.513 1.968 0.74l0.149 0.041c0.442 0.14 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.34-0.247-0.712-0.434z"/></svg>
    Chamar no WhatsApp
  </a>
</div>

<style>
  .whatsapp-bar {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 10px 10px 18px;
    border: 1px solid rgba(151, 116, 254, 0.35);
    border-radius: 9999px;
    background: rgba(19, 15, 38, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
  }

  .whatsapp-bar-text {
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: #FFFFFF;
  }

  .whatsapp-bar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 11px 20px;
    border: 1px solid #9774FE;
    border-radius: 9999px;
    background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
    background-size: 300% 100%;
    color: #FFFFFF;
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(115, 69, 253, 0.4);
    animation: shimmer-purple-bar 4s linear infinite;
    transition: transform 0.2s ease;
  }

  .whatsapp-bar-btn:hover {
    transform: translateY(-2px);
  }

  @keyframes shimmer-purple-bar {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }

  @media (min-width: 900px) {
    .whatsapp-bar {
      left: auto;
      right: 24px;
      bottom: 24px;
      min-width: 0;
    }
  }
</style>
