---
const text = Astro.props.text ?? 'Vamos organizar seu digital?'
const WHATSAPP = 'https://link.oneimpact.com.br/contato-agencia-one-impact'
---

<div class="whatsapp-bar">
  <span class="whatsapp-bar-text">{text}</span>
  <a href={WHATSAPP} class="whatsapp-bar-btn" target="_blank" rel="noopener">
    <svg width="15" height="15" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M16 3.2C8.27 3.2 2 8.44 2 14.9c0 3.63 1.98 6.87 5.08 9.01L5.6 29.6l6.35-3.3c1.3.25 2.66.38 4.05.38 7.73 0 14-5.24 14-11.7S23.73 3.2 16 3.2z"/></svg>
    Falar com a gente
  </a>
</div>

<style>
  .whatsapp-bar {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 10px 10px 18px;
    border: 1px solid rgba(151, 116, 254, 0.35);
    border-radius: 9999px;
    background: rgba(19, 15, 38, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
  }

  .whatsapp-bar-text {
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: #FFFFFF;
  }

  .whatsapp-bar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 11px 20px;
    border: 1px solid #9774FE;
    border-radius: 9999px;
    background: linear-gradient(90deg, #9774FE, #7446FD, #9774FE);
    background-size: 300% 100%;
    color: #FFFFFF;
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(115, 69, 253, 0.4);
    animation: shimmer-purple-bar 4s linear infinite;
    transition: transform 0.2s ease;
  }

  .whatsapp-bar-btn:hover {
    transform: translateY(-2px);
  }

  @keyframes shimmer-purple-bar {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }

  @media (min-width: 900px) {
    .whatsapp-bar {
      left: auto;
      right: 24px;
      bottom: 24px;
      min-width: 0;
    }
  }
</style>
