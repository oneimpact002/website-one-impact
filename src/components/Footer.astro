---
const WHATSAPP = 'https://link.oneimpact.com.br/contato-agencia-one-impact'
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <img src="/logo-one-impact-white.svg" alt="One Impact" class="footer-logo" />
        <p>Agência de posicionamento profissional. Organizamos o caos do seu digital com sites, automações e marca.</p>
      </div>

      <div class="footer-col">
        <h4>Navegação</h4>
        <ul>
          <li><a href="/">Início</a></li>
          <li><a href="/servicos">Serviços</a></li>
          <li><a href="/clientes-atendidos-sites">Portfólio</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contato</h4>
        <div class="footer-social">
          <a href={WHATSAPP} class="footer-social-icon" aria-label="Falar com a gente" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M16 3.2C8.27 3.2 2 8.44 2 14.9c0 3.63 1.98 6.87 5.08 9.01L5.6 29.6l6.35-3.3c1.3.25 2.66.38 4.05.38 7.73 0 14-5.24 14-11.7S23.73 3.2 16 3.2z"/></svg>
          </a>
          <a href="https://www.instagram.com/agenciaoneimpact" class="footer-social-icon" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37a4 4 0 1 1-7.914 1.174A4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
          </a>
          <a href="mailto:contato@agenciaoneimpact.com.br" class="footer-social-icon" aria-label="E-mail">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 One Impact — Todos os direitos reservados.</span>
      <span>agenciaoneimpact.com.br</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0D0A1A;
    border-top: 1px solid rgba(115, 69, 253, 0.16);
    padding: 56px 20px 0;
    font-family: 'Sora', sans-serif;
  }

  .footer-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .footer-col h4 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .footer-logo {
    height: 34px;
    width: auto;
    display: block;
  }

  .footer-brand p {
    margin: 10px 0 0;
    max-width: 280px;
    font-size: 12px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    font-size: 13px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.65);
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #9774FE;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(151, 116, 254, 0.3);
    background: rgba(115, 69, 253, 0.1);
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .footer-social-icon:hover {
    color: #FFFFFF;
    border-color: rgba(151, 116, 254, 0.55);
    background: rgba(115, 69, 253, 0.2);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom span {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (min-width: 900px) {
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }
  }
</style>
