</footer>

<style>
  .footer {
    background: #0D0A1A;
    border-top: 1px solid rgba(115, 69, 253, 0.16);
    padding: 56px 20px 0;
    font-family: 'Sora', sans-serif;
  }

  .footer-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .footer-col h4 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .footer-logo {
    height: 34px;
    width: auto;
    display: block;
  }

  .footer-brand p {
    margin: 10px 0 0;
    max-width: 280px;
    font-size: 12px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    font-size: 13px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.65);
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #9774FE;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(151, 116, 254, 0.3);
    background: rgba(115, 69, 253, 0.1);
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .footer-social-icon:hover {
    color: #FFFFFF;
    border-color: rgba(151, 116, 254, 0.55);
    background: rgba(115, 69, 253, 0.2);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom span {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (min-width: 900px) {
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }
  }
</style>
