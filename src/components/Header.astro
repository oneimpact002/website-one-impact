---
const navItems = [
  { label: 'Início', href: '/' },
  { label: 'Serviços', href: '/servicos' },
  { label: 'Portfólio', href: '/clientes-atendidos-sites' },
  { label: 'Contato', href: '/#contato' },
]
---

<header class="floating-header">
  <a class="brand" href="/" aria-label="One Impact — início">
    <img src="/logo-one-impact-dark.svg" alt="One Impact" class="brand-logo" />
  </a>
  <nav class="desktop-menu" aria-label="Navegação principal">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="mobile-back-link" href="/">← Início</a>
</header>

<style>
  .floating-header {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(94%, 840px);
    padding: 10px 16px;
    border-radius: 9999px;
    border: 1px solid rgba(19, 15, 38, 0.08);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 8px 28px rgba(19, 15, 38, 0.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    text-decoration: none;
    color: #130F26;
  }

  .brand-logo {
    height: 26px;
    width: auto;
    display: block;
  }

  .desktop-menu {
    display: none;
    align-items: center;
    gap: 2px;
  }

  .desktop-menu a {
    padding: 7px 9px;
    border-radius: 9999px;
    font-family: 'Sora', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: #130F26;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .desktop-menu a:hover {
    color: #7345FD;
    background: rgba(115, 69, 253, 0.09);
  }

  .mobile-back-link {
    flex-shrink: 0;
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    color: rgba(19, 15, 38, 0.7);
    transition: color 0.2s ease;
  }

  .mobile-back-link:hover {
    color: #7345FD;
  }

  @media (min-width: 900px) {
    .desktop-menu {
      display: flex;
    }

    .mobile-back-link {
      display: none;
    }
  }
</style>
