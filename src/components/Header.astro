---
const navItems = [
  { label: 'Início', href: '/' },
  { label: 'Serviços', href: '/servicos' },
  { label: 'Portfólio', href: '/clientes-atendidos-sites' },
  {
    label: 'Canal',
    children: [
      { label: 'Blog', href: '/blog' },
      { label: 'Ferramentas que recomendamos', href: '/ferramentas' },
      { label: 'Ranking de hospedagens', href: '/ranking' },
      { label: 'Patrocínio', href: '/patrocinio' },
    ],
  },
  { label: 'Contato', href: '/contato' },
]

// Na rota atual, o grupo Canal fica marcado
const caminho = Astro.url.pathname.replace(/\/$/, '') || '/'
const noCanal = navItems.some((i) => i.children?.some((c) => caminho === c.href || caminho.startsWith(c.href + '/')))
---

<header class="floating-header">
  <a class="brand" href="/" aria-label="One Impact — início">
    <img src="/logo-one-impact-dark.svg" alt="One Impact" class="brand-logo" />
  </a>
  <nav class="desktop-menu" aria-label="Navegação principal">
    {navItems.map((item) =>
      item.children ? (
        <div class="menu-grupo">
          <button type="button" class="menu-grupo-botao" aria-haspopup="true" aria-current={noCanal ? 'true' : undefined}>
            {item.label}
            <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="menu-sub">
            {item.children.map((c) => (
              <a href={c.href} aria-current={caminho === c.href || caminho.startsWith(c.href + '/') ? 'page' : undefined}>{c.label}</a>
            ))}
          </div>
        </div>
      ) : (
        <a href={item.href}>{item.label}</a>
      ),
    )}
  </nav>
  <button
    class="mobile-menu-toggle"
    id="mobile-menu-toggle"
    type="button"
    aria-label="Abrir menu"
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>

<nav class="mobile-menu" id="mobile-menu" aria-label="Navegação mobile" aria-hidden="true" inert>
  {navItems.map((item, i) =>
    item.children ? (
      <>
        <span class="menu-titulo"><span class="menu-index">{String(i + 1).padStart(2, '0')}</span> {item.label}</span>
        {item.children.map((c) => <a class="sub" href={c.href}>{c.label}</a>)}
      </>
    ) : (
      <a href={item.href}><span class="menu-index">{String(i + 1).padStart(2, '0')}</span> {item.label}</a>
    ),
  )}
</nav>

<style>
  .floating-header {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(94%, 840px);
    padding: 10px;
    border-radius: 9999px;
    border: 1px solid rgba(19, 15, 38, 0.08);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 8px 28px rgba(19, 15, 38, 0.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    text-decoration: none;
    color: #130F26;
  }

  .brand-logo {
    height: 38px;
    width: auto;
    display: block;
  }

  .desktop-menu {
    display: none;
    align-items: center;
    gap: 2px;
  }

  .desktop-menu a {
    padding: 7px 9px;
    border-radius: 9999px;
    font-family: 'Sora', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: #130F26;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .desktop-menu a:hover {
    color: #7345FD;
    background: rgba(115, 69, 253, 0.09);
  }

  /* Grupo Canal: dropdown */
  .menu-grupo {
    position: relative;
  }

  .menu-grupo-botao {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 9px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    font-family: 'Sora', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    color: #130F26;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .menu-grupo-botao svg {
    transition: transform 0.2s ease;
  }

  .menu-grupo:hover .menu-grupo-botao,
  .menu-grupo:focus-within .menu-grupo-botao,
  .menu-grupo-botao[aria-current='true'] {
    color: #7345FD;
    background: rgba(115, 69, 253, 0.09);
  }

  .menu-grupo:hover .menu-grupo-botao svg,
  .menu-grupo:focus-within .menu-grupo-botao svg {
    transform: rotate(180deg);
  }

  .menu-sub {
    position: absolute;
    top: 100%;
    left: 50%;
    min-width: 240px;
    padding-top: 12px;
    transform: translate(-50%, 6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
  }

  .menu-sub::before {
    content: '';
    position: absolute;
    inset: 12px 0 0;
    z-index: -1;
    border: 1px solid rgba(19, 15, 38, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 14px 36px rgba(19, 15, 38, 0.16);
  }

  .menu-grupo:hover .menu-sub,
  .menu-grupo:focus-within .menu-sub {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .menu-sub a {
    display: block;
    margin: 4px;
    padding: 9px 12px;
    border-radius: 12px;
  }

  .menu-sub a:first-child {
    margin-top: 8px;
  }

  .menu-sub a:last-child {
    margin-bottom: 8px;
  }

  .menu-sub a[aria-current='page'] {
    color: #7345FD;
    background: rgba(115, 69, 253, 0.09);
  }

  .mobile-menu-toggle {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
    border: 1px solid rgba(19, 15, 38, 0.12);
    border-radius: 50%;
    background: rgba(19, 15, 38, 0.06);
    box-shadow: 0 3px 10px rgba(19, 15, 38, 0.08);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .mobile-menu-toggle > span {
    width: 18px;
    height: 2px;
    border-radius: 9999px;
    background: #130F26;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .mobile-menu-toggle:hover,
  .mobile-menu-toggle[aria-expanded='true'] {
    border-color: rgba(19, 15, 38, 0.2);
    background: rgba(19, 15, 38, 0.1);
  }

  .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle[aria-expanded='true'] > span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Drawer lateral — desliza da direita */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 998;
    background: rgba(13, 10, 26, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .menu-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    width: min(320px, 85vw);
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 96px 28px 28px;
    border-left: 1px solid rgba(151, 116, 254, 0.25);
    background:
      radial-gradient(ellipse 90% 40% at 100% 0%, rgba(115, 69, 253, 0.22), transparent 70%),
      radial-gradient(rgba(151, 116, 254, 0.18) 0.8px, transparent 0.8px),
      #0D0A1A;
    background-size: auto, 12px 12px, auto;
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.5);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.38s ease;
  }

  .mobile-menu.is-open {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-family: 'Zalando Sans Expanded', sans-serif;
    font-size: 19px;
    font-weight: 600;
    text-decoration: none;
    color: #FFFFFF;
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), color 0.2s ease;
  }

  .mobile-menu a .menu-index,
  .mobile-menu .menu-titulo .menu-index {
    font-family: 'Sora', sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #9774FE;
  }

  /* Título do grupo e links dentro dele, no menu do celular */
  .mobile-menu .menu-titulo {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 0 4px;
    font-family: 'Zalando Sans Expanded', sans-serif;
    font-size: 19px;
    font-weight: 600;
    color: #FFFFFF;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .mobile-menu.is-open .menu-titulo {
    opacity: 1;
    transition-delay: 0.23s;
  }

  .mobile-menu a.sub {
    padding: 9px 0 9px 30px;
    font-family: 'Sora', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }

  .mobile-menu a:hover,
  .mobile-menu a:focus-visible {
    color: #9774FE;
    outline: none;
  }

  .mobile-menu.is-open a {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu.is-open a:nth-child(1) { transition-delay: 0.08s; }
  .mobile-menu.is-open a:nth-child(2) { transition-delay: 0.13s; }
  .mobile-menu.is-open a:nth-child(3) { transition-delay: 0.18s; }
  .mobile-menu.is-open a:nth-child(4) { transition-delay: 0.23s; }
  .mobile-menu.is-open a:nth-child(n + 5) { transition-delay: 0.28s; }

  @media (min-width: 900px) {
    .desktop-menu {
      display: flex;
    }

    .mobile-menu-toggle,
    .mobile-menu,
    .menu-backdrop {
      display: none;
    }
  }
</style>

<script>
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  const menuBackdrop = document.getElementById('menu-backdrop')

  if (mobileMenuToggle && mobileMenu) {
    const setMobileMenu = (open: boolean) => {
      mobileMenuToggle.setAttribute('aria-expanded', String(open))
      mobileMenuToggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu')
      mobileMenu.classList.toggle('is-open', open)
      mobileMenu.setAttribute('aria-hidden', String(!open))
      mobileMenu.toggleAttribute('inert', !open)
      menuBackdrop?.classList.toggle('is-open', open)
      document.body.style.overflow = open ? 'hidden' : ''
    }

    menuBackdrop?.addEventListener('click', () => setMobileMenu(false))

    mobileMenuToggle.addEventListener('click', () => {
      setMobileMenu(mobileMenuToggle.getAttribute('aria-expanded') !== 'true')
    })

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMobileMenu(false))
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenu(false)
    })
  }
</script>
