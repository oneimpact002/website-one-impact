---
import { getCollection } from 'astro:content'

const WHATSAPP = 'https://link.oneimpact.com.br/contato-agencia-one-impact';

const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf())

const fmtDate = (d: Date) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' }).format(d)
const readingTime = (body: string | undefined) => Math.max(1, Math.round((body ? body.split(/\s+/).length : 0) / 200))

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog One Impact',
  url: 'https://agenciaoneimpact.com.br/blog',
  description: 'Conteúdo sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais.',
  publisher: {
    '@type': 'Organization',
    name: 'One Impact',
    url: 'https://agenciaoneimpact.com.br',
  },
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog sobre Criação de Sites e Posicionamento Digital | One Impact</title>
    <meta name="description" content="Guias práticos sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais." />
    <link rel="canonical" href="https://agenciaoneimpact.com.br/blog" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Blog One Impact" />
    <meta property="og:description" content="Guias práticos sobre criação de sites e posicionamento digital para profissionais." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenciaoneimpact.com.br/blog" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+Expanded:wght@600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

    <script is:inline>document.documentElement.classList.add('reveal-ready')</script>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        background-color: #F7F5FD;
        font-family: 'Sora', sans-serif;
      }

      .reveal-ready [data-reveal-scroll] .reveal-fade {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }

      .reveal-ready [data-reveal-scroll].is-visible .reveal-fade {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      .floating-header {
        position: fixed;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 60;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        width: min(92%, 720px);
        padding: 10px 16px;
        border-radius: 9999px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: rgba(255, 255, 255, 0.82);
        box-shadow: 0 8px 28px rgba(19, 15, 38, 0.12);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        text-decoration: none;
        color: #130F26;
      }

      .brand-logo {
        height: 26px;
        width: auto;
        display: block;
      }

      .desktop-menu {
        display: none;
        align-items: center;
        gap: 2px;
      }

      .desktop-menu a {
        padding: 8px 11px;
        border-radius: 9999px;
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        color: #130F26;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .desktop-menu a:hover {
        color: #7345FD;
        background: rgba(115, 69, 253, 0.09);
      }

      .back-link {
        font-family: 'Sora', sans-serif;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        color: rgba(19, 15, 38, 0.7);
        transition: color 0.2s ease;
      }

      .back-link:hover {
        color: #7345FD;
      }

      @media (min-width: 900px) {
        .desktop-menu {
          display: flex;
        }
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
      }

      /* Hero editorial, alinhado à esquerda */
      .hero {
        position: relative;
        overflow: hidden;
        padding: 148px 20px 56px;
      }

      .hero-dots {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(75, 47, 190, 0.25) 0.8px, transparent 0.8px);
        background-size: 12px 12px;
        -webkit-mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
        mask-image: radial-gradient(ellipse 65% 80% at 75% 20%, black, transparent 80%);
      }

      .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 45% 55% at 85% 10%, rgba(115, 69, 253, 0.14), transparent 70%);
      }

      .hero .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(115, 69, 253, 0.35);
        background: rgba(115, 69, 253, 0.08);
        font-family: 'Sora', sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      h1 {
        max-width: 640px;
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
        color: #130F26;
      }

      h1 .hl {
        color: #7345FD;
      }

      .hero-desc {
        max-width: 560px;
        font-size: 14.5px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      /* Destaque — post mais recente */
      /* Lista de posts — card horizontal, imagem + conteúdo */
      .posts-section {
        padding: 8px 20px 72px;
      }

      .posts-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .post-row {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 5px;
        border: 1px solid rgba(19, 15, 38, 0.08);
        background: #FFFFFF;
        box-shadow: 0 8px 24px rgba(19, 15, 38, 0.06);
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .post-row:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 34px rgba(115, 69, 253, 0.14);
      }

      .post-row-media {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: linear-gradient(135deg, #130F26, #4B2FBE);
      }

      .post-row-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .post-row-media-fallback {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .post-row-media-fallback span {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(247, 245, 253, 0.9);
      }

      .post-row-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 22px 20px;
      }

      .post-meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        font-size: 11.5px;
        color: rgba(19, 15, 38, 0.55);
      }

      .post-cat {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 9999px;
        background: rgba(115, 69, 253, 0.1);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #4B2FBE;
      }

      .post-row-body h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.35;
        color: #130F26;
      }

      .post-row-body p {
        font-size: 14px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(19, 15, 38, 0.68);
      }

      .read-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        font-size: 13px;
        font-weight: 700;
        color: #7345FD;
      }

      .posts-empty {
        max-width: 560px;
        margin: 0 auto;
        padding: 28px 20px;
        border-radius: 5px;
        border: 1px dashed rgba(115, 69, 253, 0.4);
        background: #FFFFFF;
        text-align: center;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(19, 15, 38, 0.7);
      }

      /* CTA final — bloco escuro para fechar */
      .final-section {
        position: relative;
        overflow: hidden;
        padding: 80px 20px;
        text-align: center;
        background: #130F26;
      }

      .final-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse 55% 60% at 50% 100%, rgba(115, 69, 253, 0.25), transparent 70%);
      }

      .final-section .container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        max-width: 640px;
      }

      .final-badge {
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #C9BBFF;
      }

      .final-section h2 {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        color: #F7F5FD;
      }

      .final-section h2 .hl {
        color: #C9BBFF;
      }

      .final-desc {
        font-size: 14px;
        font-weight: 300;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.75);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: 9999px;
        background: linear-gradient(135deg, #7345FD, #4B2FBE);
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        color: #F7F5FD;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(115, 69, 253, 0.4);
      }

      @media (min-width: 768px) {
        h1 {
          font-size: 42px;
        }

        .post-row {
          flex-direction: row;
        }

        .post-row-media {
          width: 320px;
          aspect-ratio: auto;
          flex-shrink: 0;
        }

        .post-row-body {
          justify-content: center;
          padding: 28px 36px;
        }

        .post-row-body h2 {
          font-size: 21px;
        }

        .final-section h2 {
          font-size: 32px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal-ready [data-reveal-scroll] .reveal-fade {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* Rodapé — mesmo padrão da home */
      .footer {
        background: #0D0A1A;
        border-top: 1px solid rgba(115, 69, 253, 0.16);
        padding: 56px 20px 0;
        font-family: 'Sora', sans-serif;
      }

      .footer-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .footer-col h4 {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      .footer-logo {
        height: 34px;
        width: auto;
        display: block;
      }

      .footer-brand p {
        margin: 10px 0 0;
        max-width: 280px;
        font-size: 12px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.6);
      }

      .footer-col ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-col a {
        font-size: 13px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        transition: color 0.2s ease;
      }

      .footer-col a:hover {
        color: #9774FE;
      }

      .footer-social {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .footer-social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(151, 116, 254, 0.3);
        background: rgba(115, 69, 253, 0.1);
        color: rgba(255, 255, 255, 0.75);
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }

      .footer-social-icon:hover {
        color: #FFFFFF;
        border-color: rgba(151, 116, 254, 0.55);
        background: rgba(115, 69, 253, 0.2);
      }

      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .footer-bottom span {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      @media (min-width: 900px) {
        .footer-grid {
          display: grid;
          grid-template-columns: 2fr 1fr 1fr;
          gap: 40px;
        }
      }

      @media (max-width: 899px) {
        .footer-grid {
          display: flex;
          flex-direction: column;
          gap: 32px;
        }
      }
    </style>
  </head>
  <body>
    <header class="floating-header">
      <a class="brand" href="/" aria-label="One Impact — início">
        <img src="/logo-one-impact-dark.svg" alt="One Impact" class="brand-logo" />
      </a>
      <nav class="desktop-menu" aria-label="Navegação principal">
        <a href="/">Início</a>
        <a href="/servicos">Serviços</a>
        <a href="/clientes-atendidos-sites">Portfólio</a>
        <a href="/contato">Contato</a>
      </nav>
      <a class="back-link" href="/">← Voltar ao início</a>
    </header>

    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container" data-reveal-scroll>
        <span class="badge reveal-fade">Blog One Impact</span>
        <h1 class="reveal-fade">Conteúdo para o seu negócio <span class="hl">aparecer e vender mais</span></h1>
        <p class="hero-desc reveal-fade">
          Guias práticos sobre criação de sites, posicionamento digital e presença online para advogados, médicos, arquitetos e outros profissionais.
        </p>
      </div>
    </section>

    <section class="posts-section">
      <div class="container" data-reveal-scroll>
        {posts.length === 0 && (
          <p class="posts-empty reveal-fade">Os primeiros artigos estão sendo preparados. Volte em breve!</p>
        )}
        {posts.length > 0 && (
          <div class="posts-list reveal-fade">
            {posts.map((post, i) => (
              <a class="post-row" href={`/blog/${post.id}`}>
                <div class="post-row-media">
                  {post.data.cover ? (
                    <img src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  ) : (
                    <span class="post-row-media-fallback"><span>One Impact</span></span>
                  )}
                </div>
                <div class="post-row-body">
                  <span class="post-meta-row">
                    <span class="post-cat">{post.data.category}</span>
                    <time datetime={post.data.datePublished.toISOString()}>{fmtDate(post.data.datePublished)}</time>
                    <span>·</span>
                    <span>{readingTime(post.body)} min de leitura</span>
                  </span>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="read-link">Leia mais <span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="final-section">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="container" data-reveal-scroll>
        <span class="final-badge reveal-fade">Vamos conversar</span>
        <h2 class="reveal-fade">Pronto para organizar o <span class="hl">caos</span> do seu digital?</h2>
        <p class="final-desc reveal-fade">Vamos entender o momento do seu negócio e construir uma presença digital que represente a qualidade do seu trabalho.</p>
        <a href={WHATSAPP} class="button reveal-fade" target="_blank" rel="noopener">
          Solicitar proposta
        </a>
      </div>
    </section>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-col footer-brand">
            <img src="/logo-one-impact-white.svg" alt="One Impact" class="footer-logo" />
            <p>Agência de posicionamento profissional. Organizamos o caos do seu digital com sites, automações e marca.</p>
          </div>

          <div class="footer-col">
            <h4>Navegação</h4>
            <ul>
              <li><a href="/">Início</a></li>
              <li><a href="/#servicos">Serviços</a></li>
              <li><a href="/#cases">Portfólio</a></li>
              <li><a href="/#depoimentos">Depoimentos</a></li>
              <li><a href="/#equipe">Sobre nós</a></li>
              <li><a href="/#faq">FAQ</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Contato</h4>
            <div class="footer-social">
              <a href="https://link.oneimpact.com.br/contato-agencia-one-impact" class="footer-social-icon" aria-label="Falar com a gente" target="_blank" rel="noopener">
                <svg width="17" height="17" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M16 3.2C8.27 3.2 2 8.44 2 14.9c0 3.63 1.98 6.87 5.08 9.01L5.6 29.6l6.35-3.3c1.3.25 2.66.38 4.05.38 7.73 0 14-5.24 14-11.7S23.73 3.2 16 3.2z"/></svg>
              </a>
              <a href="https://www.instagram.com/agenciaoneimpact" class="footer-social-icon" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37a4 4 0 1 1-7.914 1.174A4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
              </a>
              <a href="mailto:contato@oneimpact.com.br" class="footer-social-icon" aria-label="E-mail">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© 2026 One Impact — Todos os direitos reservados.</span>
          <span>agenciaoneimpact.com.br</span>
        </div>
      </div>
    </footer>

    <script>
      import Lenis from 'lenis'

      const scrollGroups = document.querySelectorAll('[data-reveal-scroll]')
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting)
          })
        },
        { threshold: 0.05 },
      )
      scrollGroups.forEach((group) => observer.observe(group))

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        function raf(time: number) {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
      }
    </script>
  </body>
</html>
