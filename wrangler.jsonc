{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-one-impact",
  "compatibility_date": "2026-09-25",
  // Site estático do Astro: a Cloudflare serve a pasta dist como está.
  // O formulário e o rastreio falam direto com o Supabase, então não há código no servidor.
  "assets": {
    "directory": "./dist"
  }
}
